#!/usr/bin/env python3
"""X 博主热帖采集（官方 X connector 版）。

子命令：
  plan [--daily] [--history HANDLE --pages N] 生成本轮要调用的 connector 请求（JSON 行），并建 RUN_DIR
  ingest RUN_DIR                       解析 RUN_DIR 里保存的响应，更新 state/posts.json、state/creators_meta.json
  daily [--now ISO] [--no-mark]        对每个有"新"热帖（24h 内 ≥ daily_min_views、seen 里没有）的博主各出一个合并报告，并记入 seen；
                                       没有则输出 NO_NEW_HITS
  report HANDLE [--now ISO] [--mark]   出某博主的合并报告（今日热帖 + 近 history_days 天 ≥ history_min_views 的历史热帖）；
                                       今日部分含已推过的；默认不改 seen（history 是同义命令）
  报告文件：reports/<昵称>_YYYYMMDD_HHMM.md（昵称去掉 emoji 和非法字符；为空时用 handle）
  status                               打印每个博主的覆盖情况

响应文件格式（RUN_DIR 下，按文件名排序读取）：
  *.json  connector 原样返回（可带末尾的 "X reads left ..." 一行）
  *.tsv   精简格式：P\tid\tcreated_at\timpressions\tlike\tretweet\treply\tquote\tbookmark\tkind(o/q/r)\ttext
          C\tresult_count\toldest_id\toldest_created_at\tnext_token ；M ... ；Q\treads_left ；# 注释
  文件名里带 "_<handle>" 或首行注释 "# handle=xxx" 时据此归属；否则用 author_id 匹配 creators.json。
所有时间显示为北京时间（Asia/Shanghai）。
"""
import json, os, re, sys, glob, datetime as dt
from zoneinfo import ZoneInfo

BASE = os.path.dirname(os.path.abspath(__file__))
STATE = os.path.join(BASE, "state")
RAW = os.path.join(BASE, "raw")
REPORTS = os.path.join(BASE, "reports")
BJ = ZoneInfo("Asia/Shanghai")
UTC = dt.timezone.utc
POST_FIELDS = "created_at,public_metrics,referenced_tweets,in_reply_to_user_id,lang"


def now_utc():
    return dt.datetime.now(UTC)


def parse_ts(s):
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))


def bj(t):
    return t.astimezone(BJ)


def load(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return default


def save(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def cfg():
    return load(os.path.join(BASE, "creators.json"), {"settings": {}, "creators": []})


def settings():
    s = {"history_days": 183, "history_min_views": 100000, "daily_window_hours": 24,
         "daily_min_views": 30000, "include_replies": False, "seen_keep_days": 30,
         "daily_max_pages_per_creator": 3, "history_max_rows": 0}
    s.update(cfg().get("settings", {}))
    return s


def fmt_num(n):
    n = int(n)
    if n >= 10000:
        return f"{n/10000:.1f}万"
    return f"{n:,}"


def fmt_thr(n):
    n = int(n)
    return f"{n//10000} 万" if n >= 10000 and n % 10000 == 0 else fmt_num(n)


def summary(text, n=40):
    t = re.sub(r"https?://t\.co/\S+", "", text or "")
    t = t.replace("\\n", " ")
    t = re.sub(r"\s+", " ", t).strip()
    if len(t) > n:
        t = t[:n] + "…"
    t = t.replace("|", "｜")
    return t or "（图片/视频）"


# ---------------- ingest ----------------

def _first_json(text):
    i = text.find("{")
    if i < 0:
        return None
    try:
        obj, _ = json.JSONDecoder().raw_decode(text[i:])
        return obj
    except Exception:
        return None


def _kind(p):
    refs = p.get("referenced_tweets") or []
    types = {r.get("type") for r in refs}
    if "retweeted" in types:
        return "rt"
    if "replied_to" in types or p.get("in_reply_to_user_id"):
        return "r"
    if "quoted" in types:
        return "q"
    return "o"


def parse_file(path):
    """返回 (posts, users, meta)。posts: list of dict(id, author_id?, created_at, m{...}, kind, text)"""
    txt = open(path, encoding="utf-8").read()
    posts, users, meta = [], [], {}
    m = re.search(r"(\d+) of 1000 today", txt)
    if m:
        meta["reads_left"] = int(m.group(1))
    hm = re.search(r"#\s*handle=(\w+)", txt)
    if hm:
        meta["handle"] = hm.group(1)
    if path.endswith(".tsv"):
        for line in txt.splitlines():
            if not line or line.startswith("#"):
                continue
            f = line.split("\t")
            if f[0] == "P" and len(f) >= 10:
                posts.append({"id": f[1], "created_at": f[2],
                              "m": {"impression_count": int(f[3]), "like_count": int(f[4]),
                                    "retweet_count": int(f[5]), "reply_count": int(f[6]),
                                    "quote_count": int(f[7]), "bookmark_count": int(f[8])},
                              "kind": f[9], "text": f[10] if len(f) > 10 else ""})
            elif f[0] in ("C", "M"):
                meta["result_count"] = int(f[1])
                meta["oldest_id"] = f[2]
                if f[0] == "C" and len(f) > 3:
                    meta["oldest_created_at"] = f[3]
                    meta["next_token"] = f[4] if len(f) > 4 else ""
                elif len(f) > 3:
                    meta["next_token"] = f[3]
            elif f[0] == "Q":
                meta["reads_left"] = int(f[1])
        return posts, users, meta
    obj = _first_json(txt)
    if not obj:
        meta["error"] = txt[:300]
        return posts, users, meta
    if "errors" in obj and "data" not in obj:
        meta["error"] = json.dumps(obj["errors"], ensure_ascii=False)[:300]
    data = obj.get("data")
    if isinstance(data, dict) and "username" in data:
        users.append(data)
    elif isinstance(data, list):
        for p in data:
            if "username" in p:
                users.append(p)
                continue
            posts.append({"id": p["id"], "author_id": p.get("author_id"), "created_at": p.get("created_at"),
                          "m": p.get("public_metrics", {}), "kind": _kind(p), "text": p.get("text", "")})
    meta.update({k: v for k, v in (obj.get("meta") or {}).items()})
    return posts, users, meta


def ingest(run_dir):
    c = cfg()
    by_id = {x.get("id"): x["username"].lower() for x in c["creators"] if x.get("id")}
    posts_db = load(os.path.join(STATE, "posts.json"), {})
    cmeta = load(os.path.join(STATE, "creators_meta.json"), {})
    files = sorted(glob.glob(os.path.join(run_dir, "*.json")) + glob.glob(os.path.join(run_dir, "*.tsv")))
    n_new = n_upd = 0
    reads_left = None
    for fp in files:
        fetched = dt.datetime.fromtimestamp(os.path.getmtime(fp), UTC).isoformat()
        posts, users, meta = parse_file(fp)
        if "reads_left" in meta:
            reads_left = meta["reads_left"]
        if meta.get("error"):
            print(f"WARN {os.path.basename(fp)}: {meta['error']}", file=sys.stderr)
        for u in users:
            h = u["username"].lower()
            pm = u.get("public_metrics", {})
            cmeta.setdefault(h, {}).update({"id": u["id"], "name": u.get("name"), "username": u["username"],
                                            "followers": pm.get("followers_count"),
                                            "tweet_count": pm.get("tweet_count"), "user_fetched_at": fetched})
            by_id[u["id"]] = h
            for x in c["creators"]:
                if x["username"].lower() == h and not x.get("id"):
                    x["id"] = u["id"]
        fname_handle = None
        mh = re.search(r"_@?([A-Za-z0-9_]+)\.(json|tsv)$", os.path.basename(fp))
        if meta.get("handle"):
            fname_handle = meta["handle"].lower()
        elif mh and mh.group(1).lower() in {x["username"].lower() for x in c["creators"]}:
            fname_handle = mh.group(1).lower()
        for p in posts:
            h = by_id.get(p.get("author_id")) or fname_handle
            if not h:
                # 单博主 RUN_DIR：用唯一博主兜底
                hs = {x["username"].lower() for x in c["creators"]}
                h = next(iter(hs)) if len(hs) == 1 else None
            if not h:
                continue
            rec = posts_db.get(p["id"])
            if rec is None:
                rec = {"id": p["id"], "handle": h, "created_at": p["created_at"], "kind": p["kind"],
                       "text": p["text"], "first_fetched_at": fetched}
                posts_db[p["id"]] = rec
                n_new += 1
            else:
                n_upd += 1
                if p["text"] and not rec.get("text"):
                    rec["text"] = p["text"]
            if not rec.get("metrics_at") or fetched >= rec["metrics_at"]:
                rec["metrics"] = p["m"]
                rec["metrics_at"] = fetched
        # 记录分页覆盖（历史回溯到哪）
        if (fname_handle or len(c["creators"]) == 1) and "daily" not in os.path.basename(fp):
            h = fname_handle or c["creators"][0]["username"].lower()
            oc = meta.get("oldest_created_at") or (min((p["created_at"] for p in posts), default=None))
            if oc:
                cm = cmeta.setdefault(h, {})
                if not cm.get("oldest_fetched") or oc < cm["oldest_fetched"]:
                    cm["oldest_fetched"] = oc
                if "next_token" in meta:
                    cm["history_next_token"] = meta.get("next_token") or ""
                    # 没有 next_token 或不足一页 = 已翻到 start_time（或接口上限）
                    if not meta.get("next_token") or int(meta.get("result_count", 25)) < 25:
                        # 只有真的翻到了 6 个月起点才算完整；否则是接口到头（时间线只能翻约 3200 条），要改用 search_posts_all 补
                        start = now_utc() - dt.timedelta(days=settings()["history_days"])
                        if parse_ts(cm["oldest_fetched"]) <= start + dt.timedelta(days=2):
                            cm["history_complete"] = True
                        else:
                            cm["timeline_exhausted_at"] = cm["oldest_fetched"]
    save(os.path.join(STATE, "posts.json"), posts_db)
    save(os.path.join(STATE, "creators_meta.json"), cmeta)
    save(os.path.join(BASE, "creators.json"), c)
    m = load(os.path.join(STATE, "meta.json"), {})
    m["last_ingest"] = now_utc().isoformat()
    if reads_left is not None:
        m["reads_left"] = reads_left
    save(os.path.join(STATE, "meta.json"), m)
    print(f"SUMMARY files={len(files)} new_posts={n_new} updated={n_upd} reads_left={reads_left}", file=sys.stderr)


# ---------------- reports ----------------

def eligible(rec, s):
    if rec.get("kind") == "rt":
        return False
    if rec.get("kind") == "r" and not s["include_replies"]:
        return False
    return True


def strip_emoji(x):
    import unicodedata
    out = []
    for ch in str(x or ""):
        cat = unicodedata.category(ch)
        cp = ord(ch)
        # 去掉 emoji / 符号 / 变体选择符 / 零宽连接符等
        if cat in ("So", "Sk", "Cs", "Co", "Cn", "Mn", "Me", "Cf") or 0x1F000 <= cp <= 0x1FAFF \
                or 0x2600 <= cp <= 0x27BF or 0xFE00 <= cp <= 0xFE0F:
            continue
        out.append(ch)
    return "".join(out)


def safe_name(x, n=40, fallback="noname"):
    x = re.sub(r'[\\/:*?"<>|\x00-\x1f]', "", str(x or ""))
    x = re.sub(r"\s+", "_", x).strip("._ ")
    return x[:n] or fallback


def _today_hits(h, posts, seen, s, now):
    win = dt.timedelta(hours=s["daily_window_hours"])
    out = []
    for r in posts.values():
        if r["handle"] != h or not eligible(r, s):
            continue
        ct = parse_ts(r["created_at"])
        mt = parse_ts(r["metrics_at"])
        # 发布 24 小时内被测到 ≥ 阈值，且现在仍在窗口内（留 1 小时余量）
        if mt - ct <= win and r["metrics"].get("impression_count", 0) >= s["daily_min_views"] \
                and now - ct <= win + dt.timedelta(hours=1):
            out.append(r)
    out.sort(key=lambda r: r["created_at"], reverse=True)  # 由近到远
    return out


def _hist_rows(h, posts, s, now):
    since = now - dt.timedelta(days=s["history_days"])
    rows = [r for r in posts.values() if r["handle"] == h and eligible(r, s)
            and parse_ts(r["created_at"]) >= since
            and r["metrics"].get("impression_count", 0) >= s["history_min_views"]]
    rows.sort(key=lambda r: r["created_at"], reverse=True)  # 按发布时间由近到远
    return rows, since


def creator_report(handle, now=None, mark_seen=False, new_only_marker=True):
    """一个博主一个文件：今日热帖 + 历史热帖。返回 (path, n_today, n_new_today, n_hist)。"""
    s = settings()
    h = handle.lower()
    now = now or now_utc()
    posts = load(os.path.join(STATE, "posts.json"), {})
    cm = load(os.path.join(STATE, "creators_meta.json"), {}).get(h, {})
    seen = load(os.path.join(STATE, "seen_daily.json"), {})
    user = cm.get("username", h)
    name = cm.get("name") or h
    t = bj(now)
    today = _today_hits(h, posts, seen, s, now)
    new_ids = {r["id"] for r in today if r["id"] not in seen}
    hist, since = _hist_rows(h, posts, s, now)
    maxr = int(s.get("history_max_rows") or 0)
    shown = hist[:maxr] if maxr else hist
    fol = fmt_num(cm["followers"]) if cm.get("followers") is not None else "未知"
    dthr, hthr = fmt_thr(s["daily_min_views"]), fmt_thr(s["history_min_views"])
    L = [f"# @{user}（{name}）· X 热帖报告",
         f"采集时间：{t:%Y-%m-%d %H:%M}（北京时间） · 粉丝 {fol}",
         "",
         "**目录**",
         f"- [📅 今日热帖（{len(today)} 条" + (f"，新 {len(new_ids)} 条" if new_ids and len(new_ids) != len(today) else "") + "）](#today)",
         f"- [📚 历史热帖（{len(hist)} 条）](#history)",
         "",
         '<a id="today"></a>',
         "",
         f"## 📅 今日热帖（24 小时内 · 浏览 ≥{dthr} · 由近到远）",
         ""]
    if not today:
        L.append("暂无")
    else:
        L.append("| # | 发布时间 | 浏览量 | 点赞 | 转发 | 内容摘要 | 链接 |")
        L.append("|---|---|---|---|---|---|---|")
        for i, r in enumerate(today, 1):
            m = r["metrics"]
            ct = parse_ts(r["created_at"])
            age = (now - ct).total_seconds() / 3600
            tag = "🆕 " if (new_only_marker and r["id"] in new_ids and len(new_ids) != len(today)) else ""
            L.append(f"| {i} | {bj(ct):%m-%d %H:%M}（{age:.0f} 小时前） | {fmt_num(m['impression_count'])} | "
                     f"{fmt_num(m.get('like_count', 0))} | {fmt_num(m.get('retweet_count', 0))} | {tag}{summary(r['text'])} | "
                     f"https://x.com/{user}/status/{r['id']} |")
    L += ["", "---", "", '<a id="history"></a>', "",
          f"## 📚 历史热帖（近 6 个月 · 浏览 ≥{hthr} · 按发布时间由近到远）", ""]
    of = cm.get("oldest_fetched")
    if not cm.get("history_complete") and (not of or parse_ts(of) > since + dt.timedelta(days=1)):
        start = f"{bj(parse_ts(of)):%Y-%m-%d}" if of else "（未回溯）"
        L.append(f"> ⚠️ 覆盖不完整：目前只采到 {start} 至今，还没翻到 {bj(since):%Y-%m-%d}，更早的帖子待补采。")
        L.append("")
    L.append(f"共 {len(hist)} 条 · 按发布时间由近到远" + (f" · 下表只列最近 {len(shown)} 条" if len(shown) < len(hist) else ""))
    L.append("")
    if not hist:
        L.append("暂无")
    else:
        L.append("| # | 发布时间 | 浏览量 | 点赞 | 转发 | 内容摘要 | 链接 |")
        L.append("|---|---|---|---|---|---|---|")
        for i, r in enumerate(shown, 1):
            m = r["metrics"]
            L.append(f"| {i} | {bj(parse_ts(r['created_at'])):%Y-%m-%d %H:%M} | {fmt_num(m['impression_count'])} | "
                     f"{fmt_num(m.get('like_count', 0))} | {fmt_num(m.get('retweet_count', 0))} | {summary(r['text'])} | "
                     f"https://x.com/{user}/status/{r['id']} |")
    L += ["", "注：只统计原创帖和引用帖（不含转推、回复）；浏览量为采集时的数值；今日热帖每条只触发推送一次。"]
    os.makedirs(REPORTS, exist_ok=True)
    fn = safe_name(strip_emoji(name), fallback="") or safe_name(user)
    path = os.path.join(REPORTS, f"{fn}_{t:%Y%m%d_%H%M}.md")
    open(path, "w", encoding="utf-8").write("\n".join(L) + "\n")
    if mark_seen and new_ids:
        for i in new_ids:
            seen[i] = now.isoformat()
        keep = now - dt.timedelta(days=s["seen_keep_days"])
        seen = {k: v for k, v in seen.items() if parse_ts(v) >= keep}
        save(os.path.join(STATE, "seen_daily.json"), seen)
    return path, len(today), len(new_ids), len(hist)


def daily_report(now=None, mark_seen=True):
    """每个有新热帖（24h 内 ≥阈值、之前没推过）的博主各出一个合并报告。返回 [(handle, path, n_new)]。"""
    s = settings()
    now = now or now_utc()
    posts = load(os.path.join(STATE, "posts.json"), {})
    seen = load(os.path.join(STATE, "seen_daily.json"), {})
    out = []
    for x in cfg()["creators"]:
        if x.get("disabled"):
            continue
        h = x["username"].lower()
        if any(r["id"] not in seen for r in _today_hits(h, posts, seen, s, now)):
            p, nt, nn, nh = creator_report(h, now, mark_seen=mark_seen)
            out.append((h, p, nn))
    return out


# ---------------- plan ----------------

def plan(args):
    s = settings()
    c = cfg()
    t = bj(now_utc())
    run_dir = os.path.join(RAW, f"{t:%Y%m%d_%H%M}")
    os.makedirs(run_dir, exist_ok=True)
    print(f"RUN_DIR={run_dir}")
    calls = []
    need = [x["username"] for x in c["creators"] if not x.get("disabled")]
    # 1 次批量查用户（id、粉丝数），每 100 个 1 次
    for i in range(0, len(need), 100):
        calls.append({"save_as": os.path.join(run_dir, f"00_users_{i//100}.json"), "namespace": "x",
                      "toolName": "get_users_by_usernames", "paginate": False,
                      "arguments": {"usernames": ",".join(need[i:i+100]),
                                    "user.fields": "id,name,username,public_metrics"}})
    if "--history" in args:
        h = args[args.index("--history") + 1].lower()
        pages = int(args[args.index("--pages") + 1]) if "--pages" in args else 60
        x = next(x for x in c["creators"] if x["username"].lower() == h)
        since = now_utc() - dt.timedelta(days=s["history_days"])
        calls.append({"save_as": os.path.join(run_dir, f"10_hist_p1_{h}.json"), "namespace": "x",
                      "toolName": "get_users_posts", "paginate": True, "max_pages": pages,
                      "arguments": {"id": x.get("id", "<从 00_users 结果取 id>"), "max_results": 25,
                                    "exclude": "retweets,replies",
                                    "start_time": since.strftime("%Y-%m-%dT%H:%M:%SZ"),
                                    "post.fields": POST_FIELDS}})
    else:
        since = now_utc() - dt.timedelta(hours=s["daily_window_hours"])
        for j, x in enumerate([x for x in c["creators"] if not x.get("disabled")], 1):
            h = x["username"].lower()
            calls.append({"save_as": os.path.join(run_dir, f"{j:02d}_daily_{h}.json"), "namespace": "x",
                          "toolName": "get_users_posts", "paginate": True,
                          "max_pages": s["daily_max_pages_per_creator"],
                          "arguments": {"id": x.get("id", "<从 00_users 结果取 id>"), "max_results": 25,
                                        "exclude": "retweets,replies",
                                        "start_time": since.strftime("%Y-%m-%dT%H:%M:%SZ"),
                                        "post.fields": POST_FIELDS}})
    print(f"CALLS={len(calls)}（不含翻页）")
    for cl in calls:
        print(json.dumps(cl, ensure_ascii=False))


def status():
    c = cfg()
    posts = load(os.path.join(STATE, "posts.json"), {})
    cmeta = load(os.path.join(STATE, "creators_meta.json"), {})
    for x in c["creators"]:
        h = x["username"].lower()
        n = sum(1 for r in posts.values() if r["handle"] == h)
        cm = cmeta.get(h, {})
        print(f"@{h}: posts={n} oldest={cm.get('oldest_fetched')} followers={cm.get('followers')}")
    print(load(os.path.join(STATE, "meta.json"), {}))


def main():
    a = sys.argv[1:]
    if not a:
        print(__doc__); return
    now = None
    if "--now" in a:
        now = parse_ts(a[a.index("--now") + 1])
    if a[0] == "plan":
        plan(a[1:])
    elif a[0] == "ingest":
        ingest(a[1])
    elif a[0] == "daily":
        res = daily_report(now, mark_seen="--no-mark" not in a)
        if not res:
            print("NO_NEW_HITS")
        for h, p, nn in res:
            print(f"{p}\tnew={nn}")
    elif a[0] in ("report", "history"):
        p, nt, nn, nh = creator_report(a[1], now, mark_seen="--mark" in a)
        print(f"{p}\ttoday={nt} new={nn} history={nh}")
    elif a[0] == "status":
        status()
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
