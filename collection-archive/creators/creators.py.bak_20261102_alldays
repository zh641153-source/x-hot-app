def finalize(run_dir, force=False, now=None):
    """ingest 之后调用：毕业判定 → 仅当有帖新进入历史热帖时出报告并 PUSH。
    普通新推文不再触发推送；无新入榜则 NO_UPDATES。输出 PUSH/NO_UPDATES 行。"""
    now = now or now_utc()
    pl = load(os.path.join(run_dir, "plan.json"), {})
    run_started = parse_ts(pl["run_started"]) if pl.get("run_started") else now - dt.timedelta(hours=1)
    grads = graduate(run_started, now)
    t = bj(now)
    lines = []
    for h in _creator_handles():
        g = grads.get(h, [])
        if g or force:
            path, _nt, _nn, nh = creator_report(h, now, None, {e["id"] for e in g})
            nm = strip_emoji(load(os.path.join(STATE, "creators_meta.json"), {}).get(h, {}).get("name") or h).strip() or h
            if g:
                cap = f"{nm} 有 {len(g)} 条推文进入历史热帖（{t:%H:%M} 采集）"
            else:
                cap = f"{nm} 历史热帖共 {nh} 条（{t:%H:%M} 强制报告）"
            lines.append("PUSH\t%s\t%s" % (path, cap))
        else:
            lines.append("NO_UPDATES\t@%s" % h)
    try:
        build_dashboard(now)
    except Exception as e:
        print(f"WARN dashboard: {e}", file=sys.stderr)
    return lines



