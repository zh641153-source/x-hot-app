def main():
    a = sys.argv[1:]
    if not a:
        print(__doc__); return
    now = None
    if "--now" in a:
        now = parse_ts(a[a.index("--now") + 1])
    if a[0] == "plan":
        plan(a[1:])
    elif a[0] == "ingest":
        ingest(a[1])
    elif a[0] == "finalize":
        for ln in finalize(a[1], force="--force" in a, now=now):
            print(ln)
    elif a[0] == "report":
        p, nt, nn, nh = creator_report(a[1], now)
        print(f"{p}\tnew_hist={nn} history={nh}")
        try:
            build_dashboard(now)
        except Exception as e:
            print(f"WARN dashboard: {e}", file=sys.stderr)
    elif a[0] == "seed-history":
        seed_history(now)
    elif a[0] == "dashboard":
        p = build_dashboard(now)
        print(p)
    elif a[0] == "status":
        status()
    else:
        print(__doc__)


if __name__ == "__main__":
