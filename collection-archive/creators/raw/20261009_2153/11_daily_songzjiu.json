{"data":[{"author_id":"1183028604248027137","created_at":"2026-10-09T09:48:16.000Z","edit_history_tweet_ids":["2108494746654289994"],"id":"2108494746654289994","lang":"zh","public_metrics":{"bookmark_count":478,"impression_count":122352,"like_count":905,"quote_count":2,"reply_count":43,"retweet_count":51},"text":"性爱小技巧（针对男生）\n射完之后别急着松口。他还在抖的时候，整根含住，舌头垫在下面，先别动，就用嘴包着捂热。等他那一下抽完，你舌尖轻轻顶住龟头底下那条筋，就顶着，别乱舔。他多半自己会往前送一下。","url":"https://x.com/Songzjiu/status/2108494746654289994"},{"author_id":"1183028604248027137","created_at":"2026-10-09T09:39:06.000Z","edit_history_tweet_ids":["2108492442513420594"],"id":"2108492442513420594","lang":"art","public_metrics":{"bookmark_count":4,"impression_count":4549,"like_count":9,"quote_count":0,"reply_count":0,"retweet_count":0},"referenced_tweets":[{"id":"2108491952517943519","type":"quoted"}],"text":"🍦 https://t.co/J2hjjPp4Of","url":"https://x.com/Songzjiu/status/2108492442513420594"},{"author_id":"1183028604248027137","created_at":"2026-10-08T15:55:28.000Z","edit_history_tweet_ids":["2108224768608739512"],"id":"2108224768608739512","lang":"zh","public_metrics":{"bookmark_count":626,"impression_count":43140,"like_count":941,"quote_count":1,"reply_count":21,"retweet_count":55},"text":"性爱小技巧\n（高潮后继续刺激）\n高潮后阴蒂会短暂变得极度敏感，有的女生会下意识夹腿躲，但只要手法对，几秒到十几秒就能从“受不了”转到第二波甚至连续高潮。核心是别一上来就猛舔或猛按，先顺着她身体的收缩节奏走。","url":"https://x.com/Songzjiu/status/2108224768608739512"},{"author_id":"1183028604248027137","created_at":"2026-10-08T15:50:36.000Z","edit_history_tweet_ids":["2108223545407148177"],"id":"2108223545407148177","lang":"ja","public_metrics":{"bookmark_count":0,"impression_count":13161,"like_count":6,"quote_count":0,"reply_count":0,"retweet_count":0},"referenced_tweets":[{"id":"2108167991171096982","type":"quoted"}],"text":"哎 https://t.co/mRfn3jNs2d","url":"https://x.com/Songzjiu/status/2108223545407148177"}],"includes":{"tweets":[{"author_id":"2108479923203846144","created_at":"2026-10-09T09:37:10.000Z","edit_history_tweet_ids":["2108491952517943519"],"id"