{"data": [{"author_id": "1223407990713114624", "created_at": "2026-10-10T10:02:17.000Z", "edit_history_tweet_ids": ["2108860663494025279"], "id": "2108860663494025279", "lang": "ja", "public_metrics": {"bookmark_count": 0, "impression_count": 290, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2108855518009991261", "type": "quoted"}], "text": "美丽 https://t.co/9s5FnPJj2Z", "url": "https://x.com/wmtbxsh/status/2108860663494025279"}, {"author_id": "1223407990713114624", "created_at": "2026-10-10T08:06:55.000Z", "edit_history_tweet_ids": ["2108831631532490802"], "id": "2108831631532490802", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 2219, "like_count": 12, "quote_count": 0, "reply_count": 6, "retweet_count": 0}, "text": "我咋感觉运营岗种类那么多呢…感觉除了开发类的技术岗的其他的都可以归为运营岗…", "url": "https://x.com/wmtbxsh/status/2108831631532490802"}, {"author_id": "1223407990713114624", "created_at": "2026-10-10T07:41:06.000Z", "edit_history_tweet_ids": ["2108821730290766258", "2108825132391379278"], "id": "2108825132391379278", "lang": "zh", "public_metrics": {"bookmark_count": 3, "impression_count": 2559, "like_count": 17, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "目前收到了两家小的互联网公司海外运营岗的笔试面试邀约，但是本人还是想去互联网中大厂or中上券商/基金实习🥲因为感觉我的简历很难看，想要刷刷简历，并且运营岗我已经有两段小厂实习了…", "url": "https://x.com/wmtbxsh/status/2108825132391379278"}, {"author_id": "1223407990713114624", "created_at": "2026-10-10T06:33:26.000Z", "edit_history_tweet_ids": ["2108807240081887492", "2108808104653840838"], "id": "2108808104653840838", "lang": "zh", "public_metrics": {"bookmark_count": 11, "impression_count": 31878, "like_count": 211, "quote_count": 0, "reply_count": 43, "retweet_count": 1}, "text": "人类真的是完了…我刷到一个在水族馆工作的人分享自己操母海豚的经历…还说母海豚那里是螺旋状的，操起来比人类要紧要舒服…我要吐了…", "url": "https://x.com/wmtbxsh/status/2108808104653840838"}, {"author_id": "1223407990713114624", "created_at": "2026-10-10T06:32:32.000Z", "edit_history_tweet_ids": ["210