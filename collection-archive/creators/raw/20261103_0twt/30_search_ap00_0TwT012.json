rk_count":0,"impression_count":108,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"認識新的人你開心嗎","url":"https://x.com/0TwT012/status/1930089373128933403"},{"author_id":"1917047326990094336","created_at":"2025-06-03T02:06:33.000Z","edit_history_tweet_ids":["1929721336861282726"],"id":"1929721336861282726","public_metrics":{"bookmark_count":0,"impression_count":130,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"我越來越控制不了自己的憤怒了，明明前段時間我的憤怒還在身體里輕輕的沈睡著，隨著年齡的增長身體的變差，我過於生氣真的會暈過去…我頭好痛","url":"https://x.com/0TwT012/status/1929721336861282726"},{"author_id":"1917047326990094336","created_at":"2025-06-02T23:02:28.000Z","edit_history_tweet_ids":["1929675010286948693"],"id":"1929675010286948693","public_metrics":{"bookmark_count":0,"impression_count":909,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"小鱼走了 https://t.co/zZhyU8RK11","url":"https://x.com/0TwT012/status/1929675010286948693"},{"author_id":"1917047326990094336","created_at":"2025-05-24T04:27:55.000Z","edit_history_tweet_ids":["1926133032206942360"],"id":"1926133032206942360","public_metrics":{"bookmark_count":0,"impression_count":141,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"哈哈真的很崩潰。","url":"https://x.com/0TwT012/status/1926133032206942360"},{"author_id":"1917047326990094336","created_at":"2025-05-22T14:10:27.000Z","edit_history_tweet_ids":["1925554856376594918"],"id":"1925554856376594918","public_metrics":{"bookmark_count":1,"impression_count":875,"like_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"https://t.co/ujEMA5RO8X","url":"https://x.com/0TwT012/status/1925554856376594918"},{"author_id":"1917047326990094336","created_at":"2025-05-21T17:02:22.000Z","edit_history_tweet_ids":["1925235733801189503"],"id":"1925235733801189503","public_metrics":{"bookmark_count":0,"impression_count":124,"like_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"剛認識前夫的時候他說他修的無情道，現在反駁我說，其實是當時不讓我扒他褲子撒的謊。","url":"https://x.com/0TwT012/status/1925235733801189503"},{"author_id":"1917047326990094336","created_at":"2025-05-21T11:20:14.000Z","edit_history_tweet_ids":["1925149631916433535"],"id":"1925149631916433535","public_metrics":{"bookmark_count":0,"impression_count":128,"like_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"沒有你的話這一生也太長了，可是有你的話有些時候又太哽咽了。","url":"https://x.com/0TwT012/status/1925149631916433535"},{"author_id":"1917047326990094336","created_at":"2025-05-21T11:04:56.000Z","edit_history_tweet_ids":["1925145783617405354"],"id":"1925145783617405354","public_metrics":{"bookmark_count":0,"impression_count":118,"like_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"あつすぎ——","url":"https://x.com/0TwT012/status/1925145783617405354"},{"author_id":"1917047326990094336","created_at":"2025-05-21T08:22:56.000Z","edit_history_tweet_ids":["1925105012478460069"],"id":"1925105012478460069","public_metrics":{"bookmark_count":0,"impression_count":861,"like_count":2,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"爱 https://t.co/Xht1IWCQ4u","url":"https://x.com/0TwT012/status/1925105012478460069"},{"author_id":"1917047326990094336","created_at":"2025-05-19T03:08:03.000Z","edit_history_tweet_ids":["1924300992344195561"],"id":"1924300992344195561","public_metrics":{"bookmark_count":0,"impression_count":134,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"煙，我是個好擰巴的人，我想說給我發珠海的夜景吧，突然想起才七點，你大概還沒有下船。\n現在九點了，天應該黑了，稀裡糊塗的，好像又覺得關係沒到那麼親密。\n我像一個謹慎的蝸牛，一爬一爬偶爾試圖拉進些相隔的間隙，小小根紅線緊繃著，連接著我的睫毛和你的頭髮。\n煙，給我看看珠海的月吧。","url":"https://x.com/0TwT012/status/1924300992344195561"},{"author_id":"1917047326990094336","created_at":"2025-05-18T02:20:19.000Z","edit_history_tweet_ids":["1923926595787686258"],"id":"1923926595787686258","public_metrics":{"bookmark_count":0,"impression_count":119,"like_count":2,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"總有一天我會遇上堅定選擇我的人。","url":"https://x.com/0TwT012/status/1923926595787686258"},{"author_id":"1917047326990094336","created_at":"2025-05-17T16:56:11.000Z","edit_history_tweet_ids":["1923784623827583195"],"id":"1923784623827583195","public_metrics":{"bookmark_count":0,"impression_count":139,"like_count":0,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"狗善被人欺 小狗被親親","url":"https://x.com/0TwT012/status/1923784623827583195"},{"author_id":"1917047326990094336","created_at":"2025-05-17T16:24:39.000Z","edit_history_tweet_ids":["1923776690779717892"],"id":"1923776690779717892","public_metrics":{"bookmark_count":0,"impression_count":107,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"我最擅長的有氧運動是忍氣吞聲","url":"https://x.com/0TwT012/status/1923776690779717892"},{"author_id":"1917047326990094336","created_at":"2025-05-17T14:53:47.000Z","edit_history_tweet_ids":["1923753820355690944"],"id":"1923753820355690944","public_metrics":{"bookmark_count":0,"impression_count":111,"like_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"你為什麼從來不夢到我","url":"https://x.com/0TwT012/status/1923753820355690944"},{"author_id":"1917047326990094336","created_at":"2025-05-16T18:18:37.000Z","edit_history_tweet_ids":["1923442981110960284"],"id":"1923442981110960284","public_metrics":{"bookmark_count":0,"impression_count":93,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"祝你以後永遠都在自己身上想起我","url":"https://x.com/0TwT012/status/1923442981110960284"},{"author_id":"1917047326990094336","created_at":"2025-05-16T09:27:40.000Z","edit_history_tweet_ids":["1923309366167417002"],"id":"1923309366167417002","public_metrics":{"bookmark_count":0,"impression_count":99,"like_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"老公要像狗一樣聽話","url":"https://x.com/0TwT012/status/1923309366167417002"},{"author_id":"1917047326990094336","created_at":"2025-05-16T07:09:11.000Z","edit_history_tweet_ids":["1923274513187266603"],"id":"1923274513187266603","public_metrics":{"bookmark_count":0,"impression_count":85,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"是在罵我嗎，聽不懂感覺像撒嬌啊","url":"https://x.com/0TwT012/status/1923274513187266603"},{"author_id":"1917047326990094336","created_at":"2025-05-10T16:04:50.000Z","edit_history_tweet_ids":["1921234986314637540"],"id":"1921234986314637540","public_metrics":{"bookmark_count":0,"impression_count":127,"like_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"生活你別操我了，以為是噴水了其實是流淚了。","url":"https://x.com/0TwT012/status/1921234986314637540"},{"author_id":"1917047326990094336","created_at":"2025-05-06T23:51:12.000Z","edit_history_tweet_ids":["1919902801255399681"],"id":"1919902801255399681","public_metrics":{"bookmark_count":0,"impression_count":115,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"感覺比起“我想你了”更萌的是“你不想我嗎？”，後者比前者已經包含了我好想你這個意思，而且更進一步的明面上是提問，其實在逼你說肯定回答，回答“我不想你”是萬萬不可的，只有無可回頭，無路可退\n的“我也好想你”作答復，唉太可愛了","url":"https://x.com/0TwT012/status/1919902801255399681"},{"author_id":"1917047326990094336","created_at":"2025-05-06T23:08:41.000Z","edit_history_tweet_ids":["1919892101069996299"],"id":"1919892101069996299","public_metrics":{"bookmark_count":0,"impression_count":825,"like_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"好險 https://t.co/IMnT4WPrXP","url":"https://x.com/0TwT012/status/1919892101069996299"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_image_url":"https://pbs.twimg.com/profile_images/1917047544313679872/akAJkXe1_normal.jpg","username":"0TwT012","verified":false}]},"meta":{"newest_id":"1972291247558783339","next_token":"b26v89c19zqg8o3fsbza4jwmuzehp8jsql7wizecnsprx","oldest_id":"1919892101069996299","result_count":25}}