02304741510"],"id":"2083215802304741510","public_metrics":{"bookmark_count":5,"impression_count":32106,"like_count":1036,"quote_count":5,"reply_count":72,"retweet_count":67},"text":"我发现开空调然后把自己裹成一个蛆好舒服","url":"https://x.com/0TwT012/status/2083215802304741510"},{"author_id":"1917047326990094336","created_at":"2026-07-31T15:36:51.000Z","edit_history_tweet_ids":["2083215320593129723"],"id":"2083215320593129723","public_metrics":{"bookmark_count":1,"impression_count":4225,"like_count":35,"quote_count":0,"reply_count":8,"retweet_count":3},"text":"没关系，没关系。淤青会变成碘伏的颜色，痛苦与止痛药本来就是同一样东西。","url":"https://x.com/0TwT012/status/2083215320593129723"},{"author_id":"1917047326990094336","created_at":"2026-07-31T15:34:06.000Z","edit_history_tweet_ids":["2083214630051332444"],"id":"2083214630051332444","public_metrics":{"bookmark_count":2,"impression_count":3375,"like_count":39,"quote_count":0,"reply_count":6,"retweet_count":3},"text":"我爱表达，但我幸福的时候一般不表达","url":"https://x.com/0TwT012/status/2083214630051332444"},{"author_id":"1917047326990094336","created_at":"2026-07-31T09:15:11.000Z","edit_history_tweet_ids":["2083119272579264953"],"id":"2083119272579264953","public_metrics":{"bookmark_count":1,"impression_count":3582,"like_count":56,"quote_count":0,"reply_count":0,"retweet_count":4},"text":"现在倘若有人问我你拥有真爱么 我可以回答了 是的我拥有真爱 不系于他人 系于我与世界 真爱是蚌壳里的沙砾 是磨盘底下的黄豆 通常人说 要血肉模糊 筋骨寸断才见到真爱 不是的 它只是黏糊糊的体液和内容物任何人都可以剖开自己得之真爱 只在于愿不愿意用诚实 作为向己的利刃。","url":"https://x.com/0TwT012/status/2083119272579264953"},{"author_id":"1917047326990094336","created_at":"2026-07-30T19:29:05.000Z","edit_history_tweet_ids":["2082911378147566078"],"id":"2082911378147566078","public_metrics":{"bookmark_count":0,"impression_count":2964,"like_count":35,"quote_count":0,"reply_count":2,"retweet_count":2},"text":"唉希望我的朋友们都能过幸福一点 她们都是很好的人。","url":"https://x.com/0TwT012/status/2082911378147566078"},{"author_id":"1917047326990094336","created_at":"2026-07-30T19:27:59.000Z","edit_history_tweet_ids":["2082911100333649937"],"id":"2082911100