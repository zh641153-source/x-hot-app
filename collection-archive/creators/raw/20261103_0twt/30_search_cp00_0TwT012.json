ount":2,"retweet_count":1},"text":"我： https://t.co/ordEc7T1Lw","url":"https://x.com/0TwT012/status/2082414998169760114"},{"author_id":"1917047326990094336","created_at":"2026-07-29T10:26:03.000Z","edit_history_tweet_ids":["2082412329086664768"],"id":"2082412329086664768","public_metrics":{"bookmark_count":3,"impression_count":3041,"like_count":33,"quote_count":0,"reply_count":1,"retweet_count":3},"text":"我的计划是一直撸管直到有人握住我的手告诉我你别撸了以后你操我吧","url":"https://x.com/0TwT012/status/2082412329086664768"},{"author_id":"1917047326990094336","created_at":"2026-07-29T10:08:22.000Z","edit_history_tweet_ids":["2082407881165754599"],"id":"2082407881165754599","public_metrics":{"bookmark_count":0,"impression_count":3954,"like_count":15,"quote_count":0,"reply_count":24,"retweet_count":0},"text":"和我私信即可订阅每日弱智tv脑残tv","url":"https://x.com/0TwT012/status/2082407881165754599"},{"author_id":"1917047326990094336","created_at":"2026-07-29T08:40:52.000Z","edit_history_tweet_ids":["2082385858993516773"],"id":"2082385858993516773","public_metrics":{"bookmark_count":10,"impression_count":10147,"like_count":183,"quote_count":3,"reply_count":65,"retweet_count":29},"text":"我从不后悔对任何一个人好，哪怕是看错人，哪怕是被辜负，哪怕是撞南墙，因为我对你好，不代表你有多好，只是因为我很好","url":"https://x.com/0TwT012/status/2082385858993516773"},{"author_id":"1917047326990094336","created_at":"2026-07-28T18:37:27.000Z","edit_history_tweet_ids":["2082173608466829553"],"id":"2082173608466829553","public_metrics":{"bookmark_count":1,"impression_count":4110,"like_count":48,"quote_count":0,"reply_count":8,"retweet_count":5},"text":"你的心情好吗？借我两天，我的坏了","url":"https://x.com/0TwT012/status/2082173608466829553"},{"author_id":"1917047326990094336","created_at":"2026-07-28T02:11:18.000Z","edit_history_tweet_ids":["2081925435118829774"],"id":"2081925435118829774","public_metrics":{"bookmark_count":4,"impression_count":6535,"like_count":120,"quote_count":0,"reply_count":19,"retweet_count":17},"text":"你放心吧，你不是故意说的那些话我全都往心里去了，你不是故意做的那些事我也当回事了","url":"https://x.com/0TwT012/status/2081925435118829774"},{"author_id":"1917047326990094336","created_at":"2026-07-27T15:03:28.000Z","edit_history_tweet_ids":["2081757367730077846"],"id":"2081757367730077846","public_metrics":{"bookmark_count":0,"impression_count":3063,"like_count":18,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"每次我觉得自己过得好像有一点惨的时候我都会在心里默默地跟自己说，不用怕现在是命运在嬷嬷你呢，这导致一旦我略有所得的时候尾巴就会翘到天上去，心中不禁感叹，真是公得不可一世啊！一念公嬷无外乎此。\n这条太精彩了","url":"https://x.com/0TwT012/status/2081757367730077846"},{"author_id":"1917047326990094336","created_at":"2026-07-27T15:02:34.000Z","edit_history_tweet_ids":["2081757143712358605"],"id":"2081757143712358605","public_metrics":{"bookmark_count":13,"impression_count":8787,"like_count":185,"quote_count":1,"reply_count":2,"retweet_count":32},"text":"痛苦不会因为多一个人陪你承受就真的消减成原来的二分之一，但我会永远感谢那些曾耐心陪我熬过极度痛苦时刻的朋友。即使是一句都不说或者是说很多荒唐的胡话，最终都在那漫长的无数个一秒钟里找到了生活下去的出口。","url":"https://x.com/0TwT012/status/2081757143712358605"},{"author_id":"1917047326990094336","created_at":"2026-07-27T11:25:38.000Z","edit_history_tweet_ids":["2081702550945116471"],"id":"2081702550945116471","public_metrics":{"bookmark_count":0,"impression_count":2960,"like_count":8,"quote_count":0,"reply_count":0,"retweet_count":1},"text":"慢着我怎么这几天没看钱包一下子就没有钱了。","url":"https://x.com/0TwT012/status/2081702550945116471"},{"author_id":"1917047326990094336","created_at":"2026-07-26T18:50:44.000Z","edit_history_tweet_ids":["2081452172873732430"],"id":"2081452172873732430","public_metrics":{"bookmark_count":3,"impression_count":4588,"like_count":70,"quote_count":1,"reply_count":1,"retweet_count":11},"text":"我经常感觉，很空虚，很寂寞，可是我，不知道自己要什么，需要拼命做什么，或者需要某个人，才能填满这种孤独","url":"https://x.com/0TwT012/status/2081452172873732430"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_image_url":"https://pbs.twimg.com/profile_images/1917047544313679872/akAJkXe1_normal.jpg","username":"0TwT012","verified":false}]},"meta":{"newest_id":"2083282360502751727","next_token":"b26v89c19zqg8o3juewg2vooaooc12w164aazjqysdabh","