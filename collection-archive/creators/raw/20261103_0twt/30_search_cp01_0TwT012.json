{"data":[{"author_id":"1917047326990094336","conversation_id":"2081442767646183807","created_at":"2026-07-26T18:13:21.000Z","edit_history_tweet_ids":["2081442767646183807"],"id":"2081442767646183807","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3228,"like_count":41,"quote_count":0,"reply_count":0,"retweet_count":8},"text":"因为失去太痛了所以会增加自己感知的能力，会让幸福和痛苦都更加真切。她好像是那一层皮，被磨掉之后任何事情都能被感知得更真切。","url":"https://x.com/0TwT012/status/2081442767646183807"},{"author_id":"1917047326990094336","conversation_id":"2081401468364746795","created_at":"2026-07-26T15:29:15.000Z","edit_history_tweet_ids":["2081401468364746795"],"id":"2081401468364746795","lang":"zh","public_metrics":{"bookmark_count":6,"impression_count":7470,"like_count":124,"quote_count":4,"reply_count":37,"retweet_count":7},"text":"好喜欢看那种还没弄清楚自己情感只好遵从自己内心以至于显得有些呆萌的人啊...可能抛下一切只为见相方一面，问他为什么到楼下却不打电话就干站着，他说我好像...好像有点想你了","url":"https://x.com/0TwT012/status/2081401468364746795"},{"author_id":"1917047326990094336","conversation_id":"2081383387546505431","created_at":"2026-07-26T14:17:24.000Z","edit_history_tweet_ids":["2081383387546505431"],"id":"2081383387546505431","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":6722,"like_count":62,"quote_count":1,"reply_count":6,"retweet_count":10},"text":"问好多问题是因为喜欢，不问问题是因为太喜欢。说好多话是因为喜欢，不说话是因为太喜欢。","url":"https://x.com/0TwT012/status/2081383387546505431"},{"author_id":"1917047326990094336","conversation_id":"2081381677637779572","created_at":"2026-07-26T14:10:36.000Z","edit_history_tweet_ids":["2081381677637779572"],"id":"2081381677637779572","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":4193,"like_count":26,"quote_count":0,"reply_count":13,"retweet_count":0},"text":"好生气好生气我不明白为什么地铁上总有人喜欢靠在杆子上，我手还握着那呢，能不能有点边界感","url":"https://x.com/0TwT012/status/2081381677637779572"},{"author_id":"1917047326990094336","conversation_id":"2081092667954602105","created_at":"2026-07-25T19:02:11.000Z","edit_history_tweet_ids":["2081092667954602105"],"id":"2081092667954602105","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3223,"like_count":35,"quote_count":0,"reply_count":3,"retweet_count":3},"text":"有时候感觉很远的东西也没有很远，永远的东西也没有很远，遥远的远方也没有很远，永远的人也没有很远，至少有一瞬间我与它们近在咫尺，反而跟那些看得到的很近的东西咫尺天涯","url":"https://x.com/0TwT012/status/2081092667954602105"},{"author_id":"1917047326990094336","conversation_id":"2080919943860949146","created_at":"2026-07-25T07:35:50.000Z","edit_history_tweet_ids":["2080919943860949146"],"id":"2080919943860949146","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":4287,"like_count":39,"quote_count":0,"reply_count":36,"retweet_count":2},"text":"我的恶俗程度会因人而异 亲密度升高将解锁下段剧情","url":"https://x.com/0TwT012/status/2080919943860949146"},{"author_id":"1917047326990094336","conversation_id":"2080717744157475295","created_at":"2026-07-24T18:12:22.000Z","edit_history_tweet_ids":["2080717744157475295"],"id":"2080717744157475295","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":5218,"like_count":40,"quote_count":1,"reply_count":7,"retweet_count":3},"text":"感觉赌气最幼稚的一点就是不回消息，但我又正好是这种人。","url":"https://x.com/0TwT012/status/2080717744157475295"},{"author_id":"1917047326990094336","conversation_id":"2080562872229495084","created_at":"2026-07-24T07:56:58.000Z","edit_history_tweet_ids":["2080562872229495084"],"id":"2080562872229495084","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":3972,"like_count":47,"quote_count":1,"reply_count":14,"retweet_count":5},"text":"我们在一起都不快乐，分开有什么好难过的。","url":"https://x.com/0TwT012/status/2080562872229495084"},{"author_id":"1917047326990094336","conversation_id":"2080360387690852494","created_at":"2026-07-23T18:32:22.000Z","edit_history_tweet_ids":["2080360387690852494"],"id":"2080360387690852494","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":4596,"like_count":68,"quote_count":0,"reply_count":9,"retweet_count":10},"text":"如果要问我你最想要拥有的能力是什么？\n18岁的我可能会回答我想要狂吃不胖，想要怎么熬夜都不长痘。现在的我思考这个问题，我会回答我想要选择性遗忘过去的能力，想要有能睡个好觉的能力，有平静对待生活的能力。人就是在不知不觉中变化的。成长的代价就是看着曾经易如反掌的东西变成遥不可及的愿望。","url":"https://x.com/0TwT012/status/2080360387690852494"},{"author_id":"1917047326990094336","conversation_id":"2080359265336959308","created_at":"2026-07-23T18:27:54.000Z","edit_history_tweet_ids":["2080359265336959308"],"id":"2080359265336959308","lang":"zxx","public_metrics":{"bookmark_count":0,"impression_count":5379,"like_count":21,"quote_count":0,"reply_count":3,"retweet_count":1},"text":"https://t.co/EZXNYKU6JQ","url":"https://x.com/0TwT012/status/2080359265336959308"},{"author_id":"1917047326990094336","conversation_id":"2080358853330555195","created_at":"2026-07-23T18:26:16.000Z","edit_history_tweet_ids":["2080358853330555195"],"id":"2080358853330555195","lang":"zxx","public_metrics":{"bookmark_count":8,"impression_count":24795,"like_count":342,"quote_count":4,"reply_count":6,"retweet_count":15},"text":"https://t.co/nINO9GLx5P","url":"https://x.com/0TwT012/status/2080358853330555195"},{"author_id":"1917047326990094336","conversation_id":"2080316630257873144","created_at":"2026-07-23T15:38:29.000Z","edit_history_tweet_ids":["2080316630257873144"],"id":"2080316630257873144","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":8426,"like_count":103,"quote_count":2,"reply_count":10,"retweet_count":12},"text":"和一些人甚至没有道别就再也不见了 一些很深的羁绊也就那样淡淡结束了","url":"https://x.com/0TwT012/status/2080316630257873144"},{"author_id":"1917047326990094336","conversation_id":"2080280421926060174","created_at":"2026-07-23T13:14:36.000Z","edit_history_tweet_ids":["2080280421926060174"],"id":"2080280421926060174","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3055,"like_count":30,"quote_count":1,"reply_count":0,"retweet_count":3},"text":"佩服就算长时间断联也可以重新稔熟的交谈和恢复关系亲密度的人，我总是觉得感情里不说些和做些对等付出的话语和事情，就马上要断掉了","url":"https://x.com/0TwT012/status/2080280421926060174"},{"author_id":"1917047326990094336","conversation_id":"2080275053346975912","created_at":"2026-07-23T12:53:17.000Z","edit_history_tweet_ids":["2080275053346975912"],"id":"2080275053346975912","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3302,"like_count":33,"quote_count":0,"reply_count":0,"retweet_count":1},"text":"当我在每段关系里看到对方的泪水无动于衷时，我知道这段关系完了","url":"https://x.com/0TwT012/status/2080275053346975912"},{"author_id":"1917047326990094336","conversation_id":"2080272591911293392","created_at":"2026-07-23T12:43:30.000Z","edit_history_tweet_ids":["2080272591911293392"],"id":"2080272591911293392","lang":"zh","public_metrics":{"bookmark_count":4,"impression_count":5339,"like_count":79,"quote_count":1,"reply_count":4,"retweet_count":14},"text":"想念一个人是有重量的 把灯关了 屋子就满了 你在每一寸黑暗里 唯独不在眼前","url":"https://x.com/0TwT012/status/2080272591911293392"},{"author_id":"1917047326990094336","conversation_id":"2080271458757210386","created_at":"2026-07-23T12:38:59.000Z","edit_history_tweet_ids":["2080271458757210386"],"id":"2080271458757210386","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":4096,"like_count":34,"quote_count":0,"reply_count":2,"retweet_count":3},"text":"我不会想要二十三岁的自己死掉了，因为我已经为这个世界付出了深情到无可挽回的沉没成本，我不要让自己经历过的一切变得不划算。可是，如果可以的话，我还是觉得让我死在十四岁是很好的事情。我能抚慰她、终结她，赶在她向世界付出这一切代价之前。","url":"https://x.com/0TwT012/status/2080271458757210386"},{"author_id":"1917047326990094336","conversation_id":"2080271253294972950","created_at":"2026-07-23T12:38:11.000Z","edit_history_tweet_ids":["2080271253294972950"],"id":"2080271253294972950","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":14099,"like_count":92,"quote_count":0,"reply_count":15,"retweet_count":13},"text":"我好想就这样忘记你再也不认识你","url":"https://x.com/0TwT012/status/2080271253294972950"},{"author_id":"1917047326990094336","conversation_id":"2079930805502242820","created_at":"2026-07-22T14:05:21.000Z","edit_history_tweet_ids":["2079930805502242820"],"id":"2079930805502242820","lang":"zh","public_metrics":{"bookmark_count":6,"impression_count":6741,"like_count":124,"quote_count":1,"reply_count":8,"retweet_count":18},"text":"我总是在一段关系里耗尽自己才离开","url":"https://x.com/0TwT012/status/2079930805502242820"},{"author_id":"1917047326990094336","conversation_id":"2079930664292663771","created_at":"2026-07-22T14:04:48.000Z","edit_history_tweet_ids":["2079930664292663771"],"id":"2079930664292663771","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3699,"like_count":32,"quote_count":0,"reply_count":6,"retweet_count":4},"text":"我不是什么圣人啊我只是对自己太差了","url":"https://x.com/0TwT012/status/2079930664292663771"},{"author_id":"1917047326990094336","conversation_id":"2079930547200200856","created_at":"2026-07-22T14:04:20.000Z","edit_history_tweet_ids":["2079930547200200856"],"id":"2079930547200200856","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":3366,"like_count":27,"quote_count":0,"reply_count":0,"retweet_count":1},"text":"不断的重复用承受代替选择，说到底只是在反复背叛自己的感受。直到我某天发觉这代价已经大到我无法再去忽视","url":"https://x.com/0TwT012/status/2079930547200200856"},{"author_id":"1917047326990094336","conversation_id":"2079930050389135779","created_at":"2026-07-22T14:02:21.000Z","edit_history_tweet_ids":["2079930050389135779"],"id":"2079930050389135779","lang":"zh","public_metrics":{"bookmark_count":6,"impression_count":7007,"like_count":79,"quote_count":2,"reply_count":0,"retweet_count":9},"text":"“为什么我每次感觉到不对劲的时候，却不想离开？”\n“为什么我明知道这个人不对，还是给了他第二次、第三次、第四次机会？”\n“为什么我经常不相信自己的感受，非要等被伤透了才肯承认？”\n“为什么我总是不允许自己被好好对待”","url":"https://x.com/0TwT012/status/2079930050389135779"},{"author_id":"1917047326990094336","conversation_id":"2079929733148823629","created_at":"2026-07-22T14:01:06.000Z","edit_history_tweet_ids":["2079929733148823629"],"id":"2079929733148823629","lang":"zh","public_metrics":{"bookmark_count":5,"impression_count":5537,"like_count":80,"quote_count":3,"reply_count":7,"retweet_count":8},"text":"如果你没有边界、习惯讨好，就会吸引习惯索取的人，如果你害怕冲突，就会吸引擅长操控的人，如果你渴求被需要的感觉，就会吸引擅长制造依赖的人","url":"https://x.com/0TwT012/status/2079929733148823629"},{"author_id":"1917047326990094336","conversation_id":"2079929496027980227","created_at":"2026-07-22T14:00:09.000Z","edit_history_tweet_ids":["2079929496027980227"],"id":"2079929496027980227","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":3066,"like_count":28,"quote_count":0,"reply_count":1,"retweet_count":3},"text":"面对带来痛苦的一切 然后到此为止吧","url":"https://x.com/0TwT012/status/2079929496027980227"},{"author_id":"1917047326990094336","conversation_id":"2079929258705928267","created_at":"2026-07-22T13:59:13.000Z","edit_history_tweet_ids":["2079929258705928267"],"id":"2079929258705928267","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":4049,"like_count":42,"quote_count":0,"reply_count":27,"retweet_count":7},"text":"事实上我们绝大部分情况下除了能左右自己的选择 无法控制任何人事物的变化","url":"https://x.com/0TwT012/status/2079929258705928267"},{"author_id":"1917047326990094336","conversation_id":"2079925028620226887","created_at":"2026-07-22T13:42:24.000Z","edit_history_tweet_ids":["2079925028620226887"],"id":"2079925028620226887","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":2562,"like_count":16,"quote_count":0,"reply_count":3,"retweet_count":1},"text":"我好难受我什么都没有了","url":"https://x.com/0TwT012/status/2079925028620226887"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_image_url":"https://pbs.twimg.com/profile_images/1917047544313679872/akAJkXe1_normal.jpg","username":"0TwT012","verified":false}]},"meta":{"newest_id":"2081442767646183807","next_token":"b26v89c19zqg8o3juetjoj5r2u60qb11thdlj5urddi7x","oldest_id":"2079925028620226887","result_count":25}}