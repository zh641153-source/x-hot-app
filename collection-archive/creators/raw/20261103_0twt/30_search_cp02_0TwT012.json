ics":{"bookmark_count":2,"impression_count":3520,"like_count":70,"quote_count":0,"reply_count":0,"retweet_count":11},"text":"我不后悔因为爱而做的这一切事，我只是不会再这么做了。","url":"https://x.com/0TwT012/status/2079881124449571319"},{"author_id":"1917047326990094336","conversation_id":"2079786748952158343","created_at":"2026-07-22T04:32:56.000Z","edit_history_tweet_ids":["2079786748952158343"],"id":"2079786748952158343","lang":"zh","public_metrics":{"bookmark_count":14,"impression_count":45289,"like_count":532,"quote_count":8,"reply_count":105,"retweet_count":50},"text":"人总是要从身体里流出些什么才能冲淡痛苦。","url":"https://x.com/0TwT012/status/2079786748952158343"},{"author_id":"1917047326990094336","conversation_id":"2079629879197544705","created_at":"2026-07-21T18:09:35.000Z","edit_history_tweet_ids":["2079629879197544705"],"id":"2079629879197544705","lang":"zh","public_metrics":{"bookmark_count":8,"impression_count":23313,"like_count":789,"quote_count":5,"reply_count":80,"retweet_count":74},"text":"有人拿手机后置拍我时，在我看来和用枪口对我没有任何区别。","url":"https://x.com/0TwT012/status/2079629879197544705"},{"author_id":"1917047326990094336","conversation_id":"2079629627774103802","created_at":"2026-07-21T18:08:35.000Z","edit_history_tweet_ids":["2079629627774103802"],"id":"2079629627774103802","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":4180,"like_count":32,"quote_count":0,"reply_count":11,"retweet_count":0},"text":"你气死我吧，你气死我我让你没爸爸","url":"https://x.com/0TwT012/status/2079629627774103802"},{"author_id":"1917047326990094336","conversation_id":"2079626993998733765","created_at":"2026-07-21T17:58:07.000Z","edit_history_tweet_ids":["2079626993998733765"],"id":"2079626993998733765","lang":"zh","public_metrics":{"bookmark_count":40,"impression_count":116199,"like_count":1929,"quote_count":39,"reply_count":126,"retweet_count":445},"text":"卧槽，好尴尬呀，我还以为我在你那里很重要呢","url":"https://x.com/0TwT012/status/2079626993998733765"},{"author_id":"1917047326990094336","conversation_id":"2079548462484558000","created_at":"2026-07-21T12:46:04.000Z","edit_history_tweet_ids":["2079548462484558000"],"id":"2079548462484558000","lang":"ja","public_metrics":{"bookmark_count":0,"impression_count":2654,"like_count":17,"quote_count":0,"reply_count":7,"retweet_count":0},"text":"kiri想要很多很多的飞鼠","url":"https://x.com/0TwT012/status/2079548462484558000"},{"author_id":"1917047326990094336","conversation_id":"2079327996364964291","created_at":"2026-07-20T22:10:01.000Z","edit_history_tweet_ids":["2079327996364964291"],"id":"2079327996364964291","lang":"zh","public_metrics":{"bookmark_count":7,"impression_count":15407,"like_count":238,"quote_count":1,"reply_count":41,"retweet_count":43},"text":"好想要一段我每天能问无数遍对方你喜不喜欢我想不想我，然后这么无聊的话也能被对方不厌其烦回应无数遍的关系，啊","url":"https://x.com/0TwT012/status/2079327996364964291"},{"author_id":"1917047326990094336","conversation_id":"2079289578507436468","created_at":"2026-07-20T19:37:21.000Z","edit_history_tweet_ids":["2079289578507436468"],"id":"2079289578507436468","lang":"zh","public_metrics":{"bookmark_count":4,"impression_count":14673,"like_count":213,"quote_count":8,"reply_count":63,"retweet_count":26},"text":"你不是人缘好只是门槛低呀","url":"https://x.com/0TwT012/status/2079289578507436468"},{"author_id":"1917047326990094336","conversation_id":"2079285292545216767","created_at":"2026-07-20T19:20:19.000Z","edit_history_tweet_ids":["2079285292545216767"],"id":"2079285292545216767","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2892,"like_count":26,"quote_count":0,"reply_count":7,"retweet_count":4},"text":"如果能轻松的活下去就好了","url":"https://x.com/0TwT012/status/2079285292545216767"},{"author_id":"1917047326990094336","conversation_id":"2079266828342485328","created_at":"2026-07-20T18:06:57.000Z","edit_history_tweet_ids":["2079266828342485328"],"id":"2079266828342485328","lang":"zh","public_metrics":{"bookmark_count":8,"impression_count":5428,"like_count":127,"quote_count":0,"reply_count":8,"retweet_count":21},"text":"你晚一点和我分开吧，我不想再说永远了，我曾经几次把我的心放在别人的胸膛里，我想如果即使缘分不够，我这样用力也会有个永远吧，我没有对命运不温驯呀，只是我的心再也经不起这种分离。","url":"https://x.com/0TwT012/status/2079266828342485328"},{"author_id":"1917047326990094336","conversation_id":"2079103267276251201","created_at":"2026-07-20T07:17:01.000Z","edit_history_tweet_ids":["2079103267276251201"],"id":"2079103267276251201","lang":"zh","public_metrics":{"bookmark_count":5,"impression_count":9836,"like_count":207,"quote_count":1,"reply_count":21,"retweet_count":12},"text":"经过本人的研究，13点起床才是性价比最高的，只需要吃一顿饭还不饿，晚上还能玩到三点也不困，七点起床吃三顿饭的人就是饭桶败家子 ?","url":"https://x.com/0TwT012/status/2079103267276251201"},{"author_id":"1917047326990094336","conversation_id":"2078901966080745913","created_at":"2026-07-19T17:57:07.000Z","edit_history_tweet_ids":["2078901966080745913"],"id":"2078901966080745913","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":3406,"like_count":54,"quote_count":0,"reply_count":10,"retweet_count":7},"text":"我时常发一些不明不白的东西，有人以为我恋爱了，有人以为我分手了，有人以为我抑郁了。其实我只是爱发。","url":"https://x.com/0TwT012/status/2078901966080745913"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_image_url":"https://pbs.twimg.com/profile_images/1917047544313679872/akAJkXe1_normal.jpg","username":"0TwT012","verified":false}]},"meta":{"newest_id":"2079924881551237133","next_token":"b26v89c19zqg8o3juetj9dj7ewunogikd6clwi40whb3x","oldest_id":"2078901966080745913","result_count":25}}