{"data":[{"author_id":"1917047326990094336","conversation_id":"2074813629569065112","created_at":"2026-07-08T11:11:32.000Z","edit_history_tweet_ids":["2074813629569065112"],"id":"2074813629569065112","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":2892,"like_count":23,"quote_count":0,"reply_count":14,"retweet_count":0},"text":"台风来了大家就躲到那个山姆超市里面，台风没有会员进不去的","url":"https://x.com/0TwT012/status/2074813629569065112"},{"author_id":"1917047326990094336","conversation_id":"2074768127087595656","created_at":"2026-07-08T08:10:43.000Z","edit_history_tweet_ids":["2074768127087595656"],"id":"2074768127087595656","lang":"ja","public_metrics":{"bookmark_count":0,"impression_count":13566,"like_count":80,"quote_count":0,"reply_count":16,"retweet_count":12},"text":"你到底啥时候才缺人陪呀 我也想陪陪你","url":"https://x.com/0TwT012/status/2074768127087595656"},{"author_id":"1917047326990094336","conversation_id":"2074544048967504146","created_at":"2026-07-07T17:20:19.000Z","edit_history_tweet_ids":["2074544048967504146"],"id":"2074544048967504146","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":6451,"like_count":43,"quote_count":2,"reply_count":10,"retweet_count":1},"text":"我觉得电波真的太重要了 没对上的会想你这家伙在说什么啊 对上电波的母星人只会说哦哦哦哦哦哦！","url":"https://x.com/0TwT012/status/2074544048967504146"},{"author_id":"1917047326990094336","conversation_id":"2074535759437337061","created_at":"2026-07-07T16:47:22.000Z","edit_history_tweet_ids":["2074535759437337061"],"id":"2074535759437337061","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":2631,"like_count":18,"quote_count":0,"reply_count":9,"retweet_count":3},"text":"看到过去的那些事情又开始变得越来越难受","url":"https://x.com/0TwT012/status/2074535759437337061"},{"author_id":"1917047326990094336","conversation_id":"2074532466791166262","created_at":"2026-07-07T16:34:17.000Z","edit_history_tweet_ids":["2074532466791166262"],"id":"2074532466791166262","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":2976,"like_count":50,"quote_count":0,"reply_count":10,"retweet_count":7},"text":"关系里我总是尽可能地对对方好，因为我知道这个人无论怎样无论何时也会分离，如果没有以后的话就干脆牢牢抓紧此刻我们彼此握紧的手好了。","url":"https://x.com/0TwT012/status/2074532466791166262"},{"author_id":"1917047326990094336","conversation_id":"2074528968959746358","created_at":"2026-07-07T16:20:23.000Z","edit_history_tweet_ids":["2074528968959746358"],"id":"2074528968959746358","lang":"zh","public_metrics":{"bookmark_count":5,"impression_count":18633,"like_count":308,"quote_count":6,"reply_count":32,"retweet_count":53},"text":"我竟然珍惜了一个轻视我的人","url":"https://x.com/0TwT012/status/2074528968959746358"},{"author_id":"1917047326990094336","conversation_id":"2074527649645703193","created_at":"2026-07-07T16:15:09.000Z","edit_history_tweet_ids":["2074527649645703193"],"id":"2074527649645703193","lang":"zh","public_metrics":{"bookmark_count":7,"impression_count":5795,"like_count":125,"quote_count":0,"reply_count":9,"retweet_count":14},"text":"和你的这段感情是我拔掉通往成年世界的最后一颗乳牙","url":"https://x.com/0TwT012/status/2074527649645703193"},{"author_id":"1917047326990094336","conversation_id":"2074522846853009566","created_at":"2026-07-07T15:56:04.000Z","edit_history_tweet_ids":["2074522846853009566"],"id":"2074522846853009566","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":2045,"like_count":26,"quote_count":0,"reply_count":7,"retweet_count":0},"text":"昨晚忽然想到，你不再是我的灵感缪斯了，我们间艺术的关系到此为止了。原先以为平静单纯的关系很稀薄，后来发现这种所谓艺术跟爱才是最最脆弱。方圆百里，或者几里，都没有关系。","url":"https://x.com/0TwT012/status/2074522846853009566"},{"author_id":"1917047326990094336","conversation_id":"2074522527037374847","created_at":"2026-07-07T15:54:47.000Z","edit_history_tweet_ids":["2074522527037374847"],"id":"2074522527037374847","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":3119,"like_count":38,"quote_count":0,"reply_count":7,"retweet_count":3},"text":"恨你，讨厌你，爱过你","url":"https://x.com/0TwT012/status/2074522527037374847"},{"author_id":"1917047326990094336","conversation_id":"2074522239345865118","created_at":"2026-07-07T15:53:39.000Z","edit_history_tweet_ids":["2074522239345865118"],"id":"2074522239345865118","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2477,"like_count":14,"quote_count":0,"reply_count":8,"retweet_count":0},"text":"我当时最想要的 和 真我想要的总是存在时间差","url":"https://x.com/0TwT012/status/2074522239345865118"},{"author_id":"1917047326990094336","conversation_id":"2074520484667142588","created_at":"2026-07-07T15:46:40.000Z","edit_history_tweet_ids":["2074520484667142588"],"id":"2074520484667142588","lang":"zh","public_metrics":{"bookmark_count":4,"impression_count":18559,"like_count":171,"quote_count":3,"reply_count":40,"retweet_count":16},"text":"我这辈子没聊过骚，说过最黄的话就是我想你了。","url":"https://x.com/0TwT012/status/2074520484667142588"},{"author_id":"1917047326990094336","conversation_id":"2074425003685404735","created_at":"2026-07-07T09:27:16.000Z","edit_history_tweet_ids":["2074425003685404735"],"id":"2074425003685404735","lang":"zh","public_metrics":{"bookmark_count":31,"impression_count":67107,"like_count":1744,"quote_count":11,"reply_count":63,"retweet_count":210},"text":"希望下辈子躲到避孕套里 不要被命运找到","url":"https://x.com/0TwT012/status/2074425003685404735"},{"author_id":"1917047326990094336","conversation_id":"2074424730741051746","created_at":"2026-07-07T09:26:11.000Z","edit_history_tweet_ids":["2074424730741051746"],"id":"2074424730741051746","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3052,"like_count":28,"quote_count":0,"reply_count":20,"retweet_count":0},"text":"我应该在二十岁退休，拿一个月几万的退休金安度青年","url":"https://x.com/0TwT012/status/2074424730741051746"},{"author_id":"1917047326990094336","conversation_id":"2074399058656178176","created_at":"2026-07-07T07:44:10.000Z","edit_history_tweet_ids":["2074399058656178176"],"id":"2074399058656178176","lang":"zh","public_metrics":{"bookmark_count":13,"impression_count":23515,"like_count":274,"quote_count":5,"reply_count":25,"retweet_count":49},"text":"是不是我们认识的太简单 暧昧的太简单 得到也很简单 所以舍弃对你来说也很简单？","url":"https://x.com/0TwT012/status/2074399058656178176"},{"author_id":"1917047326990094336","conversation_id":"2074398846978076852","created_at":"2026-07-07T07:43:20.000Z","edit_history_tweet_ids":["2074398846978076852"],"id":"2074398846978076852","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3911,"like_count":45,"quote_count":0,"reply_count":8,"retweet_count":1},"text":"最近朋友的感情一个两个都出问题我的建议是不和人建立亲密关系就不会出问题………","url":"https://x.com/0TwT012/status/2074398846978076852"},{"author_id":"1917047326990094336","conversation_id":"2074398011032301684","created_at":"2026-07-07T07:40:00.000Z","edit_history_tweet_ids":["2074398011032301684"],"id":"2074398011032301684","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2493,"like_count":31,"quote_count":0,"reply_count":6,"retweet_count":2},"text":"我不活了 来个奶子大的，把我闷死","url":"https://x.com/0TwT012/status/2074398011032301684"},{"author_id":"1917047326990094336","conversation_id":"2074326649924092340","created_at":"2026-07-07T02:56:27.000Z","edit_history_tweet_ids":["2074326649924092340"],"id":"2074326649924092340","lang":"zh","note_tweet":{"text":"后来去了许多寺庙。\n在低眉的菩萨前，那些珍藏的回忆同供香一起燃烧。一半变做烟尘往上飘，一半烧成灰烬向下落。\n我想了太多话，比思念更长，长过那年青灰色的雨季。可握笔时指尖总是颤抖，写着写着，又变回一句“岁岁平安”。\n你在时间洪流里的色彩太鲜明，像白雪和群山间飘动的经幡，所以才配得上如此空泛且平庸的祝福。\n盛起拥有的一切，又补足失去的一切。\n斗拱下黄铜的转经筒在渴望中长出痕迹，而我也曾在爱中被雕刻。纠缠不休的尘寰与缘分间，结局早已写定。若说贪恋，不过是曾经看进你深远的眼睛。"},"public_metrics":{"bookmark_count":2,"impression_count":2877,"like_count":38,"quote_count":0,"reply_count":6,"retweet_count":3},"text":"后来去了许多寺庙。\n在低眉的菩萨前，那些珍藏的回忆同供香一起燃烧。一半变做烟尘往上飘，一半烧成灰烬向下落。\n我想了太多话，比思念更长，长过那年青灰色的雨季。可握笔时指尖总是颤抖，写着写着，又变回一句“岁岁平安”。","url":"https://x.com/0TwT012/status/2074326649924092340"},{"author_id":"1917047326990094336","conversation_id":"2074168305569653113","created_at":"2026-07-06T16:27:14.000Z","edit_history_tweet_ids":["2074168305569653113"],"id":"2074168305569653113","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":3158,"like_count":23,"quote_count":0,"reply_count":5,"retweet_count":2},"text":"才发现自己根本没有那么坚强，但是我尝试着去坚强了。到现在流眼泪都可以不出声了，不知道是心里的麻木还是什么。。。","url":"https://x.com/0TwT012/status/2074168305569653113"},{"author_id":"1917047326990094336","conversation_id":"2074163803823223251","created_at":"2026-07-06T16:09:21.000Z","edit_history_tweet_ids":["2074163803823223251"],"id":"2074163803823223251","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":5106,"like_count":25,"quote_count":0,"reply_count":8,"retweet_count":2},"text":"我好想哭…我一直哭…","url":"https://x.com/0TwT012/status/2074163803823223251"},{"author_id":"1917047326990094336","conversation_id":"2074163737934897612","created_at":"2026-07-06T16:09:05.000Z","edit_history_tweet_ids":["2074163737934897612"],"id":"2074163737934897612","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3078,"like_count":66,"quote_count":0,"reply_count":6,"retweet_count":10},"text":"直到某天你的名字出现在我口中也显得陌生，我顿了顿，思绪好像回到很久以前，但是什么也看不清，就像没戴眼镜在烟雨中。我们之前有过关系么？好奇怪，怎么这么陌生","url":"https://x.com/0TwT012/status/2074163737934897612"},{"author_id":"1917047326990094336","conversation_id":"2074163352704786657","created_at":"2026-07-06T16:07:34.000Z","edit_history_tweet_ids":["2074163352704786657"],"id":"2074163352704786657","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2190,"like_count":34,"quote_count":0,"reply_count":2,"retweet_count":0},"text":"好奇怪，明明你走了已经有千千万日夜年月了，而我总会倏忽想起这些小事","url":"https://x.com/0TwT012/status/2074163352704786657"},{"author_id":"1917047326990094336","conversation_id":"2074041774952382571","created_at":"2026-07-06T08:04:27.000Z","edit_history_tweet_ids":["2074041774952382571"],"id":"2074041774952382571","lang":"zh","public_metrics":{"bookmark_count":6,"impression_count":6357,"like_count":164,"quote_count":5,"reply_count":8,"retweet_count":29},"text":"适当地痴迷一点东西是好事。这个世界是无聊和痛苦占据了大部分，但这些不足以支撑构建出我们的生活。要记住为一本书或者一个角色哭得稀里哗啦是什么感觉，演唱会彩带落到头发上是什么感觉，和美好的东西fall in love 是什么感觉，幸福飞溅得仿佛慢镜头是什么感觉。我就是为了记住这些时刻而存在的。","url":"https://x.com/0TwT012/status/2074041774952382571"},{"author_id":"1917047326990094336","conversation_id":"2073791847995158769","created_at":"2026-07-05T15:31:20.000Z","edit_history_tweet_ids":["2073791847995158769"],"id":"2073791847995158769","lang":"zh","public_metrics":{"bookmark_count":6,"impression_count":4376,"like_count":91,"quote_count":0,"reply_count":8,"retweet_count":14},"text":"之前我太容易相信别人了。我以为每个人都是好人，对任何人都不设防。直到吃了很多亏，被人当成大血包才反应过来，原来不是每个人都值得相信，防人之心不可无。从来就没有人告诉过我这些，家里人也不教，他们只会让我懂事守规矩，最后生活狠狠给我上了一课。我就这样一边受伤一边成长，在伤痛中前行","url":"https://x.com/0TwT012/status/2073791847995158769"},{"author_id":"1917047326990094336","conversation_id":"2073790883208847595","created_at":"2026-07-05T15:27:30.000Z","edit_history_tweet_ids":["2073790883208847595"],"id":"2073790883208847595","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2736,"like_count":16,"quote_count":0,"reply_count":4,"retweet_count":2},"text":"我不开心就会听歌，我听歌就会不开心。","url":"https://x.com/0TwT012/status/2073790883208847595"},{"author_id":"1917047326990094336","conversation_id":"2073784842710638807","created_at":"2026-07-05T15:03:30.000Z","edit_history_tweet_ids":["2073784842710638807"],"id":"2073784842710638807","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2631,"like_count":32,"quote_count":0,"reply_count":9,"retweet_count":5},"text":"偏偏错的都是自己选的","url":"https://x.com/0TwT012/status/2073784842710638807"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_image_url":"https://pbs.twimg.com/profile_images/1917047544313679872/akAJkXe1_normal.jpg","username":"0TwT012","verified":false}]},"meta":{"newest_id":"2074813629569065112","next_token":"b26v89c19zqg8o3jueth5hafyxl1d19bwmrwo7b4h0qd9","oldest_id":"2073784842710638807","result_count":25}}