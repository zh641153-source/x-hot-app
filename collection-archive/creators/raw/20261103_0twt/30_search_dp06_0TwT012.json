count":41,"quote_count":0,"reply_count":0,"retweet_count":9},"text":"https://t.co/MSt7F38G6m","url":"https://x.com/0TwT012/status/2107854504918208589"},{"author_id":"1917047326990094336","conversation_id":"2107734736517095800","created_at":"2026-10-07T07:28:15.000Z","edit_history_tweet_ids":["2107734736517095800"],"id":"2107734736517095800","lang":"zh","public_metrics":{"bookmark_count":13,"impression_count":9296,"like_count":343,"quote_count":0,"reply_count":36,"retweet_count":45},"text":"我的脆弱程度就是一旦遇到了一点挫折就想崩溃地埋在被窝里老吴老吴地惨叫","url":"https://x.com/0TwT012/status/2107734736517095800"},{"author_id":"1917047326990094336","conversation_id":"2107722936237084728","created_at":"2026-10-07T06:41:22.000Z","edit_history_tweet_ids":["2107722936237084728"],"id":"2107722936237084728","lang":"zh","public_metrics":{"bookmark_count":7,"impression_count":11588,"like_count":264,"quote_count":7,"reply_count":91,"retweet_count":31},"text":"我身上60%的性格是从以前认识的人身上学来的","url":"https://x.com/0TwT012/status/2107722936237084728"},{"author_id":"1917047326990094336","conversation_id":"2107702188374180209","created_at":"2026-10-07T05:18:55.000Z","edit_history_tweet_ids":["2107702188374180209"],"id":"2107702188374180209","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":1972,"like_count":15,"quote_count":0,"reply_count":36,"retweet_count":0},"text":"我讨厌ai，我现在做噩梦都是cut片做的ai剧情","url":"https://x.com/0TwT012/status/2107702188374180209"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_image_url":"https://pbs.twimg.com/profile_images/1917047544313679872/akAJkXe1_normal.jpg","username":"0TwT012","verified":false}]},"meta":{"newest_id":"2108919696217231448","next_token":"b26v89c19zqg8o3juziyqnxnkugtw7qosl8o2hc8k24ql","oldest_id":"2107702188374180209","result_count":25}}