{"data":[{"author_id":"1917047326990094336","conversation_id":"2099180557712462019","created_at":"2026-09-13T16:57:00.000Z","edit_history_tweet_ids":["2099180557712462019"],"id":"2099180557712462019","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":1943,"like_count":26,"quote_count":1,"reply_count":11,"retweet_count":1},"text":"和他聊天的时候一直很想哭，因为从我嘴里吐露的话语都是我青一块紫一块到今日仍旧没有好的伤","url":"https://x.com/0TwT012/status/2099180557712462019"},{"author_id":"1917047326990094336","conversation_id":"2099179598441509109","created_at":"2026-09-13T16:53:11.000Z","edit_history_tweet_ids":["2099179598441509109"],"id":"2099179598441509109","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":1873,"like_count":38,"quote_count":0,"reply_count":10,"retweet_count":2},"text":"分开明明是两个人造成的却说的好像我从来没有好过一样呢，把我塑造成一个坏人你会更好过吗，一定要这样再让我伤一次心吗","url":"https://x.com/0TwT012/status/2099179598441509109"},{"author_id":"1917047326990094336","conversation_id":"2099175320113070585","created_at":"2026-09-13T16:36:11.000Z","edit_history_tweet_ids":["2099175320113070585"],"id":"2099175320113070585","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":1939,"like_count":11,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"今天让我感到最惊讶的是聊很久的门哥突然来了一句，感觉你门槛定的有点低了","url":"https://x.com/0TwT012/status/2099175320113070585"},{"author_id":"1917047326990094336","conversation_id":"2099106114499747977","created_at":"2026-09-13T12:01:11.000Z","edit_history_tweet_ids":["2099106114499747977"],"id":"2099106114499747977","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3297,"like_count":51,"quote_count":0,"reply_count":15,"retweet_count":5},"text":"为啥活着这么贵，安乐死也贵","url":"https://x.com/0TwT012/status/2099106114499747977"},{"author_id":"1917047326990094336","conversation_id":"2099063469576479117","created_at":"2026-09-13T09:11:44.000Z","edit_history_tweet_ids":["2099063469576479117"],"id":"2099063469576479117","lang":"zh","public_metrics":{"bookmark_count":51,"imp