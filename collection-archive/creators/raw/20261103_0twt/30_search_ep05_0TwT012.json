{"data":[{"author_id":"1917047326990094336","conversation_id":"2096535623511527601","created_at":"2026-09-06T09:46:59.000Z","edit_history_tweet_ids":["2096535623511527601"],"id":"2096535623511527601","lang":"zh","public_metrics":{"bookmark_count":15,"impression_count":6221,"like_count":173,"quote_count":2,"reply_count":38,"retweet_count":28},"text":"幸福的时候会想起你，难过的时候也会想起你，你是我爱与恨的因果根溯，爱与恨永恒的载体","url":"https://x.com/0TwT012/status/2096535623511527601"},{"author_id":"1917047326990094336","conversation_id":"2096535104911016389","created_at":"2026-09-06T09:44:55.000Z","edit_history_tweet_ids":["2096535104911016389"],"id":"2096535104911016389","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2101,"like_count":16,"quote_count":0,"reply_count":2,"retweet_count":0},"text":"离了舞萌这个圈子再也没见过这么多傻逼的人，我今天到现在没发舞萌成绩图就是被前坑的傻逼恶心到了，这帮人真是粉随正主了比屎还黏牙，没事儿出来隔应我一下","url":"https://x.com/0TwT012/status/2096535104911016389"},{"author_id":"1917047326990094336","conversation_id":"2096274769410941175","created_at":"2026-09-05T16:30:26.000Z","edit_history_tweet_ids":["2096274769410941175"],"id":"2096274769410941175","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":4281,"like_count":43,"quote_count":0,"reply_count":43,"retweet_count":1},"text":"活在自己的信息茧房里好舒服…","url":"https://x.com/0TwT012/status/2096274769410941175"},{"author_id":"1917047326990094336","conversation_id":"2096239862622122382","created_at":"2026-09-05T14:11:44.000Z","edit_history_tweet_ids":["2096239862622122382"],"id":"2096239862622122382","lang":"zh","public_metrics":{"bookmark_count":57,"impression_count":34588,"like_count":1107,"quote_count":6,"reply_count":360,"retweet_count":205},"text":"你没有回复我的时候其实我在偷偷翻我们的聊天记录 你说的话都好可爱 我说的都好笨","url":"https://x.com/0TwT012/status/2096239862622122382"},{"author_id":"1917047326990094336","conversation_id":"2096238645992890834","created_at":"2026-09-05T14:06:54.000Z","edit_history_tweet_ids":["2096238645992890834"],"id":"2096238645992890834","lang":"zh","public_metrics":{"bookmark_count":4,"impression_count":3198,"like_count":60,"quote_count":0,"reply_count":0,"retweet_count":12},"text":"我的热情，耐心，好脾气，好语气，好态度，好脸色都是不可再生资源啊","url":"https://x.com/0TwT012/status/2096238645992890834"},{"author_id":"1917047326990094336","conversation_id":"2096237937314984103","created_at":"2026-09-05T14:04:05.000Z","edit_history_tweet_ids":["2096237937314984103"],"id":"2096237937314984103","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":2143,"like_count":17,"quote_count":0,"reply_count":4,"retweet_count":0},"text":"我得找个办法再次爱上自己","url":"https://x.com/0TwT012/status/2096237937314984103"},{"author_id":"1917047326990094336","conversation_id":"2096224438383677927","created_at":"2026-09-05T13:10:26.000Z","edit_history_tweet_ids":["2096224438383677927"],"id":"2096224438383677927","lang":"zh","public_metrics":{"bookmark_count":5,"impression_count":14803,"like_count":279,"quote_count":4,"reply_count":23,"retweet_count":42},"text":"对你好99次，就那一次没如你的愿，我在你心里就成婊子了","url":"https://x.com/0TwT012/status/2096224438383677927"},{"author_id":"1917047326990094336","conversation_id":"2096224304866513227","created_at":"2026-09-05T13:09:54.000Z","edit_history_tweet_ids":["2096224304866513227"],"id":"2096224304866513227","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":7171,"like_count":185,"quote_count":1,"reply_count":61,"retweet_count":35},"text":"谁爱我 亲我 拥抱我 看我 听我 理解我 触摸我 保存我 保存我 保存我 懂得我 保存我的幻想 保存我的发现 保存我的时代","url":"https://x.com/0TwT012/status/2096224304866513227"},{"author_id":"1917047326990094336","conversation_id":"2095726093017981360","created_at":"2026-09-04T04:10:11.000Z","edit_history_tweet_ids":["2095726093017981360"],"id":"2095726093017981360","lang":"zh","public_metrics":{"bookmark_count":32,"impression_count":57994,"like_count":1090,"quote_count":12,"reply_count":256,"retweet_count":55},"text":"其实我觉得拧巴的人需要恐吓型恋人。因为人在害怕的时候什么都会说出来的。","url":"https://x.com/0TwT012/status/2095726093017981360"},{"author_id":"1917047326990094336","conversation_id":"2095690614541283664","created_at":"2026-09-04T01:49:13.000Z","edit_history_tweet_ids":["2095690614541283664"],"id":"2095690614541283664","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3337,"like_count":37,"quote_count":0,"reply_count":73,"retweet_count":1},"text":"其实大部分私信只要不是不礼貌的我基本都会回的，欢迎找我玩呀…","url":"https://x.com/0TwT012/status/2095690614541283664"},{"author_id":"1917047326990094336","conversation_id":"2095690068451311799","created_at":"2026-09-04T01:47:03.000Z","edit_history_tweet_ids":["2095690068451311799"],"id":"2095690068451311799","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2027,"like_count":11,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"每次有人在我评论区底下吵架都吓我一哆嗦，还以为又惹到谁了","url":"https://x.com/0TwT012/status/2095690068451311799"},{"author_id":"1917047326990094336","conversation_id":"2095689825764700625","created_at":"2026-09-04T01:46:05.000Z","edit_history_tweet_ids":["2095689825764700625"],"id":"2095689825764700625","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3867,"like_count":44,"quote_count":0,"reply_count":17,"retweet_count":5},"text":"终其一生只是为了找到和我对得上脑电波频率的外星人","url":"https://x.com/0TwT012/status/2095689825764700625"},{"author_id":"1917047326990094336","conversation_id":"2095602886415949835","created_at":"2026-09-03T20:00:37.000Z","edit_history_tweet_ids":["2095602886415949835"],"id":"2095602886415949835","lang":"zh","public_metrics":{"bookmark_count":50,"impression_count":39189,"like_count":901,"quote_count":14,"reply_count":150,"retweet_count":182},"text":"过程已经是奖励了 我们本来毫无交集的","url":"https://x.com/0TwT012/status/2095602886415949835"},{"author_id":"1917047326990094336","conversation_id":"2095585365583450453","created_at":"2026-09-03T18:50:59.000Z","edit_history_tweet_ids":["2095585365583450453"],"id":"2095585365583450453","lang":"ja","public_metrics":{"bookmark_count":1,"impression_count":7546,"like_count":26,"quote_count":0,"reply_count":28,"retweet_count":1},"text":"唉 https://t.co/HbzpN1pHid","url":"https://x.com/0TwT012/status/2095585365583450453"},{"author_id":"1917047326990094336","conversation_id":"2095585156837093425","created_at":"2026-09-03T18:50:10.000Z","edit_history_tweet_ids":["2095585156837093425"],"id":"2095585156837093425","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":1872,"like_count":10,"quote_count":0,"reply_count":6,"retweet_count":1},"text":"本来因为打着不留遗憾的幌子互相接触就没有好下场，一样的剧情只是顺着很久之前就敲定的剧本重演了一遍现在连结局都没有变得更好。","url":"https://x.com/0TwT012/status/2095585156837093425"},{"author_id":"1917047326990094336","conversation_id":"2095583257433948212","created_at":"2026-09-03T18:42:37.000Z","edit_history_tweet_ids":["2095583257433948212"],"id":"2095583257433948212","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2084,"like_count":11,"quote_count":0,"reply_count":2,"retweet_count":2},"text":"前夫文学很好代但是一想到是真实事件改编就笑不出来了","url":"https://x.com/0TwT012/status/2095583257433948212"},{"author_id":"1917047326990094336","conversation_id":"2095582609254555941","created_at":"2026-09-03T18:40:02.000Z","edit_history_tweet_ids":["2095582609254555941"],"id":"2095582609254555941","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":1502,"like_count":12,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"老天爷让我一直幸福好不好","url":"https://x.com/0TwT012/status/2095582609254555941"},{"author_id":"1917047326990094336","conversation_id":"2095581864660803955","created_at":"2026-09-03T18:37:05.000Z","edit_history_tweet_ids":["2095581864660803955"],"id":"2095581864660803955","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":1930,"like_count":17,"quote_count":1,"reply_count":0,"retweet_count":1},"text":"我们的明天好远但是我还是想跟你明天见","url":"https://x.com/0TwT012/status/2095581864660803955"},{"author_id":"1917047326990094336","conversation_id":"2095580666130051539","created_at":"2026-09-03T18:32:19.000Z","edit_history_tweet_ids":["2095580666130051539"],"id":"2095580666130051539","lang":"zh","public_metrics":{"bookmark_count":16,"impression_count":7204,"like_count":208,"quote_count":1,"reply_count":1,"retweet_count":43},"text":"我其实很想吐，好想把那些不明所以的情绪吐出来。它们总在我的胃里翻滚、下坠，恶心感让眼睛发酸，于是情绪从眼睛里吐了出来","url":"https://x.com/0TwT012/status/2095580666130051539"},{"author_id":"1917047326990094336","conversation_id":"2095572195913437278","created_at":"2026-09-03T17:58:40.000Z","edit_history_tweet_ids":["2095572195913437278"],"id":"2095572195913437278","lang":"zh","note_tweet":{"text":"上学是离奇枯燥乏味的生活，之前对此时的我是这样的，每天日复一日的起床、上学、下学、睡觉，重复百遍千遍万遍，直至成为肌肉记忆在某次空闲的假期依旧呆滞的进行程序，又恍惚意识到自己已经从第一场轮回中解脱。\n然后进入下一场，成为地铁月台每日朝\n九晚五上班族的一员。\n人生是一场有尽头的轮回。\n其实我总是不懂人生的意义是什么，对我来说现在和未来并没有什么不同，努力与不努力最终也不会有什么好结果。活着最重要的东西是钱，但我真的能在未来挣到钱吗？这个世界是一场噩梦，每个人背后被无数双手推搡向前，那些手无视地上的碎石坑洼，他们只让你向前走，只允许你向前走。\n我一点也不喜欢这个世界。"},"public_metrics":{"bookmark_count":2,"impression_count":1306,"like_count":9,"quote_count":0,"reply_count":0,"retweet_count":1},"text":"上学是离奇枯燥乏味的生活，之前对此时的我是这样的，每天日复一日的起床、上学、下学、睡觉，重复百遍千遍万遍，直至成为肌肉记忆在某次空闲的假期依旧呆滞的进行程序，又恍惚意识到自己已经从第一场轮回中解脱。\n然后进入下一场，成为地铁月台每日朝\n九晚五上班族的一员。\n人生是一场有尽头的轮回。","url":"https://x.com/0TwT012/status/2095572195913437278"},{"author_id":"1917047326990094336","conversation_id":"2095571921412960372","created_at":"2026-09-03T17:57:34.000Z","edit_history_tweet_ids":["2095571921412960372"],"id":"2095571921412960372","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":1630,"like_count":17,"quote_count":0,"reply_count":0,"retweet_count":1},"text":"站在已完全变得陌生的故土上，过去的记忆被新的故事覆盖，旧事难言新事难圆，被命运裏挟着奔向未知地。我想，旧日的我真的死去了，被新世界杀死了。","url":"https://x.com/0TwT012/status/2095571921412960372"},{"author_id":"1917047326990094336","conversation_id":"2095569341693784287","created_at":"2026-09-03T17:47:19.000Z","edit_history_tweet_ids":["2095569341693784287"],"id":"2095569341693784287","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":2730,"like_count":24,"quote_count":1,"reply_count":14,"retweet_count":3},"text":"我终于知道我的被子为什么会发霉了，我每天都窝在被子里偷偷哭。","url":"https://x.com/0TwT012/status/2095569341693784287"},{"author_id":"1917047326990094336","conversation_id":"2095569222147686588","created_at":"2026-09-03T17:46:51.000Z","edit_history_tweet_ids":["2095569222147686588"],"id":"2095569222147686588","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2500,"like_count":31,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"我讨厌你在我快要忘记你的时候又突然回来跟我说让我看看月亮 https://t.co/5qQ4AgZV9m","url":"https://x.com/0TwT012/status/2095569222147686588"},{"author_id":"1917047326990094336","conversation_id":"2095414213422481775","created_at":"2026-09-03T07:30:54.000Z","edit_history_tweet_ids":["2095414213422481775"],"id":"2095414213422481775","lang":"zh","public_metrics":{"bookmark_count":9,"impression_count":12962,"like_count":176,"quote_count":5,"reply_count":50,"retweet_count":9},"text":"如果你想体验什么是执着的爱，去谈年纪小的土象，会让你体会到什么是不可撼动的爱，死心塌地的爱，非你不可的爱，极致的偏爱，你没听错这就是年纪小的土象能给出的爱。老的土象只爱自己。","url":"https://x.com/0TwT012/status/2095414213422481775"},{"author_id":"1917047326990094336","conversation_id":"2095393252035981324","created_at":"2026-09-03T06:07:36.000Z","edit_history_tweet_ids":["2095393252035981324"],"id":"2095393252035981324","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":1490,"like_count":12,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"讨厌暧昧不清的关系","url":"https://x.com/0TwT012/status/2095393252035981324"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_image_url":"https://pbs.twimg.com/profile_images/1917047544313679872/akAJkXe1_normal.jpg","username":"0TwT012","verified":false}]},"meta":{"newest_id":"2096535623511527601","next_token":"b26v89c19zqg8o3juezhjc2430vobrzaxyat7djhyrdkt","oldest_id":"2095393252035981324","result_count":25}}