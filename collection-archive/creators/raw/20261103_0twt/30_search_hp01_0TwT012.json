{"data":[{"author_id":"1917047326990094336","created_at":"2026-05-24T18:10:30.000Z","edit_history_tweet_ids":["2058611614283399516"],"id":"2058611614283399516","public_metrics":{"bookmark_count":11,"impression_count":11084,"like_count":290,"quote_count":1,"reply_count":61,"retweet_count":46},"text":"人和人相处不就是想要那份特殊吗，对谁都很好却没有对我最好就不要和我有关系了","url":"https://x.com/0TwT012/status/2058611614283399516"},{"author_id":"1917047326990094336","created_at":"2026-05-24T18:09:35.000Z","edit_history_tweet_ids":["2058611383730909255"],"id":"2058611383730909255","public_metrics":{"bookmark_count":1,"impression_count":2318,"like_count":32,"quote_count":0,"reply_count":2,"retweet_count":3},"text":"当我会慢慢提出需求了才发现之前过得好憋屈","url":"https://x.com/0TwT012/status/2058611383730909255"},{"author_id":"1917047326990094336","created_at":"2026-05-24T18:03:19.000Z","edit_history_tweet_ids":["2058609807075197167"],"id":"2058609807075197167","public_metrics":{"bookmark_count":0,"impression_count":3229,"like_count":13,"quote_count":0,"reply_count":38,"retweet_count":0},"text":"我不知道这个机况是怎么了。 https://t.co/7GVkVSdUQS","url":"https://x.com/0TwT012/status/2058609807075197167"},{"author_id":"1917047326990094336","created_at":"2026-05-24T17:59:55.000Z","edit_history_tweet_ids":["2058608951667904512"],"id":"2058608951667904512","public_metrics":{"bookmark_count":21,"impression_count":26244,"like_count":582,"quote_count":8,"reply_count":132,"retweet_count":68},"text":"迄今为止我发展人际关系的方式完全就是\n靠运气遇见善良的人","url":"https://x.com/0TwT012/status/2058608951667904512"},{"author_id":"1917047326990094336","created_at":"2026-05-24T17:52:39.000Z","edit_history_tweet_ids":["2058607122796208355"],"id":"2058607122796208355","public_metrics":{"bookmark_count":1,"impression_count":4759,"like_count":54,"quote_count":0,"reply_count":5,"retweet_count":0},"text":"翻私信很想哭 https://t.co/iMaAfAXHz1","url":"https://x.com/0TwT012/status/2058607122796208355"},{"author_id":"1917047326990094336","created_at":"2026-05-24T17:51:21.000Z","edit_history_tweet_ids":["2058606794692546615"],"id":"2058606794692546615","public_metrics":{"bookmark_count":2,"impression_count":2470,"like_count":15,"quote_count":0,"reply_count":3,"retweet_count":1},"text":"好痛苦一直有声音让我去死","url":"https://x.com/0TwT012/status/2058606794692546615"},{"author_id":"1917047326990094336","created_at":"2026-05-24T17:50:54.000Z","edit_history_tweet_ids":["2058606679156257054"],"id":"2058606679156257054","public_metrics":{"bookmark_count":1,"impression_count":1436,"like_count":13,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"每次都忙飞了还是必须抽一段时间用来洗头洗澡的时候就觉得卧槽当人类怎么这么麻烦啊","url":"https://x.com/0TwT012/status/2058606679156257054"},{"author_id":"1917047326990094336","created_at":"2026-05-24T05:30:46.000Z","edit_history_tweet_ids":["2058420418818810232"],"id":"2058420418818810232","public_metrics":{"bookmark_count":20,"impression_count":24942,"like_count":425,"quote_count":3,"reply_count":39,"retweet_count":42},"text":"我们保持现在这种随时可以离开对方的关系就行了，知道吗？","url":"https://x.com/0TwT012/status/2058420418818810232"},{"author_id":"1917047326990094336","created_at":"2026-05-23T21:08:24.000Z","edit_history_tweet_ids":["2058293996968149144"],"id":"2058293996968149144","public_metrics":{"bookmark_count":2,"impression_count":5932,"like_count":90,"quote_count":0,"reply_count":9,"retweet_count":5},"text":"有时候觉得人生很难的原因是没有任何人给我指导，没有任何资源。人生道路全靠自己摸爬滚打，家里的老辈子只会说风凉话、抱怨和添堵...踩过很多坑，流过很多泪，依旧还在摸索中，依旧不知道下一步该怎么走，但我也只能摸索着前进，自我探索，一边哭一边走下去吧","url":"https://x.com/0TwT012/status/2058293996968149144"},{"author_id":"1917047326990094336","created_at":"2026-05-23T21:05:25.000Z","edit_history_tweet_ids":["2058293246397489468"],"id":"2058293246397489468","public_metrics":{"bookmark_count":9,"impression_count":7198,"like_count":160,"quote_count":0,"reply_count":1,"retweet_count":26},"text":"如果你对某一件事的结束感到悲伤 那就说明 这件事的过程一定很美好","url":"https://x.com/0TwT012/status/2058293246397489468"},{"author_id":"1917047326990094336","created_at":"2026-05-22T20:08:47.000Z","edit_history_tweet_ids":["2057916605867475291"],"id":"2057916605867475291","public_metrics":{"bookmark_count":2,"impression_count":5357,"like_count":73,"quote_count":0,"reply_count":31,"retweet_count":0},"text":"我刚在咖啡馆看到一个人哭了五六分钟 直到他的手机闹铃响了 突然他就不哭了 然后就回去工作了 恍惚初醒 欢迎来到成年人的世界","url":"https://x.com/0TwT012/status/2057916605867475291"},{"author_id":"1917047326990094336","created_at":"2026-05-22T09:00:27.000Z","edit_history_tweet_ids":["2057748413006201273"],"id":"2057748413006201273","public_metrics":{"bookmark_count":5,"impression_count":5844,"like_count":143,"quote_count":2,"reply_count":22,"retweet_count":25},"text":"很多时候我无论做什么事情都会想到你，仿佛哪里都有你的影子，好像你也是触手可及的一样。那你呢，也会想起我吗？","url":"https://x.com/0TwT012/status/2057748413006201273"},{"author_id":"1917047326990094336","created_at":"2026-05-22T07:02:35.000Z","edit_history_tweet_ids":["2057718752737886381"],"id":"2057718752737886381","public_metrics":{"bookmark_count":5,"impression_count":7314,"like_count":258,"quote_count":1,"reply_count":54,"retweet_count":2},"text":"亲戚：早都像你这么想，人类不灭绝了吗？\n我：反正恐龙灭绝不是因为恐龙不生孩子","url":"https://x.com/0TwT012/status/2057718752737886381"},{"author_id":"1917047326990094336","created_at":"2026-05-22T06:24:29.000Z","edit_history_tweet_ids":["2057709164647022798"],"id":"2057709164647022798","public_metrics":{"bookmark_count":1,"impression_count":31247,"like_count":837,"quote_count":1,"reply_count":135,"retweet_count":10},"text":"超过9.9价格的奶茶咖啡全下架掉吧","url":"https://x.com/0TwT012/status/2057709164647022798"},{"author_id":"1917047326990094336","created_at":"2026-05-22T05:52:59.000Z","edit_history_tweet_ids":["2057701236045156634"],"id":"2057701236045156634","public_metrics":{"bookmark_count":1,"impression_count":3367,"like_count":55,"quote_count":0,"reply_count":3,"retweet_count":6},"text":"我的一生已经过去了四分之一，如果这已经是我人生最轻松幸福的时光，那也太痛苦了","url":"https://x.com/0TwT012/status/2057701236045156634"},{"author_id":"1917047326990094336","created_at":"2026-05-21T19:57:36.000Z","edit_history_tweet_ids":["2057551403678388371"],"id":"2057551403678388371","public_metrics":{"bookmark_count":6,"impression_count":6813,"like_count":110,"quote_count":0,"reply_count":8,"retweet_count":16},"text":"你从来不会把垃圾袋系成蝴蝶结。因为你知道扔的时候不用解开， “过去”也应该是这样","url":"https://x.com/0TwT012/status/2057551403678388371"},{"author_id":"1917047326990094336","created_at":"2026-05-21T19:53:43.000Z","edit_history_tweet_ids":["2057550424094515525"],"id":"2057550424094515525","public_metrics":{"bookmark_count":6,"impression_count":3493,"like_count":53,"quote_count":1,"reply_count":8,"retweet_count":10},"text":"本意不想写不断呻吟痛苦的文字  可是只有精神痛苦喋喋不休才会让我想在深夜写大片大片的矫情文字来稀释它\n幸福的时候根本不想写字 只想沉溺感受","url":"https://x.com/0TwT012/status/2057550424094515525"},{"author_id":"1917047326990094336","created_at":"2026-05-21T02:40:32.000Z","edit_history_tweet_ids":["2057290414382886998"],"id":"2057290414382886998","public_metrics":{"bookmark_count":10,"impression_count":8845,"like_count":144,"quote_count":3,"reply_count":9,"retweet_count":28},"text":"如果我会跟你说一些关于我过去的事，那并不是因为想让你为我感到难过，安慰我或是告诉我，该怎样让我走出来或是清醒，我说那些，只是想让你理解，为什么我是这样的我","url":"https://x.com/0TwT012/status/2057290414382886998"},{"author_id":"1917047326990094336","created_at":"2026-05-20T16:59:50.000Z","edit_history_tweet_ids":["2057144279143968978"],"id":"2057144279143968978","public_metrics":{"bookmark_count":4,"impression_count":5148,"like_count":98,"quote_count":0,"reply_count":17,"retweet_count":15},"text":"想死，每天都想死，每天都庆幸自己没死。幸好当时没跳下去，幸好割的不深，幸好没有多吞一片，幸好还活着。神经一样的人生，我还要活下去。\n这个世界真的很操蛋，虽然我没蛋。我这是在无病呻吟吗，不是，我有病，而且没呻吟纯粗口。","url":"https://x.com/0TwT012/status/2057144279143968978"},{"author_id":"1917047326990094336","created_at":"2026-05-20T16:56:05.000Z","edit_history_tweet_ids":["2057143336285438037"],"id":"2057143336285438037","public_metrics":{"bookmark_count":1,"impression_count":2316,"like_count":23,"quote_count":0,"reply_count":35,"retweet_count":0},"text":"开始失眠\n最近又开始想到死，感觉又开始躯体化了\n我知道自己的状态不对，我走了好远，去看其他风景，可我依旧没得到救赎。\n想说点原生家庭的痛，算了有点恶心，还是咽回去。","url":"https://x.com/0TwT012/status/2057143336285438037"},{"author_id":"1917047326990094336","created_at":"2026-05-20T13:58:02.000Z","edit_history_tweet_ids":["2057098525402632292"],"id":"2057098525402632292","public_metrics":{"bookmark_count":0,"impression_count":2569,"like_count":39,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"我没有允许你越过我们之间的回忆去怀念再之前的那个她","url":"https://x.com/0TwT012/status/2057098525402632292"},{"author_id":"1917047326990094336","created_at":"2026-05-20T13:54:49.000Z","edit_history_tweet_ids":["2057097716824678726"],"id":"2057097716824678726","public_metrics":{"bookmark_count":1,"impression_count":6064,"like_count":53,"quote_count":1,"reply_count":23,"retweet_count":1},"text":"看不懂你们一帮哭穷的到底是啥意思收了52万的转账还非得手贱复制粘贴发那个臭文案，我520毛都没收到还给🚪哥倒贴200","url":"https://x.com/0TwT012/status/2057097716824678726"},{"author_id":"1917047326990094336","created_at":"2026-05-20T06:07:29.000Z","edit_history_tweet_ids":["2056980109555605975"],"id":"2056980109555605975","public_metrics":{"bookmark_count":2,"impression_count":2703,"like_count":44,"quote_count":0,"reply_count":9,"retweet_count":4},"text":"我不能一直困在过去，既然改变不了已经发生的事，就要向前看，我知道，我知道，但是还是会被情绪反扑……","url":"https://x.com/0TwT012/status/2056980109555605975"},{"author_id":"1917047326990094336","created_at":"2026-05-20T06:06:34.000Z","edit_history_tweet_ids":["2056979879930081505"],"id":"2056979879930081505","public_metrics":{"bookmark_count":13,"impression_count":5617,"like_count":126,"quote_count":1,"reply_count":26,"retweet_count":14},"text":"我单单望向你的时候， 突然好想一辈子在你身边待着。\n仅仅只是待在你的身边 ，哪怕不说话 ，太久了 ，久到我这一生可能都不会再有那样纯粹的感情。","url":"https://x.com/0TwT012/status/2056979879930081505"},{"author_id":"1917047326990094336","created_at":"2026-05-19T17:26:36.000Z","edit_history_tweet_ids":["2056788626282029405"],"id":"2056788626282029405","public_metrics":{"bookmark_count":5,"impression_count":11273,"like_count":136,"quote_count":0,"reply_count":10,"retweet_count":19},"text":"你哭了。别再说那些理性的话了","url":"https://x.com/0TwT012/status/2056788626282029405"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_ima