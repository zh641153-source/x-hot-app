T012/status/2055369517619142846"},{"author_id":"1917047326990094336","conversation_id":"2055358758927376560","created_at":"2026-05-15T18:44:49.000Z","edit_history_tweet_ids":["2055358758927376560"],"id":"2055358758927376560","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":7782,"like_count":93,"quote_count":0,"reply_count":10,"retweet_count":5},"text":"因为生活把我逼太紧所以我的逼很紧","url":"https://x.com/0TwT012/status/2055358758927376560"},{"author_id":"1917047326990094336","conversation_id":"2055346272786354514","created_at":"2026-05-15T17:55:12.000Z","edit_history_tweet_ids":["2055346272786354514"],"id":"2055346272786354514","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":1748,"like_count":13,"quote_count":0,"reply_count":0,"retweet_count":1},"text":"一想到午夜场不止我一个人在说梦话就释然了","url":"https://x.com/0TwT012/status/2055346272786354514"},{"author_id":"1917047326990094336","conversation_id":"2055340433044394107","created_at":"2026-05-15T17:32:00.000Z","edit_history_tweet_ids":["2055340433044394107"],"id":"2055340433044394107","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":5552,"like_count":35,"quote_count":0,"reply_count":47,"retweet_count":0},"text":"实不相瞒我感觉现在很多地雷系其实大多数是葬爱家族天爆系","url":"https://x.com/0TwT012/status/2055340433044394107"},{"author_id":"1917047326990094336","conversation_id":"2055290430372327521","created_at":"2026-05-15T14:13:18.000Z","edit_history_tweet_ids":["2055290430372327521"],"id":"2055290430372327521","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":21745,"like_count":37,"quote_count":0,"reply_count":109,"retweet_count":0},"text":"这段时间我明显感觉到评论区的bot升级变异了","url":"https://x.com/0TwT012/status/2055290430372327521"},{"author_id":"1917047326990094336","conversation_id":"2055209693459738759","created_at":"2026-05-15T08:52:29.000Z","edit_history_tweet_ids":["2055209693459738759"],"id":"2055209693459738759","lang":"zxx","public_metrics":{"bookmark_count":0,"impression_count":3988,"like_count":28