":"2026-05-14T20:48:16.000Z","edit_history_tweet_ids":["2055027438061814103"],"id":"2055027438061814103","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3948,"like_count":50,"quote_count":0,"reply_count":22,"retweet_count":3},"text":"身材焦虑容貌焦虑接踵而至的是年龄焦虑","url":"https://x.com/0TwT012/status/2055027438061814103"},{"author_id":"1917047326990094336","conversation_id":"2054971603352715472","created_at":"2026-05-14T17:06:24.000Z","edit_history_tweet_ids":["2054971603352715472"],"id":"2054971603352715472","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":7068,"like_count":82,"quote_count":1,"reply_count":12,"retweet_count":4},"text":"想知道关于那个温暖散发着善意但精神状态比谁都差的恋人……","url":"https://x.com/0TwT012/status/2054971603352715472"},{"author_id":"1917047326990094336","conversation_id":"2054971407050866915","created_at":"2026-05-14T17:05:37.000Z","edit_history_tweet_ids":["2054971407050866915"],"id":"2054971407050866915","lang":"zh","public_metrics":{"bookmark_count":38,"impression_count":15716,"like_count":399,"quote_count":1,"reply_count":23,"retweet_count":42},"text":"那又怎样。我只是很纯粹地喜欢你。第一直觉你并不在我的择偶标准内，但我喜欢。我就想纯粹地喜欢你，以验证我还有重新爱上别人的能力，我看我投射在你身上的样子，明白我的优势，我的缺失。你人本身是好的，但我们大概走不到最后。我是喜欢你的，能不能就让我好好地喜欢你一下，不要问那么多。抓住当下","url":"https://x.com/0TwT012/status/2054971407050866915"},{"author_id":"1917047326990094336","conversation_id":"2054968438930731153","created_at":"2026-05-14T16:53:49.000Z","edit_history_tweet_ids":["2054968438930731153"],"id":"2054968438930731153","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":4724,"like_count":87,"quote_count":1,"reply_count":5,"retweet_count":9},"text":"可是你的出现 真的让那个时常不开心的我 偷偷开心了好久","url":"https://x.com/0TwT012/status/2054968438930731153"},{"author_id":"1917047326990094336","conversation_id":"2054968243941675063","created_at":"2026-05-14T16:53:03.000Z","edit_history_tweet_ids":["2054968243941675063"],"id":"2054968243941675063","lang":"zh","public_metrics":{"bookmark_count":17,"impression_count":39454,"like_count":548,"quote_count":14,"reply_count":111,"retweet_count":105},"text":"每一个说我可爱要对我好的人最后都会对我进行一个惨绝人寰的弃养","url":"https://x.com/0TwT012/status/2054968243941675063"},{"author_id":"1917047326990094336","conversation_id":"2054961971985109151","created_at":"2026-05-14T16:28:08.000Z","edit_history_tweet_ids":["2054961971985109151"],"id":"2054961971985109151","lang":"zh","public_metrics":{"bookmark_count":16,"impression_count":46464,"like_count":956,"quote_count":9,"reply_count":32,"retweet_count":166},"text":"我的夜生活丰富程度取决于今晚炫压抑和玉玉症哪个更占上风","url":"https://x.com/0TwT012/status/2054961971985109151"},{"author_id":"1917047326990094336","conversation_id":"2054924354115477690","created_at":"2026-05-14T13:58:39.000Z","edit_history_tweet_ids":["2054924354115477690"],"id":"2054924354115477690","lang":"zh","public_metrics":{"bookmark_count":59,"impression_count":43310,"like_count":869,"quote_count":8,"reply_count":77,"retweet_count":70},"text":"如果一个人不能活出攻击性，就会出现心理问题。","url":"https://x.com/0TwT012/status/2054924354115477690"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_image_url":"https://pbs.twimg.com/profile_images/1917047544313679872/akAJkXe1_normal.jpg","username":"0TwT012","verified":false}]},"meta":{"newest_id":"2055701841732837672","next_token":"b26v89c19zqg8o3jueni0z1nbmitnp1kjjm19er49glfh","oldest_id":"2054924354115477690","result_count":25}}