t":14523,"like_count":46,"quote_count":0,"reply_count":80,"retweet_count":1},"text":"你为什么会是这样的呢，我想不明白 https://t.co/Kf049v0y87","url":"https://x.com/0TwT012/status/2053508719418454163"},{"author_id":"1917047326990094336","conversation_id":"2053508476765409759","created_at":"2026-05-10T16:12:27.000Z","edit_history_tweet_ids":["2053508476765409759"],"id":"2053508476765409759","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":4882,"like_count":44,"quote_count":0,"reply_count":25,"retweet_count":3},"text":"我的人生由很多个让人一听就死掉的故事构成","url":"https://x.com/0TwT012/status/2053508476765409759"},{"author_id":"1917047326990094336","conversation_id":"2053480935824515294","created_at":"2026-05-10T14:23:01.000Z","edit_history_tweet_ids":["2053480935824515294"],"id":"2053480935824515294","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":7554,"like_count":39,"quote_count":0,"reply_count":37,"retweet_count":0},"text":"死之前想把这个号出手卖掉了","url":"https://x.com/0TwT012/status/2053480935824515294"},{"author_id":"1917047326990094336","conversation_id":"2053480589802819705","created_at":"2026-05-10T14:21:39.000Z","edit_history_tweet_ids":["2053480589802819705"],"id":"2053480589802819705","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3997,"like_count":14,"quote_count":0,"reply_count":25,"retweet_count":0},"text":"早知道当初选化学了，死的还明白点","url":"https://x.com/0TwT012/status/2053480589802819705"},{"author_id":"1917047326990094336","conversation_id":"2053477534101360646","created_at":"2026-05-10T14:09:30.000Z","edit_history_tweet_ids":["2053477534101360646"],"id":"2053477534101360646","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":20086,"like_count":68,"quote_count":1,"reply_count":54,"retweet_count":0},"text":"可乐加农药喝下去是可乐味重还是农药味重？","url":"https://x.com/0TwT012/status/2053477534101360646"},{"author_id":"1917047326990094336","conversation_id":"2053471867496022077","created_at":"2026-05-10T13:46:59.000Z","edit_history_tweet_ids":["2053471867496022077"],"id":"2053471867496022077","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2980,"like_count":8,"quote_count":0,"reply_count":10,"retweet_count":0},"text":"给自己穷笑了","url":"https://x.com/0TwT012/status/2053471867496022077"},{"author_id":"1917047326990094336","conversation_id":"2053471679696035876","created_at":"2026-05-10T13:46:14.000Z","edit_history_tweet_ids":["2053471679696035876"],"id":"2053471679696035876","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":4054,"like_count":44,"quote_count":0,"reply_count":6,"retweet_count":4},"text":"本人的情商不高不低正好卡在说出口后立马发现自己说错了话的程度。","url":"https://x.com/0TwT012/status/2053471679696035876"},{"author_id":"1917047326990094336","conversation_id":"2053470855645266356","created_at":"2026-05-10T13:42:58.000Z","edit_history_tweet_ids":["2053470855645266356"],"id":"2053470855645266356","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3245,"like_count":20,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"每次心悸的时候心脏跳的很剧烈很难受想让别人感受一下，结果他用手摸了好一会说我胸太大了他感受不到我的心跳","url":"https://x.com/0TwT012/status/2053470855645266356"},{"author_id":"1917047326990094336","conversation_id":"2053470495568437733","created_at":"2026-05-10T13:41:32.000Z","edit_history_tweet_ids":["2053470495568437733"],"id":"2053470495568437733","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":4302,"like_count":37,"quote_count":0,"reply_count":20,"retweet_count":3},"text":"每次感到痛苦的时候，没有拥下泪水，只是用掌心感知比平时跳动更快的心脏。\n闷慌噬掉余下的、微不可足的所有未知情绪。\n人类，应予自己多高的勇气疗愈痛苦致成的伤裂，再退下伤裂而留的结痂。\n痛苦，缓慢的，长痛的，哽咽下腹。","url":"https://x.com/0TwT012/status/2053470495568437733"},{"author_id":"1917047326990094336","conversation_id":"2053470152830955786","created_at":"2026-05-10T13:40:10.000Z","edit_history_tweet_ids":["2053470152830955786"],"id":"2053470152830955786","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2070,"like_count":12,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"我脑壳痛得像一条菜市场里被榔头砸脑袋的鱼，太痛了，又晕又想吐","url":"https://x.com/0TwT012/status/2053470152830955786"},{"author_id":"1917047326990094336","conversation_id":"2053227469801726071","created_at":"2026-05-09T21:35:50.000Z","edit_history_tweet_ids":["2053227469801726071"],"id":"2053227469801726071","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":8358,"like_count":105,"quote_count":0,"reply_count":35,"retweet_count":2},"text":"我仇恨的根本不是富二代，而是部分富二代自带的愚蠢认知和优越感；有的即使是对于多花10块钱，也分得清到底值不值；可以心情好花10万买瓶酒，也可以吃十块钱的炒粉；嘲笑其他没钱的人因为经济不足就对于自己的爱好应该有不配得感；愚蠢的把消费水平等同于人格高低，买到假货不责怪商家监管，责怪消费者","url":"https://x.com/0TwT012/status/2053227469801726071"},{"author_id":"1917047326990094336","conversation_id":"2053216450610114595","created_at":"2026-05-09T20:52:03.000Z","edit_history_tweet_ids":["2053216450610114595"],"id":"2053216450610114595","lang":"zh","public_metrics":{"bookmark_count":6,"impression_count":11685,"like_count":166,"quote_count":9,"reply_count":32,"retweet_count":20},"text":"最致命的绝望 某天你发现连最擅长的事都做不好了 可周围的人依旧觉得你可以","url":"https://x.com/0TwT012/status/2053216450610114595"},{"author_id":"1917047326990094336","conversation_id":"2053182808332628418","created_at":"2026-05-09T18:38:22.000Z","edit_history_tweet_ids":["2053182808332628418"],"id":"2053182808332628418","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":21972,"like_count":240,"quote_count":0,"reply_count":31,"retweet_count":18},"text":"真没想到母亲节这么热闹 印象中很多人都是没妈的","url":"https://x.com/0TwT012/status/2053182808332628418"},{"author_id":"1917047326990094336","conversation_id":"2053117108872257549","created_at":"2026-05-09T14:17:18.000Z","edit_history_tweet_ids":["2053117108872257549"],"id":"2053117108872257549","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":6007,"like_count":12,"quote_count":0,"reply_count":33,"retweet_count":0},"text":"这些打广告的知道自己很烦人吗 https://t.co/AiW7Dr0VhV","url":"https://x.com/0TwT012/status/2053117108872257549"},{"author_id":"1917047326990094336","conversation_id":"2053116971655590242","created_at":"2026-05-09T14:16:45.000Z","edit_history_tweet_ids":["2053116971655590242"],"id":"2053116971655590242","lang":"zh","public_metrics":{"bookmark_count":113,"impression_count":461994,"like_count":6633,"quote_count":16,"reply_count":555,"retweet_count":318},"text":"发明调休的人试一下365天不自慰，最后一天自慰356次","url":"https://x.com/0TwT012/status/2053116971655590242"},{"author_id":"1917047326990094336","conversation_id":"2053068505382306205","created_at":"2026-05-09T11:04:10.000Z","edit_history_tweet_ids":["2053068505382306205"],"id":"2053068505382306205","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":4274,"like_count":33,"quote_count":2,"reply_count":45,"retweet_count":3},"text":"多做多错 少做少错 不做不错 不错不错","url":"https://x.com/0TwT012/status/2053068505382306205"},{"author_id":"1917047326990094336","conversation_id":"2053067351197946200","created_at":"2026-05-09T10:59:35.000Z","edit_history_tweet_ids":["2053067351197946200"],"id":"2053067351197946200","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":4276,"like_count":51,"quote_count":1,"reply_count":46,"retweet_count":9},"text":"我尽量保持平静直到眼泪再也哭不出来","url":"https://x.com/0TwT012/status/2053067351197946200"},{"author_id":"1917047326990094336","conversation_id":"2053067045345100118","created_at":"2026-05-09T10:58:22.000Z","edit_history_tweet_ids":["2053067045345100118"],"id":"2053067045345100118","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":3757,"like_count":52,"quote_count":0,"reply_count":54,"retweet_count":0},"text":"我给不了的东西却也不希望你一辈子都得不到。","url":"https://x.com/0TwT012/status/2053067045345100118"},{"author_id":"1917047326990094336","conversation_id":"2052877589073801582","created_at":"2026-05-08T22:25:32.000Z","edit_history_tweet_ids":["2052877589073801582"],"id":"2052877589073801582","lang":"zh","public_metrics":{"bookmark_count":20,"impression_count":16571,"like_count":300,"quote_count":2,"reply_count":40,"retweet_count":35},"text":"如果你问我，我会说我并没有后悔，遇见你也是，和你分开也是。不是说人的一生就是在追寻中失去吗，只要我知道我要去哪里，我知道我的每个选择都出于本心，是为了朝着更好的自己前进，对我来说那就足够了。但是沿途遇见的太阳白云，小猫小狗，还有你，都是很棒的风景","url":"https://x.com/0TwT012/status/2052877589073801582"},{"author_id":"1917047326990094336","conversation_id":"2052793466133074003","created_at":"2026-05-08T16:51:16.000Z","edit_history_tweet_ids":["2052793466133074003"],"id":"2052793466133074003","lang":"zh","public_metrics":{"bookmark_count":22,"impression_count":24147,"like_count":529,"quote_count":5,"reply_count":111,"retweet_count":48},"text":"“我爱你”这三个字真的分量超级重啊。尤其是那种麻木冷淡的类型，被狗哄高兴了最多偶尔说说“喜欢你”，等到某一天特别平常的下午窝在沙发上，突然很认真的对狗说“我爱你”才是真的贫瘠的土地开出小狗花","url":"https://x.com/0TwT012/status/2052793466133074003"},{"author_id":"1917047326990094336","conversation_id":"2052792919095214252","created_at":"2026-05-08T16:49:05.000Z","edit_history_tweet_ids":["2052792919095214252"],"id":"2052792919095214252","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":12832,"like_count":149,"quote_count":0,"reply_count":126,"retweet_count":18},"text":"你对我没有爱不可怕，假装有爱才可怕","url":"https://x.com/0TwT012/status/2052792919095214252"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_image_url":"https://pbs.twimg.com/profile_images/1917047544313679872/akAJkXe1_normal.jpg","username":"0TwT012","verified":false}]},"meta":{"newest_id":"2053792127671574688","next_token":"b26v89c19zqg8o3juenh6jmemu9aeimrg3vyw9zv9ilbx","oldest_id":"2052792919095214252","result_count":25}}