{"data":[{"author_id":"1917047326990094336","conversation_id":"2051026830845788372","created_at":"2026-05-03T19:51:17.000Z","edit_history_tweet_ids":["2051026830845788372"],"id":"2051026830845788372","lang":"zh","public_metrics":{"bookmark_count":4,"impression_count":6017,"like_count":90,"quote_count":1,"reply_count":26,"retweet_count":15},"text":"你必须对我百依百顺依着我哄着我宠着我不能让我有一点不开心知道吗","url":"https://x.com/0TwT012/status/2051026830845788372"},{"author_id":"1917047326990094336","conversation_id":"2051023170359173199","created_at":"2026-05-03T19:36:44.000Z","edit_history_tweet_ids":["2051023170359173199"],"id":"2051023170359173199","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":1518,"like_count":8,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"其实对我而言想起以前根本不是什么很好的事","url":"https://x.com/0TwT012/status/2051023170359173199"},{"author_id":"1917047326990094336","conversation_id":"2051022387576287635","created_at":"2026-05-03T19:33:38.000Z","edit_history_tweet_ids":["2051022387576287635"],"id":"2051022387576287635","lang":"zh","public_metrics":{"bookmark_count":8,"impression_count":5864,"like_count":123,"quote_count":0,"reply_count":22,"retweet_count":25},"text":"走到今天 我已经失去很多了 我健康的心理和身体我积极的心态和正常的性格 我以为我只需要一个新的阶段和环境就会回到以前的自己 但现在才明白很多东西失去了是永远不会回来了","url":"https://x.com/0TwT012/status/2051022387576287635"},{"author_id":"1917047326990094336","conversation_id":"2050994744101355596","created_at":"2026-05-03T17:43:47.000Z","edit_history_tweet_ids":["2050994744101355596"],"id":"2050994744101355596","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2301,"like_count":23,"quote_count":0,"reply_count":20,"retweet_count":1},"text":"我时常因为我的恶心思想做作行为暴脾气而感到悲哀","url":"https://x.com/0TwT012/status/2050994744101355596"},{"author_id":"1917047326990094336","conversation_id":"2050971582835904658","created_at":"2026-05-03T16:11:45.000Z","edit_history_tweet_ids":["2050971582835904658"],"id":"2050971582835904658","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":2977,"like_count":42,"quote_count":0,"reply_count":34,"retweet_count":3},"text":"只是一直在失去什么罢了\n又想起很多以前的事。\n关注的博主啊，很喜欢的小说作者啊，还有网络上的朋友。\n戛然而止，深深的无力感。\n只是。","url":"https://x.com/0TwT012/status/2050971582835904658"},{"author_id":"1917047326990094336","conversation_id":"2050967608418279533","created_at":"2026-05-03T15:55:57.000Z","edit_history_tweet_ids":["2050967608418279533"],"id":"2050967608418279533","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":2437,"like_count":28,"quote_count":0,"reply_count":30,"retweet_count":2},"text":"五月的雨滴在我的脸上，告诉我我还活着，这段时间在很用力的感知世界上的事物，感觉快要飘走了","url":"https://x.com/0TwT012/status/2050967608418279533"},{"author_id":"1917047326990094336","conversation_id":"2050965581315387556","created_at":"2026-05-03T15:47:54.000Z","edit_history_tweet_ids":["2050965581315387556"],"id":"2050965581315387556","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":3567,"like_count":63,"quote_count":0,"reply_count":33,"retweet_count":3},"text":"放下仇恨但是放下就消失了，所以难道是我不想放下，我是怕一些缘分的消散","url":"https://x.com/0TwT012/status/2050965581315387556"},{"author_id":"1917047326990094336","conversation_id":"2050964177188221195","created_at":"2026-05-03T15:42:19.000Z","edit_history_tweet_ids":["2050964177188221195"],"id":"2050964177188221195","lang":"zh","public_metrics":{"bookmark_count":9,"impression_count":19629,"like_count":205,"quote_count":2,"reply_count":29,"retweet_count":35},"text":"我喜欢你直白的占有欲，喜欢听你说需要我。","url":"https://x.com/0TwT012/status/2050964177188221195"},{"author_id":"1917047326990094336","conversation_id":"2050913859519885695","created_at":"2026-05-03T12:22:22.000Z","edit_history_tweet_ids":["2050913859519885695"],"id":"2050913859519885695","lang":"zh","public_metrics":{"bookmark_count":38,"impression_count":103774,"like_count":1683,"quote_count":33,"reply_count":528,"retweet_count":121},"text":"姐妹，我咋感觉你老公好像不是回避型，好像是不喜欢你啊","url":"https://x.com/0TwT012/status/2050913859519885695"},{"author_id":"1917047326990094336","conversation_id":"2050880152956252400","created_at":"2026-05-03T10:08:26.000Z","edit_history_tweet_ids":["2050880152956252400"],"id":"2050880152956252400","lang":"zh","public_metrics":{"bookmark_count":17,"impression_count":36013,"like_count":405,"quote_count":5,"reply_count":24,"retweet_count":56},"text":"笨蛋话可以给我发，一日三餐可以给我发，路边的猫可以给我发，飘过的云可以给我发，爱听的歌可以给我发，涩情消息可以给我发，遥控链接更可以给我发","url":"https://x.com/0TwT012/status/2050880152956252400"},{"author_id":"1917047326990094336","conversation_id":"2050812191570591746","created_at":"2026-05-03T05:38:23.000Z","edit_history_tweet_ids":["2050812191570591746"],"id":"2050812191570591746","lang":"zxx","public_metrics":{"bookmark_count":2,"impression_count":5848,"like_count":27,"quote_count":0,"reply_count":0,"retweet_count":4},"text":"https://t.co/AdzMAGu6xz","url":"https://x.com/0TwT012/status/2050812191570591746"},{"author_id":"1917047326990094336","conversation_id":"2050598333480415308","created_at":"2026-05-02T15:28:35.000Z","edit_history_tweet_ids":["2050598333480415308"],"id":"2050598333480415308","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":1634,"like_count":14,"quote_count":0,"reply_count":16,"retweet_count":0},"text":"我很难受我觉得我活不长了","url":"https://x.com/0TwT012/status/2050598333480415308"},{"author_id":"1917047326990094336","conversation_id":"2050597172731936846","created_at":"2026-05-02T15:23:58.000Z","edit_history_tweet_ids":["2050597172731936846"],"id":"2050597172731936846","lang":"zh","public_metrics":{"bookmark_count":9,"impression_count":6428,"like_count":135,"quote_count":0,"reply_count":33,"retweet_count":11},"text":"那天见面时也没有想到会是最后一面，骗你的，其实我早就知道了，只是看你那么开心的探讨未来我真的说不出口，当彼此完成课题时，这个宇宙便会确保我们再无重逢之时。","url":"https://x.com/0TwT012/status/2050597172731936846"},{"author_id":"1917047326990094336","conversation_id":"2050582787015713063","created_at":"2026-05-02T14:26:49.000Z","edit_history_tweet_ids":["2050582787015713063"],"id":"2050582787015713063","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2413,"like_count":21,"quote_count":0,"reply_count":25,"retweet_count":0},"text":"我觉得我如果真的活不久的话肯定是因为我跟前任接触太久了，跟阴间的人相处太久了会损耗我的阳寿的","url":"https://x.com/0TwT012/status/2050582787015713063"},{"author_id":"1917047326990094336","conversation_id":"2050519237014536671","created_at":"2026-05-02T10:14:17.000Z","edit_history_tweet_ids":["2050519237014536671"],"id":"2050519237014536671","lang":"ja","public_metrics":{"bookmark_count":0,"impression_count":2240,"like_count":16,"quote_count":0,"reply_count":4,"retweet_count":0},"text":"想要草皮","url":"https://x.com/0TwT012/status/2050519237014536671"},{"author_id":"1917047326990094336","conversation_id":"2050510640587166070","created_at":"2026-05-02T09:40:08.000Z","edit_history_tweet_ids":["2050510640587166070"],"id":"2050510640587166070","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3657,"like_count":19,"quote_count":0,"reply_count":52,"retweet_count":0},"text":"假期看到商场人多一阵反胃跑到厕所一阵吐，吐完发现脸上有水一摸发现吐的我流眼泪了","url":"https://x.com/0TwT012/status/2050510640587166070"},{"author_id":"1917047326990094336","conversation_id":"2050432083374588051","created_at":"2026-05-02T04:27:58.000Z","edit_history_tweet_ids":["2050432083374588051"],"id":"2050432083374588051","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":5457,"like_count":88,"quote_count":2,"reply_count":25,"retweet_count":9},"text":"跟你叽叽喳喳地讲了好多以前的事 你笑着说你给我讲过 好奇妙 感觉你参与了我的曾经","url":"https://x.com/0TwT012/status/2050432083374588051"},{"author_id":"1917047326990094336","conversation_id":"2050289482323415228","created_at":"2026-05-01T19:01:19.000Z","edit_history_tweet_ids":["2050289482323415228"],"id":"2050289482323415228","lang":"zh","public_metrics":{"bookmark_count":17,"impression_count":11105,"like_count":292,"quote_count":5,"reply_count":26,"retweet_count":58},"text":"我想我已经接受了我们的现状 我还是会偶尔想起你不过没像那段时间疯狂为你流泪了 我已经猜不到你在哪里 你在做什么 今天开不开心 我们已经没有任何关系了 我们很深刻的在对方生命里留下印象 现在却如云烟一般消散了我们没有未来 也回不到过去 事与愿违只能妥协","url":"https://x.com/0TwT012/status/2050289482323415228"},{"author_id":"1917047326990094336","conversation_id":"2050274734219399541","created_at":"2026-05-01T18:02:43.000Z","edit_history_tweet_ids":["2050274734219399541"],"id":"2050274734219399541","lang":"zh","public_metrics":{"bookmark_count":18,"impression_count":35161,"like_count":360,"quote_count":12,"reply_count":207,"retweet_count":14},"text":"恋爱真的会把一个活泼开朗的人变得敏感多疑吗","url":"https://x.com/0TwT012/status/2050274734219399541"},{"author_id":"1917047326990094336","conversation_id":"2050268745894158647","created_at":"2026-05-01T17:38:55.000Z","edit_history_tweet_ids":["2050268745894158647"],"id":"2050268745894158647","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":7384,"like_count":172,"quote_count":1,"reply_count":58,"retweet_count":16},"text":"为什么大家都要在我最虚弱的时候抛弃我呢","url":"https://x.com/0TwT012/status/2050268745894158647"},{"author_id":"1917047326990094336","conversation_id":"2050253392359100734","created_at":"2026-05-01T16:37:55.000Z","edit_history_tweet_ids":["2050253392359100734"],"id":"2050253392359100734","lang":"zh","public_metrics":{"bookmark_count":8,"impression_count":3834,"like_count":80,"quote_count":0,"reply_count":26,"retweet_count":13},"text":"如果能回到过去 我想我会更用力一些 抓紧你 抱歉 现在我已经没有任何身份对你说这些话了","url":"https://x.com/0TwT012/status/2050253392359100734"},{"author_id":"1917047326990094336","conversation_id":"2050252973553623190","created_at":"2026-05-01T16:36:15.000Z","edit_history_tweet_ids":["2050252973553623190"],"id":"2050252973553623190","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":3156,"like_count":68,"quote_count":3,"reply_count":23,"retweet_count":7},"text":"如果连我也向前走的话 我们的过去就真的没人记住了","url":"https://x.com/0TwT012/status/2050252973553623190"},{"author_id":"1917047326990094336","conversation_id":"2050251818283012338","created_at":"2026-05-01T16:31:39.000Z","edit_history_tweet_ids":["2050251818283012338"],"id":"2050251818283012338","lang":"zh","public_metrics":{"bookmark_count":6,"impression_count":14011,"like_count":268,"quote_count":2,"reply_count":27,"retweet_count":48},"text":"只是想起以前 觉得爱和恨都有一点难过","url":"https://x.com/0TwT012/status/2050251818283012338"},{"author_id":"1917047326990094336","conversation_id":"2050174962309513524","created_at":"2026-05-01T11:26:16.000Z","edit_history_tweet_ids":["2050174962309513524"],"id":"2050174962309513524","lang":"zh","public_metrics":{"bookmark_count":8,"impression_count":6593,"like_count":194,"quote_count":1,"reply_count":27,"retweet_count":27},"text":"奇怪你是一颗洋葱吗为什么只是想起你我就要流眼泪，我讨厌因为你变得脆弱的自己还好现在已经脱敏了。","url":"https://x.com/0TwT012/status/2050174962309513524"},{"author_id":"1917047326990094336","conversation_id":"2050073699823530494","created_at":"2026-05-01T04:43:53.000Z","edit_history_tweet_ids":["2050073699823530494"],"id":"2050073699823530494","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":3037,"like_count":29,"quote_count":0,"reply_count":24,"retweet_count":4},"text":"人人都说要知足 不要既要还要\n我没有说话 我在问自己到底要了什么 又得到了什么\n这几年  我想要的从来没有人给过我","url":"https://x.com/0TwT012/status/2050073699823530494"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_image_url":"https://pbs.twimg.com/profile_images/1917047544313679872/akAJkXe1_normal.jpg","username":"0TwT012","verified":false}]},"meta":{"newest_id":"2051026830845788372","next_token":"b26v89c19zqg8o3juengbtgu81rsrxt3aqgaynedy40vx","oldest_id":"2050073699823530494","result_count":25}}