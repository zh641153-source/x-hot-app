nt":110,"retweet_count":3},"text":"博主睡觉唯一方式：精力条见底后晕倒","url":"https://x.com/0TwT012/status/2087275731508478424"},{"author_id":"1917047326990094336","conversation_id":"2087275199628820890","created_at":"2026-08-11T20:29:21.000Z","edit_history_tweet_ids":["2087275199628820890"],"id":"2087275199628820890","lang":"zh","public_metrics":{"bookmark_count":21,"impression_count":60575,"like_count":1109,"quote_count":16,"reply_count":195,"retweet_count":153},"text":"所有人注意我打完游戏了，要从情感漠视变成高需求了","url":"https://x.com/0TwT012/status/2087275199628820890"},{"author_id":"1917047326990094336","conversation_id":"2087170157546450944","created_at":"2026-08-11T13:31:57.000Z","edit_history_tweet_ids":["2087170157546450944"],"id":"2087170157546450944","lang":"zh","public_metrics":{"bookmark_count":147,"impression_count":286609,"like_count":6365,"quote_count":40,"reply_count":1144,"retweet_count":317},"text":"上帝不用看片，因为人在做天在看","url":"https://x.com/0TwT012/status/2087170157546450944"},{"author_id":"1917047326990094336","conversation_id":"2087156754077683862","created_at":"2026-08-11T12:38:42.000Z","edit_history_tweet_ids":["2087156754077683862"],"id":"2087156754077683862","lang":"zh","public_metrics":{"bookmark_count":56,"impression_count":91852,"like_count":1566,"quote_count":4,"reply_count":363,"retweet_count":49},"text":"一旦意识到旧日支配者可以翻译成伟大的老资历就会很好笑","url":"https://x.com/0TwT012/status/2087156754077683862"},{"author_id":"1917047326990094336","conversation_id":"2087156557113176473","created_at":"2026-08-11T12:37:55.000Z","edit_history_tweet_ids":["2087156557113176473"],"id":"2087156557113176473","lang":"zh","public_metrics":{"bookmark_count":279,"impression_count":637833,"like_count":8487,"quote_count":95,"reply_count":1650,"retweet_count":415},"text":"你们知不知道外星人电解质水其实是把外星人电到尿失禁榨出来的。","url":"https://x.com/0TwT012/status/2087156557113176473"},{"author_id":"1917047326990094336","conversation_id":"2087086344325804518","created_at":"2026-08-11T07:58:55.000Z","edit_history_tweet_ids":["2087086344325804518"],"id":"2087086344325804518","lang":"zh","public_metrics":{"bookmark_count":49,"impression_count":232769,"like_count":2281,"quote_count":14,"reply_count":615,"retweet_count":81},"text":"如果说“月色真美”是属于日本人的含蓄告白，那那那“野生狗奶”是中国人的含蓄告白吗。。","url":"https://x.com/0TwT012/status/2087086344325804518"},{"author_id":"1917047326990094336","conversation_id":"2087044586086793702","created_at":"2026-08-11T05:12:59.000Z","edit_history_tweet_ids":["2087044586086793702"],"id":"2087044586086793702","lang":"zxx","public_metrics":{"bookmark_count":1,"impression_count":8776,"like_count":41,"quote_count":0,"reply_count":23,"retweet_count":2},"text":"https://t.co/LF88H6dQV0","url":"https://x.com/0TwT012/status/2087044586086793702"},{"author_id":"1917047326990094336","conversation_id":"2087043969444417673","created_at":"2026-08-11T05:10:32.000Z","edit_history_tweet_ids":["2087043969444417673"],"id":"2087043969444417673","lang":"zh","note_tweet":{"text":"我讨厌任何人为我牺牲为我放弃什么，如果你今天送我一条我喜欢了很久的项链，然后告诉我，为了买礼物你要吃好多顿没有营养的泡面，还要放弃许多和朋友一起出去玩的机会，最后说一句不过你开心就好。那我宁愿让你退掉，因为我喜欢的东西我自己靠自己也能得到\n你爱我的话我怎样都高兴，但我更希望你好好爱自己，而不是牺牲自己的利益来成全我，因为这样我只会觉得很沉重。你是想让我愧疚吗？你的意思是你的难处是我造成的吗？"},"public_metrics":{"bookmark_count":13,"impression_count":16038,"like_count":282,"quote_count":3,"reply_count":95,"retweet_count":35},"text":"我讨厌任何人为我牺牲为我放弃什么，如果你今天送我一条我喜欢了很久的项链，然后告诉我，为了买礼物你要吃好多顿没有营养的泡面，还要放弃许多和朋友一起出去玩的机会，最后说一句不过你开心就好。那我宁愿让你退掉，因为我喜欢的东西我自己靠自己也能得到","url":"https://x.com/0TwT012/status/2087043969444417673"},{"author_id":"1917047326990094336","conversation_id":"2087042476104393148","created_at":"2026-08-11T05:04:36.000Z","edit_history_tweet_ids":["2087042476104393148"],"id":"2087042476104393148","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":3610,"like_count":25,"quote_count":1,"reply_count":7,"retweet_count":1},"text":"射精算不算一种放生","url":"https://x.com/0TwT012/status/2087042476104393148"},{"author_id":"1917047326990094336","conversation_id":"2087039913774690383","created_at":"2026-08-11T04:54:25.000Z","edit_history_tweet_ids":["2087039913774690383"],"id":"2087039913774690383","lang":"zh","public_metrics":{"bookmark_count":4,"impression_count":11241,"like_count":80,"quote_count":1,"reply_count":99,"retweet_count":3},"text":"我打游戏虽然杀心很重，但手法很善良一个都打不死，雷霆手段却尽显菩萨心肠","url":"https://x.com/0TwT012/status/2087039913774690383"},{"author_id":"1917047326990094336","conversation_id":"2087015478334267540","created_at":"2026-08-11T03:17:19.000Z","edit_history_tweet_ids":["2087015478334267540"],"id":"2087015478334267540","lang":"zh","public_metrics":{"bookmark_count":23,"impression_count":74502,"like_count":868,"quote_count":10,"reply_count":242,"retweet_count":62},"text":"你心智还没成熟，但你的皮肤和骨质已经开始疏松了，不过没关系，至少你的手头很紧","url":"https://x.com/0TwT012/status/2087015478334267540"},{"author_id":"1917047326990094336","conversation_id":"2086878614377935122","created_at":"2026-08-10T18:13:28.000Z","edit_history_tweet_ids":["2086878614377935122"],"id":"2086878614377935122","lang":"zh","public_metrics":{"bookmark_count":34,"impression_count":73741,"like_count":2542,"quote_count":10,"reply_count":258,"retweet_count":266},"text":"你负能量一百条我都愿意看，但你炫富一条，不好意思互删 因为你触发了我的不幸者狗叫原则。","url":"https://x.com/0TwT012/status/2086878614377935122"},{"author_id":"1917047326990094336","conversation_id":"2086877682994987187","created_at":"2026-08-10T18:09:46.000Z","edit_history_tweet_ids":["2086877682994987187"],"id":"2086877682994987187","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":5271,"like_count":40,"quote_count":0,"reply_count":29,"retweet_count":3},"text":"喜欢和爱到底算什么","url":"https://x.com/0TwT012/status/2086877682994987187"},{"author_id":"1917047326990094336","conversation_id":"2086877469773381833","created_at":"2026-08-10T18:08:55.000Z","edit_history_tweet_ids":["2086877469773381833"],"id":"2086877469773381833","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":6900,"like_count":85,"quote_count":0,"reply_count":34,"retweet_count":6},"text":"我其实一直不太会处理分离焦虑，许多次我被迫体验到世事无常以至于和每个所珍视的人每次分离都会产生巨大的后坐力。体感上有点像热化了的糖外面裹松针，巨大的疲惫黏黏糊糊带着一点点刺挠，等冷静下来之后才意识到每一次见面都弥足珍贵，糖心没化还是很好。","url":"https://x.com/0TwT012/status/2086877469773381833"},{"author_id":"1917047326990094336","conversation_id":"2086876684171772132","created_at":"2026-08-10T18:05:48.000Z","edit_history_tweet_ids":["2086876684171772132"],"id":"2086876684171772132","lang":"zh","public_metrics":{"bookmark_count":4,"impression_count":5613,"like_count":41,"quote_count":0,"reply_count":47,"retweet_count":4},"text":"冰箱里腐烂掉的番茄困难在，它的赏味期并不标注明显。我给它更高的期待，到它有天长出白色的薄绒，在我察觉以前就放弃了我。冰箱里的食材像恋人，是活着的生命。","url":"https://x.com/0TwT012/status/2086876684171772132"},{"author_id":"1917047326990094336","conversation_id":"2086876559718461646","created_at":"2026-08-10T18:05:18.000Z","edit_history_tweet_ids":["2086876559718461646"],"id":"2086876559718461646","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":4335,"like_count":18,"quote_count":0,"reply_count":38,"retweet_count":0},"text":"乱乱的。想说对阳台上被养死的植物感到抱歉，前几天最热的时候还想象了花开得很漂亮的样子，或是它们被太阳晒得渴渴地、在家努力等待我回去向土壤喂一点水的样子..我实在是太不会养花了！","url":"https://x.com/0TwT012/status/2086876559718461646"},{"author_id":"1917047326990094336","conversation_id":"2086875844589580535","created_at":"2026-08-10T18:02:28.000Z","edit_history_tweet_ids":["2086875844589580535"],"id":"2086875844589580535","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":6229,"like_count":38,"quote_count":0,"reply_count":53,"retweet_count":0},"text":"地球online能不能开一个找东西的指引系统\n我每次都只有大概的印象 翻一圈也找不到想要的东西","url":"https://x.com/0TwT012/status/2086875844589580535"},{"author_id":"1917047326990094336","conversation_id":"2086874990616748165","created_at":"2026-08-10T17:59:04.000Z","edit_history_tweet_ids":["2086874990616748165"],"id":"2086874990616748165","lang":"zh","public_metrics":{"bookmark_count":5,"impression_count":13908,"like_count":211,"quote_count":2,"reply_count":99,"retweet_count":39},"text":"你和谁都有以后 唯独和我不行 我已经说不出来到底是恨还是狠","url":"https://x.com/0TwT012/status/2086874990616748165"},{"author_id":"1917047326990