{"data":[{"author_id":"1917047326990094336","conversation_id":"2085289423801905218","created_at":"2026-08-06T08:58:36.000Z","edit_history_tweet_ids":["2085289423801905218"],"id":"2085289423801905218","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":8173,"like_count":35,"quote_count":0,"reply_count":63,"retweet_count":2},"text":"啥叫破财消灾。破财对我来说就是最大的灾了","url":"https://x.com/0TwT012/status/2085289423801905218"},{"author_id":"1917047326990094336","conversation_id":"2085266764946932006","created_at":"2026-08-06T07:28:33.000Z","edit_history_tweet_ids":["2085266764946932006"],"id":"2085266764946932006","lang":"ja","public_metrics":{"bookmark_count":0,"impression_count":4099,"like_count":14,"quote_count":0,"reply_count":2,"retweet_count":0},"text":"只是走路 https://t.co/Gt5kvrODeW","url":"https://x.com/0TwT012/status/2085266764946932006"},{"author_id":"1917047326990094336","conversation_id":"2085157412823077133","created_at":"2026-08-06T00:14:02.000Z","edit_history_tweet_ids":["2085157412823077133"],"id":"2085157412823077133","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":9175,"like_count":57,"quote_count":1,"reply_count":43,"retweet_count":12},"text":"我需要一段暖暖的毛茸茸的令我感到舒适的像被子那样的关系，所以你要跟我裹一被子吗","url":"https://x.com/0TwT012/status/2085157412823077133"},{"author_id":"1917047326990094336","conversation_id":"2085155601332502651","created_at":"2026-08-06T00:06:50.000Z","edit_history_tweet_ids":["2085155601332502651"],"id":"2085155601332502651","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":10798,"like_count":107,"quote_count":5,"reply_count":22,"retweet_count":10},"text":"想象一下我是你的ADHD朋友，注意力不集中的同时还脑雾，经常莫名其妙问你我要干什么来着，但是我要干什么你怎么可能知道","url":"https://x.com/0TwT012/status/2085155601332502651"},{"author_id":"1917047326990094336","conversation_id":"2085002489443627269","created_at":"2026-08-05T13:58:25.000Z","edit_history_tweet_ids":["2085002489443627269"],"id":"2085002489443627269","lang":"zxx","public_metrics":{"bookmark_count":2,"impression_count":11904,"like_count":190,"quote_count":0,"reply_count":8,"retweet_count":3},"text":"https://t.co/kuuFkgU5cf","url":"https://x.com/0TwT012/status/2085002489443627269"},{"author_id":"1917047326990094336","conversation_id":"2084994753456681285","created_at":"2026-08-05T13:27:41.000Z","edit_history_tweet_ids":["2084994753456681285"],"id":"2084994753456681285","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3821,"like_count":7,"quote_count":0,"reply_count":19,"retweet_count":0},"text":"喜欢我的话给我打钱就好了，讨厌我的话让我滚就好了","url":"https://x.com/0TwT012/status/2084994753456681285"},{"author_id":"1917047326990094336","conversation_id":"2084990704569249797","created_at":"2026-08-05T13:11:35.000Z","edit_history_tweet_ids":["2084990704569249797"],"id":"2084990704569249797","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":6596,"like_count":92,"quote_count":0,"reply_count":40,"retweet_count":11},"text":"我不要再怀念过去的温存了。过去已经没有任何人了。我们可以往前走，可以放弃反刍陈芝麻烂谷子的破事，可以把心打上订书钉。痛，痛到难以忘怀","url":"https://x.com/0TwT012/status/2084990704569249797"},{"author_id":"1917047326990094336","conversation_id":"2084990230487036246","created_at":"2026-08-05T13:09:42.000Z","edit_history_tweet_ids":["2084990230487036246"],"id":"2084990230487036246","lang":"ja","public_metrics":{"bookmark_count":0,"impression_count":4551,"like_count":13,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"我不知道我今天咋了一整天一直在哭","url":"https://x.com/0TwT012/status/2084990230487036246"},{"author_id":"1917047326990094336","conversation_id":"2084989744669139189","created_at":"2026-08-05T13:07:47.000Z","edit_history_tweet_ids":["2084989744669139189"],"id":"2084989744669139189","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":7576,"like_count":22,"quote_count":0,"reply_count":36,"retweet_count":0},"text":"寻找不到活着的意义","url":"https://x.com/0TwT012/status/2084989744669139189"},{"author_id":"1917047326990094336","conversation_id":"2084972197534183678","created_at":"2026-08-05T11:58:03.000Z","edit_history_tweet_ids":["2084972197534183678"],"id":"2084972197534183678","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":5419,"like_count":30,"quote_count":0,"reply_count":3,"retweet_count":1},"text":"我爱你爱我，也爱你恨我。我爱你第一次爱我，我爱你第二次爱我，我爱你第一次害怕我，我也爱你最后一次恨我。可你所说的永远却也已经离我很远了。","url":"https://x.com/0TwT012/status/2084972197534183678"},{"author_id":"1917047326990094336","conversation_id":"2084829690519294435","created_at":"2026-08-05T02:31:47.000Z","edit_history_tweet_ids":["2084829690519294435"],"id":"2084829690519294435","lang":"ja","public_metrics":{"bookmark_count":1,"impression_count":4965,"like_count":15,"quote_count":0,"reply_count":23,"retweet_count":1},"text":"我好恨你啊。","url":"https://x.com/0TwT012/status/2084829690519294435"},{"author_id":"1917047326990094336","conversation_id":"2084828716618674475","created_at":"2026-08-05T02:27:54.000Z","edit_history_tweet_ids":["2084828716618674475"],"id":"2084828716618674475","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":6433,"like_count":57,"quote_count":0,"reply_count":17,"retweet_count":12},"text":"那些话就像钢针一样刺进了我的心，刺穿唤醒了我自欺欺人很多年的心，我以为我不会再因为以前的事而难过了，显然并不是，我又要重复曾经无数个痛苦的夜晚了。","url":"https://x.com/0TwT012/status/2084828716618674475"},{"author_id":"1917047326990094336","conversation_id":"2084827011265020320","created_at":"2026-08-05T02:21:08.000Z","edit_history_tweet_ids":["2084827011265020320"],"id":"2084827011265020320","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":6535,"like_count":24,"quote_count":0,"reply_count":32,"retweet_count":2},"text":"我好想哭，我以为我早就忘记他了结果一闭上眼又梦到他的眼泪砸在我手心","url":"https://x.com/0TwT012/status/2084827011265020320"},{"author_id":"1917047326990094336","conversation_id":"2084733720330715606","created_at":"2026-08-04T20:10:26.000Z","edit_history_tweet_ids":["2084733720330715606"],"id":"2084733720330715606","lang":"zh","public_metrics":{"bookmark_count":54,"impression_count":717524,"like_count":4294,"quote_count":6,"reply_count":713,"retweet_count":62},"text":"第一个知道男人不能怀孕的人到底对男人做了什么","url":"https://x.com/0TwT012/status/2084733720330715606"},{"author_id":"1917047326990094336","conversation_id":"2084702138786058696","created_at":"2026-08-04T18:04:56.000Z","edit_history_tweet_ids":["2084702138786058696"],"id":"2084702138786058696","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":9409,"like_count":48,"quote_count":1,"reply_count":55,"retweet_count":7},"text":"经常对自己说出口的话疯狂后悔，然后又对着别人说的一句随口的话难过","url":"https://x.com/0TwT012/status/2084702138786058696"},{"author_id":"1917047326990094336","conversation_id":"2084672823570645004","created_at":"2026-08-04T16:08:27.000Z","edit_history_tweet_ids":["2084672823570645004"],"id":"2084672823570645004","lang":"zh","public_metrics":{"bookmark_count":9,"impression_count":14396,"like_count":114,"quote_count":0,"reply_count":72,"retweet_count":7},"text":"如果我可以用一个词形容爱的感受，那就是melt，融化，被爱欲和情欲烧到融化成一滩液体流向对方的怀抱，也企图淹没每一个呼吸的毛孔窜向心脏。我在你的身上融化成一团，所以亲爱的，你可以捞起我的一小块去塑造我，只要我还在处于爱之中。","url":"https://x.com/0TwT012/status/2084672823570645004"},{"author_id":"1917047326990094336","conversation_id":"2084672593739616484","created_at":"2026-08-04T16:07:32.000Z","edit_history_tweet_ids":["2084672593739616484"],"id":"2084672593739616484","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":11341,"like_count":49,"quote_count":0,"reply_count":23,"retweet_count":7},"text":"其实我会通过回忆对方时的痛感去丈量感情的深浅，结果每次都是淡淡的，淡淡的，我就好失望啊，我就只能拥有不过如此的关系吗，但我真的感受不到。","url":"https://x.com/0TwT012/status/2084672593739616484"},{"author_id":"1917047326990094336","conversation_id":"2084672139894894766","created_at":"2026-08-04T16:05:44.000Z","edit_history_tweet_ids":["2084672139894894766"],"id":"2084672139894894766","lang":"zh","public_metrics":{"bookmark_count":6,"impression_count":17676,"like_count":146,"quote_count":1,"reply_count":14,"retweet_count":21},"text":"全世界最恨你，不肯承认自己到底花了多少时间去想你。直到现在我才发现这份情感真的只有你可以给我，即使已经缺席空白了这几年，还是希望你可以回到我身边。你知道吗？世界上最遥远的距离，是我们两个的心","url":"https://x.com/0TwT012/status/2084672139894894766"},{"author_id":"1917047326990094336","conversation_id":"2084588944205750309","created_at":"2026-08-04T10:35:08.000Z","edit_history_tweet_ids":["2084588944205750309"],"id":"2084588944205750309","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":7433,"like_count":17,"quote_count":0,"reply_count":70,"retweet_count":1},"text":"打游戏打的我气死了天天让我匹到这种伪人局我不活了","url":"https://x.com/0TwT012/status/2084588944205750309"},{"author_id":"1917047326990094336","conversation_id":"2084335717161808032","created_at":"2026-08-03T17:48:54.000Z","edit_history_tweet_ids":["2084335717161808032"],"id":"2084335717161808032","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":59905,"like_count":398,"quote_count":3,"reply_count":139,"retweet_count":11},"text":"惩罚我的狗在下次起飞的时候大喊中国人能飞","url":"https://x.com/0TwT012/status/2084335717161808032"},{"author_id":"1917047326990094336","conversation_id":"2084334477715664925","created_at":"2026-08-03T17:43:59.000Z","edit_history_tweet_ids":["2084334477715664925"],"id":"2084334477715664925","lang":"zh","public_metrics":{"bookmark_count":171,"impression_count":728658,"like_count":15476,"quote_count":60,"reply_count":1248,"retweet_count":655},"text":"别问我为啥一到晚上ip就变到国外去了，别他妈问了，中国人能飞，行了吧？","url":"https://x.com/0TwT012/status/2084334477715664925"},{"author_id":"1917047326990094336","conversation_id":"2084326627136205156","created_at":"2026-08-03T17:12:47.000Z","edit_history_tweet_ids":["2084326627136205156"],"id":"2084326627136205156","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":12879,"like_count":48,"quote_count":0,"reply_count":41,"retweet_count":5},"text":"占有欲和控制欲都很强的我让你感觉到不适真的很抱歉。","url":"https://x.com/0TwT012/status/2084326627136205156"},{"author_id":"1917047326990094336","conversation_id":"2084326447699661301","created_at":"2026-08-03T17:12:04.000Z","edit_history_tweet_ids":["2084326447699661301"],"id":"2084326447699661301","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":23