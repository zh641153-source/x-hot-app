89847993356791","created_at":"2026-06-27T15:19:49.000Z","edit_history_tweet_ids":["2070889847993356791"],"id":"2070889847993356791","lang":"zh","public_metrics":{"bookmark_count":94,"impression_count":136603,"like_count":1748,"quote_count":42,"reply_count":220,"retweet_count":139},"text":"有些人确实是，你只要不发展亲密关系就会是个让你很舒服的人，一旦发展了过深的亲密关系就会出现巨大的问题","url":"https://x.com/0TwT012/status/2070889847993356791"},{"author_id":"1917047326990094336","conversation_id":"2070863652572602455","created_at":"2026-06-27T13:35:44.000Z","edit_history_tweet_ids":["2070863652572602455"],"id":"2070863652572602455","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":13200,"like_count":174,"quote_count":5,"reply_count":34,"retweet_count":20},"text":"对爱人的态度是 好想你 和 你怎么去不死 来回切换还真是不好意思","url":"https://x.com/0TwT012/status/2070863652572602455"},{"author_id":"1917047326990094336","conversation_id":"2070861750849957991","created_at":"2026-06-27T13:28:10.000Z","edit_history_tweet_ids":["2070861750849957991"],"id":"2070861750849957991","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3760,"like_count":49,"quote_count":0,"reply_count":31,"retweet_count":3},"text":"缺钱的时候可以去找玉米，因为他能给你爆米花","url":"https://x.com/0TwT012/status/2070861750849957991"},{"author_id":"1917047326990094336","conversation_id":"2070857766433075463","created_at":"2026-06-27T13:12:20.000Z","edit_history_tweet_ids":["2070857766433075463"],"id":"2070857766433075463","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":4454,"like_count":28,"quote_count":0,"reply_count":11,"retweet_count":2},"text":"怎么办感觉自己一天比一天疯了，有一种完全没法回头的感觉了","url":"https://x.com/0TwT012/status/2070857766433075463"},{"author_id":"1917047326990094336","conversation_id":"2070850874415722837","created_at":"2026-06-27T12:44:57.000Z","edit_history_tweet_ids":["2070850874415722837"],"id":"2070850874415722837","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2686,"like_count":18,"quote_count":0,"reply_count":15,"re