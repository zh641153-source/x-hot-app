"2070751576961204530"],"id":"2070751576961204530","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":1705,"like_count":10,"quote_count":0,"reply_count":2,"retweet_count":0},"text":"爱你们","url":"https://x.com/0TwT012/status/2070751576961204530"},{"author_id":"1917047326990094336","conversation_id":"2070513927512056006","created_at":"2026-06-26T14:26:03.000Z","edit_history_tweet_ids":["2070513927512056006"],"id":"2070513927512056006","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":3358,"like_count":29,"quote_count":0,"reply_count":12,"retweet_count":0},"text":"好痛苦…跟朋友聊了一天其实有很多话都以玩笑糊弄过去了，但一开始自己一个人就开始很悲伤很难受根本喘不上气心脏更是痛…","url":"https://x.com/0TwT012/status/2070513927512056006"},{"author_id":"1917047326990094336","conversation_id":"2070513560049041885","created_at":"2026-06-26T14:24:35.000Z","edit_history_tweet_ids":["2070513560049041885"],"id":"2070513560049041885","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":3738,"like_count":53,"quote_count":0,"reply_count":11,"retweet_count":8},"text":"哎虽然跟妈关系没那么好虽然有很多创伤但是脆弱的时候不舒服的时候晕乎乎的时候还是有很多个瞬间想说想妈妈！人类最原始的情感呼唤…一想到那个曾经和我用一根脐带相连的女人一想到她的笑脸我就泛起一种想要流泪的冲动 那种眼泪的温度和低烧的温度相似","url":"https://x.com/0TwT012/status/2070513560049041885"},{"author_id":"1917047326990094336","conversation_id":"2070513182524015075","created_at":"2026-06-26T14:23:05.000Z","edit_history_tweet_ids":["2070513182524015075"],"id":"2070513182524015075","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":3456,"like_count":45,"quote_count":0,"reply_count":2,"retweet_count":0},"text":"人类的意思其实就是人累","url":"https://x.com/0TwT012/status/2070513182524015075"},{"author_id":"1917047326990094336","conversation_id":"2070512680570634285","created_at":"2026-06-26T14:21:05.000Z","edit_history_tweet_ids":["2070512680570634285"],"id":"2070512680570634285","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3389,"like_count":32,"quote_count":0,"reply_count":8,"retweet_count":3},"text":"好想吐 想一个人在房间 想捅枕头 好恨 好累 好无言","url":"https://x.com/0TwT012/status/2070512680570634285"},{"author_id":"1917047326990094336","conversation_id":"2070464958299828343","created_at":"2026-06-26T11:11:28.000Z","edit_history_tweet_ids":["2070464958299828343"],"id":"2070464958299828343","lang":"zh","public_metrics":{"bookmark_count":8,"impression_count":5422,"like_count":138,"quote_count":0,"reply_count":1,"retweet_count":24},"text":"虽然总开玩笑说不痛苦的时候都写不出漂亮文字了，也坦然接受从前的一切经历才能构成如今的我，试图用现在拥有的来安抚自己抵御苦楚。\n但是如果可以选择的话，还是想一辈子都做幸福小孩。那些因为痛苦衍生出的光环，我从来都不想得。\n只是不去争这个，就真的什么都没有了。","url":"https://x.com/0TwT012/status/2070464958299828343"},{"author_id":"1917047326990094336","conversation_id":"2070462226222428258","created_at":"2026-06-26T11:00:36.000Z","edit_history_tweet_ids":["2070462226222428258"],"id":"2070462226222428258","lang":"zh","public_metrics":{"bookmark_count":41,"impression_count":123619,"like_count":1732,"quote_count":19,"reply_count":64,"retweet_count":413},"text":"太想被在乎就会过得很痛苦","url":"https://x.com/0TwT012/status/2070462226222428258"}],"includes":{"users":[{"id":"1917047326990094336","name":"kiri","profile_image_url":"https://pbs.twimg.com/profile_images/1917047544313679872/akAJkXe1_normal.jpg","username":"0TwT012","verified":false}]},"meta":{"newest_id":"2071287038733918717","next_token":"b26v89c19zqg8o3juetfvu1u3ufd6x8q5g5zi7xpfxnct","oldest_id":"2070462226222428258","result_count":25}}