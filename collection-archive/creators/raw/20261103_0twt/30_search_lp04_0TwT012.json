游民吧……什么时候才能攒够足够的钱从工作中赎身啊","url":"https://x.com/0TwT012/status/2043749433700147288"},{"author_id":"1917047326990094336","conversation_id":"2043748185378803878","created_at":"2026-04-13T17:48:33.000Z","edit_history_tweet_ids":["2043748185378803878"],"id":"2043748185378803878","lang":"zh","public_metrics":{"bookmark_count":4,"impression_count":8046,"like_count":150,"quote_count":1,"reply_count":4,"retweet_count":28},"text":"我不该向你说那么多毫无意义的话","url":"https://x.com/0TwT012/status/2043748185378803878"},{"author_id":"1917047326990094336","conversation_id":"2043743736912589126","created_at":"2026-04-13T17:30:52.000Z","edit_history_tweet_ids":["2043743736912589126"],"id":"2043743736912589126","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":4605,"like_count":64,"quote_count":1,"reply_count":7,"retweet_count":3},"text":"你老实说是不是你老公不理你了你才和我说话","url":"https://x.com/0TwT012/status/2043743736912589126"},{"author_id":"1917047326990094336","conversation_id":"2043700575129452971","created_at":"2026-04-13T14:39:21.000Z","edit_history_tweet_ids":["2043700575129452971"],"id":"2043700575129452971","lang":"zh","public_metrics":{"bookmark_count":4,"impression_count":12777,"like_count":125,"quote_count":0,"reply_count":61,"retweet_count":6},"text":"你和他聊吧，有不认识的字可以问我","url":"https://x.com/0TwT012/status/2043700575129452971"},{"author_id":"1917047326990094336","conversation_id":"2043628472644550893","created_at":"2026-04-13T09:52:51.000Z","edit_history_tweet_ids":["2043628472644550893"],"id":"2043628472644550893","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":3379,"like_count":15,"quote_count":0,"reply_count":40,"retweet_count":0},"text":"我真的好讨厌肉桂味。。。","url":"https://x.com/0TwT012/status/2043628472644550893"},{"author_id":"1917047326990094336","conversation_id":"2043628410459787633","created_at":"2026-04-13T09:52:36.000Z","edit_history_tweet_ids":["2043628410459787633"],"id":"2043628410459787633","lang":"zh","public_metrics":{"bookmark_count":17,"impressio