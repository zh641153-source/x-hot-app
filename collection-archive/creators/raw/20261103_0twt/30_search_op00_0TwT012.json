2,"retweet_count":3},"text":"对你来说我应该是一阵风，一段浅淡的坏缘分，半个模糊不清的夏天","url":"https://x.com/0TwT012/status/2063876780155658334"},{"author_id":"1917047326990094336","conversation_id":"2063876202335715601","created_at":"2026-06-08T06:50:06.000Z","edit_history_tweet_ids":["2063876202335715601"],"id":"2063876202335715601","lang":"zh","public_metrics":{"bookmark_count":7,"impression_count":22348,"like_count":292,"quote_count":1,"reply_count":68,"retweet_count":75},"text":"其实我一直知道我的性格并不能让任何人幸福","url":"https://x.com/0TwT012/status/2063876202335715601"},{"author_id":"1917047326990094336","conversation_id":"2063869932962791649","created_at":"2026-06-08T06:25:11.000Z","edit_history_tweet_ids":["2063869932962791649"],"id":"2063869932962791649","lang":"zh","public_metrics":{"bookmark_count":7,"impression_count":10489,"like_count":158,"quote_count":4,"reply_count":91,"retweet_count":18},"text":"其实那天你睡着了我看了你好久，我知道我们注定是要分开的","url":"https://x.com/0TwT012/status/2063869932962791649"},{"author_id":"1917047326990094336","conversation_id":"2063869478413439450","created_at":"2026-06-08T06:23:23.000Z","edit_history_tweet_ids":["2063869478413439450"],"id":"2063869478413439450","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":7914,"like_count":76,"quote_count":3,"reply_count":12,"retweet_count":5},"text":"幸福到底是认清还是认命啊？","url":"https://x.com/0TwT012/status/2063869478413439450"},{"author_id":"1917047326990094336","conversation_id":"2063869242857153023","created_at":"2026-06-08T06:22:26.000Z","edit_history_tweet_ids":["2063869242857153023"],"id":"2063869242857153023","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":3317,"like_count":37,"quote_count":1,"reply_count":17,"retweet_count":4},"text":"我跟你卖萌的时候可以不要跟别人讲吗？我家里人不知道我在做这个","url":"https://x.com/0TwT012/status/2063869242857153023"},{"author_id":"1917047326990094336","conversation_id":"2063867305071902760","created_at":"2026-06-08T06:14:44.000Z","edit_history_tweet_ids":["2063867305071902760"],"id":"2063867305071902760","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":6206,"like_count":33,"quote_count":0,"reply_count":3,"retweet_count":0},"text":"要我怎么再相信任何一个人。 https://t.co/cVjHJhqMac","url":"https://x.com/0TwT012/status/2063867305071902760"},{"author_id":"1917047326990094336","conversation_id":"2063864398851219957","created_at":"2026-06-08T06:03:12.000Z","edit_history_tweet_ids":["2063864398851219957"],"id":"2063864398851219957","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":2759,"like_count":27,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"成为自己生活的旁观者，可以避免生活中的很多烦恼","url":"https://x.com/0TwT012/status/2063864398851219957"},{"author_id":"1917047326990094336","conversation_id":"2063864292487958993","created_at":"2026-06-08T06:02:46.000Z","edit_history_tweet_ids":["2063864292487958993"],"id":"2063864292487958993","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":2704,"like_count":28,"quote_count":0,"reply_count":10,"retweet_count":2},"text":"毋庸置疑，我现在就是我整个人生旅途中最幸福的状态，以前没有，以后不知道会怎样，但现在是的。","url":"https://x.com/0TwT012/status/2063864292487958993"},{"author_id":"1917047326990094336","conversation_id":"2063691997781934582","created_at":"2026-06-07T18:38:08.000Z","edit_history_tweet_ids":["2063691997781934582"],"id":"2063691997781934582","lang":"zh","public_metrics":{"bookmark_count":30,"impression_count":27770,"like_count":527,"quote_count":10,"reply_count":45,"retweet_count":148},"text":"你的创伤确实有点痛了，但是解离和记忆衰退又弥补了这一点，就在恍惚和幻想中度过下一天吧","url":"https://x.com/0TwT012/status/2063691997781934582"},{"author_id":"1917047326990094336","conversation_id":"2063613159924183501","created_at":"2026-06-07T13:24:52.000Z","edit_history_tweet_ids":["2063613159924183501"],"id":"2063613159924183501","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":5041,"like_count":56,"quote_count":2,"reply_count":9,"retweet_count":3},"text":"那种在妻子面前装小白花的男的  背地里砍情敌最狠了","url":"https://x.com/0TwT012/status/2063613159924183501"},{"author_id":"1917047326990094336","conversation_id":"2063612311370432982","created_at":"2026-06-07T13:21:29.000Z","edit_history_tweet_ids":["2063612311370432982"],"id":"2063612311370432982","lang":"zh","public_metrics":{"bookmark_count":23,"impression_count":38814,"like_count":752,"quote_count":7,"reply_count":91,"retweet_count":48},"text":"“我们现在是什么关系。”一般会从两种人嘴裡说出来，一种是恃宠而骄，一种是即将败犬。","url":"https://x.com/0TwT012/status/2063612311370432982"},{"author_id":"1917047326990094336","conversation_id":"2063581947373510796","created_at":"2026-06-07T11:20:50.000Z","edit_history_tweet_ids":["2063581947373510796"],"id":"2063581947373510796","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":4728,"like_count":49,"quote_count":0,"reply_count":2,"retweet_count":0},"text":"但我到现在也没有遇到一个可以完全让我表达出我的任性和需求的人，我一直想哭 https://t.co/q7tPb06gLx","url":"https://x.com/0TwT012/status/2063581947373510796"},{"author_id":"1917047326990094336","conversation_id":"2063577142324322557","created_at":"2026-06-07T11:01:44.000Z","edit_history_tweet_ids":["2063577142324322557"],"id":"2063577142324322557","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":1912,"like_count":10,"quote_count":0,"reply_count":3,"retweet_count":0},"text":"我的钱全部用来买药了，我吃了药就会一直睡，睡醒了就意味着我要吃下一份药了","url":"https://x.com/0TwT012/status/2063577142324322557"},{"author_id":"1917047326990094336","conversation_id":"2063576648495280215","created_at":"2026-06-07T10:59:47.000Z","edit_history_tweet_ids":["2063576648495280215"],"id":"2063576648495280215","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":3620,"like_count":57,"quote_count":1,"reply_count":0,"retweet_count":5},"text":"我会一直感谢在我心软犹豫不决的时候对我狠心的人","url":"https://x.com/0TwT012/status/2063576648495280215"},{"author_id":"1917047326990094336","conversation_id":"2063576328222458021","created_at":"2026-06-07T10:58:30.000Z","edit_history_tweet_ids":["2063576328222458021"],"id":"2063576328222458021","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2083,"like_count":24,"quote_count":0,"reply_count":1,"retweet_count":1},"text":"我才意识到过去真的是过去了。\n没有感受。没有记忆。没有任何东西。\n你幸福吗。你说你想死。你真的死了。吗？时间不存在。一切都不存在。或者你只是停在那一刻。过去正在上演。此刻正在放映。未来等待揭幕。可是。所以呢。我不知道活着。应该以什么身份。我没有身份。没有我。","url":"https://x.com/0TwT012/status/2063576328222458021"},{"author_id":"1917047326990094336","conversation_id":"2063575822410358974","created_at":"2026-06-07T10:56:30.000Z","edit_history_tweet_ids":["2063575822410358974"],"id":"2063575822410358974","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":2325,"like_count":38,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"永恒比起祝福更像是诅咒。\n所以他说要跟我在一起一辈子的时候，我说我诅咒你和我在一起生生世世","url":"https://x.com/0TwT012/status/2063575822410358974"},{"author_id":"1917047326990094336","conversation_id":"2063573559122039228","created_at":"2026-06-07T10:47:30.000Z","edit_history_tweet_ids":["2063573559122039228"],"id":"2063573559122039228","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":2907,"like_count":54,"quote_count":0,"reply_count":0,"retweet_count":10},"text":"我那么痛苦的青春期居然在别人的想象里也幸福过","url":"https://x.com/0TwT012/status/2063573559122039228"},{"author_id":"1917047326990094336","conversation_id":"2063568702403162588","created_at":"2026-06-07T10:28:12.000Z","edit_history_tweet_ids":["2063568702403162588"],"id":"2063568702403162588","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":3366,"like_count":50,"quote_count":0,"reply_count":2,"retweet_count":3},"text":"好像善良与宽容对这个世界不起作用","url":"https://x.com/0TwT012/status/2063568702403162588"},{"author_id":"1917047326990094336","conversation_id":"2063568250135515512","created_at":"2026-06-07T10:26:24.000Z","edit_history_tweet_ids":["2063568250135515512"],"id":"2063568250135515512","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":2185,"like_count":27,"quote_count":0,"reply_count":1,"retweet_count":3},"text":"我一直没躲避的，或许就是我想要的","url":"https://x.com/0TwT012/status/2063568250135515512"},{"author_id":"19170473