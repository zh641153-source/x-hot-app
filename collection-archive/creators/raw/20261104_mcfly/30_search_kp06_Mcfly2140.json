oted"}],"text":"全平台吗，我这么牛逼哇，谢谢！ https://t.co/LeYYUfUDrV","url":"https://x.com/Mcfly2140/status/2109907294914019786"},{"author_id":"928496628570427392","conversation_id":"2109905965797810453","created_at":"2026-10-13T07:15:57.000Z","edit_history_tweet_ids":["2109905965797810453"],"id":"2109905965797810453","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":4631,"like_count":38,"quote_count":0,"reply_count":7,"retweet_count":0},"referenced_tweets":[{"id":"2109905497579291101","type":"quoted"}],"text":"像这样持续关注我1个月，再来留言，我会很欢迎！ https://t.co/glP8WkKmAE","url":"https://x.com/Mcfly2140/status/2109905965797810453"},{"author_id":"928496628570427392","conversation_id":"2109902190521565218","created_at":"2026-10-13T07:00:56.000Z","edit_history_tweet_ids":["2109902190521565218"],"id":"2109902190521565218","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":5482,"like_count":16,"quote_count":0,"reply_count":3,"retweet_count":0},"referenced_tweets":[{"id":"2109538000518664652","type":"quoted"}],"text":"送我蓝标的大佬私信下，送你一只牛股！ https://t.co/4WoxAIhQR4","url":"https://x.com/Mcfly2140/status/2109902190521565218"},{"author_id":"928496628570427392","conversation_id":"2109900239457206571","created_at":"2026-10-13T06:53:11.000Z","edit_history_tweet_ids":["2109900239457206571"],"id":"2109900239457206571","lang":"ja","public_metrics":{"bookmark_count":1,"impression_count":3656,"like_count":7,"quote_count":0,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2109583850775134715","type":"quoted"}],"text":"以太坊昨晚又踩到了2400哈！ https://t.co/Nr7M3moIWX","url":"https://x.com/Mcfly2140/status/2109900239457206571"},{"author_id":"928496628570427392","conversation_id":"2109891596045218035","created_at":"2026-10-13T06:18:51.000Z","edit_history_tweet_ids":["2109891596045218035"],"id":"2109891596045218035","lang":"zh","public_metrics":{"bookmark_count":24,"impression_count":6679,"like_count":57,"quote_count":0,"reply_count":18,"retweet_count":5},"text":"今天只做一件事：\n打开笔记，