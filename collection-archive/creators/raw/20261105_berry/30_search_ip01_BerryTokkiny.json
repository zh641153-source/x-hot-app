7466365640814930"],"id":"2107466365640814930","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":5806,"like_count":11,"quote_count":0,"reply_count":5,"retweet_count":0},"text":"秩序感强的老实人一直在吃亏……\n我一直都是那个吃亏的老实人……","url":"https://x.com/BerryTokkiny/status/2107466365640814930"},{"author_id":"2093646888264478721","conversation_id":"2107464426752552978","created_at":"2026-10-06T13:34:08.000Z","edit_history_tweet_ids":["2107464426752552978"],"id":"2107464426752552978","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":7404,"like_count":25,"quote_count":0,"reply_count":7,"retweet_count":1},"text":"我那个让我一见面就想跪下给他舔脚的成熟年上冷脸严厉话少熟男高认知反差手黑克制的dom到底在哪","url":"https://x.com/BerryTokkiny/status/2107464426752552978"},{"author_id":"2093646888264478721","conversation_id":"2107464302055846117","created_at":"2026-10-06T13:33:39.000Z","edit_history_tweet_ids":["2107464302055846117"],"id":"2107464302055846117","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":7895,"like_count":43,"quote_count":0,"reply_count":141,"retweet_count":0},"text":"我找主的其中一个要求就是要说普通话。","url":"https://x.com/BerryTokkiny/status/2107464302055846117"},{"author_id":"2093646888264478721","conversation_id":"2107462506822467839","created_at":"2026-10-06T13:26:31.000Z","edit_history_tweet_ids":["2107462506822467839"],"id":"2107462506822467839","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":5218,"like_count":7,"quote_count":0,"reply_count":11,"retweet_count":0},"text":"等哪天我发现我分享美好的碎碎念（非性幻想）的推文浏览破千了，就是我的号养成之日","url":"https://x.com/BerryTokkiny/status/2107462506822467839"},{"author_id":"2093646888264478721","conversation_id":"2107457834518757428","created_at":"2026-10-06T13:07:57.000Z","edit_history_tweet_ids":["2107457834518757428"],"id":"2107457834518757428","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":4656,"like_count":5,"quote_count":0,"reply_count":3,"retweet_count":0},"text":"我也好想写出那样让人承受不住的文字……那样让人感动，悲伤，共鸣的文字……","url":"https://x.com/BerryTokkiny/status/2107457834518757428"},{"author_id":"2093646888264478721","conversation_id":"2107443666130550854","created_at":"2026-10-06T12:11:39.000Z","edit_history_tweet_ids":["2107443666130550854"],"id":"2107443666130550854","lang":"zh","public_metrics":{"bookmark_count":75,"impression_count":22965,"like_count":304,"quote_count":0,"reply_count":35,"retweet_count":3},"text":"克制的爸爸一直没有对自己心爱的女儿下手。\n“你是不是阳痿啊”每次勾引爸爸无果反而挨了几顿打的女儿总这么说。每次听到这句话爸爸也只是挑眉不语。\n终于那一天到了。十八岁成人礼的当晚，爸爸把女儿叫到了房间里，进去后的第一个指令就是闭嘴，跪下。\n“抬头”，他说，手抚摸着她的脸颊。 https://t.co/qMHKScvuuW","url":"https://x.com/BerryTokkiny/status/2107443666130550854"},{"author_id":"2093646888264478721","conversation_id":"2107435920198967451","created_at":"2026-10-06T11:40:52.000Z","edit_history_tweet_ids":["2107435920198967451"],"id":"2107435920198967451","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":4944,"like_count":9,"quote_count":0,"reply_count":7,"retweet_count":1},"text":"他亲吻着我的额头，我的唇。将我包裹着，手描摹着我身体的曲线，山峰，溪流，平坦的土地，细长的树干。\n“我爱你”他说，“这里，这里和这里，只有我才能触碰，我才能拥有，对不对？”\n“对的爹爹”我讨好一般地蹭着他：“是您的，所有的一切都是您的”\n这里一直都只有他才能涉足。\n他轻笑，将我抱地更紧了一些 https://t.co/AnU7jTNTSD","url":"https://x.com/BerryTokkiny/status/2107435920198967451"},{"author_id":"2093646888264478721","conversation_id":"2107435461832487194","created_at":"2026-10-06T11:39:03.000Z","edit_history_tweet_ids":["2107435461832487194"],"id":"2107435461832487194","lang":"zh","public_metrics":{"bookmark_count":7,"impression_count":5566,"like_count":39,"quote_count":0,"reply_count":15,"retweet_count":1},"text":"好喜欢好喜欢当小狗。\n想当爹爹唯一的小奴，想每天都跟爹爹在一起，伺候好爹爹，生活的方方面面都被爹爹控制，什么时候排泄，什么时候吃饭，吃什么，睡多久，都想被爹爹控制。每天早上起床就要给爹爹请安，蹭蹭爹爹陪爹爹吃完早饭，送爹爹去公司。 https://t.co/j4OXmZ97rX","url":"https://x.com/BerryTokkiny/status/2107435461832487194"},{"author_id":"2093646888264478721","conversation_id":"2107434964908376346","created_at":"2026-10-06T11:37:05.000Z","edit_history_tweet_ids":["2107434968259744250"],"id":"2107434968259744250","in_reply_to_user_id":"2093646888264478721","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":6003,"like_count":43,"quote_count":1,"reply_count":1,"retweet_count":1},"referenced_tweets":[{"id":"2107434964908376346","type":"replied_to"}],"text":"爸爸又怎么不知道自己心爱的宝贝女儿是这样一个魅魔。可他也不舍得打也不舍得骂，次次被勾引的硬的厉害，却又只能克制住自己不去捅破这段关系。终于有一天，下位实在忍不住，脱光了衣服在床上等候上位到家。而上位一开门就看到了自己的魅魔女儿撅着屁股，淫水滴到床上的骚样……","url":"https://x.com/BerryTokkiny/status/2107434968259744250"},{"author_id":"2093646888264478721","conversation_id":"2107434964908376346","created_at":"2026-10-06T11:37:04.000Z","edit_history_tweet_ids":["2107434964908376346"],"id":"2107434964908376346","lang":"zh","public_metrics":{"bookmark_count":41,"impression_count":15438,"like_count":359,"quote_count":1,"reply_count":38,"retweet_count":8},"text":"克制的爸爸dom和魅魔女儿sub也是无比美味的\n明明双方都心知肚明彼此是双向奔赴，可是因为年龄和关系一直无法捅破窗户纸。下位深知自己的好爸爸对自己毫无抵抗力，于是很爱勾引。会故意不小心地把洗完的内裤内衣放在爸爸床上，会喜欢在爸爸的房间里自慰然后流下水渍和玩具。","url":"https://x.com/BerryTokkiny/status/2107434964908376346"},{"author_id":"2093646888264478721","conversation_id":"2107433525855318065","created_at":"2026-10-06T11:31:22.000Z","edit_history_tweet_ids":["2107433530385219681"],"id":"2107433530385219681","in_reply_to_user_id":"2093646888264478721","lang":"zh","public_metrics":{"bookmark_count":6,"impression_count":11935,"like_count":228,"quote_count":0,"reply_count":1,"retweet_count":1},"referenced_tweets":[{"id":"2107433525855318065","type":"replied_to"}],"text":"而上位一边享受女儿对自己的信任，一边又承受着罪恶感。\n但是又开始自我安慰，觉得自己的女儿就应该只对自己这样，就这样安慰自己……一边克制，一边享受，一边自责，一边安慰……","url":"https://x.com/BerryTokkiny/status/2107433530385219681"},{"author_id":"2093646888264478721","conversation_id":"2107433525855318065","created_at":"2026-10-06T11:31:21.000Z","edit_history_tweet_ids":["2107433525855318065"],"id":"2107433525855318065","lang":"zh","public_metrics":{"bookmark_count":255,"impression_count":86206,"like_count":1833,"quote_count":11,"reply_count":76,"retweet_count":54},"text":"畸形的养父女cp最美味的就是上位的克制和下位的无意识勾引了……\n下位从小被教导，只能对爸爸展示自己最放纵的一面，所有的一切只能对爸爸，只能亲亲爸爸，只能跟爸爸一起睡\n于是，就算身体是身体开始发育了，也还是保持着小时候的习惯，在家不爱穿裤