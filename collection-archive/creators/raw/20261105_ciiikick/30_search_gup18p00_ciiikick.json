4571629061492736","created_at":"2025-02-01T16:47:17.000Z","edit_history_tweet_ids":["1885731658873417830"],"id":"1885731658873417830","public_metrics":{"bookmark_count":2,"impression_count":112881,"like_count":154,"quote_count":0,"reply_count":26,"retweet_count":0},"text":"大过年的终于吃到一条像样的鸡巴了。。。","url":"https://x.com/ciiikick/status/1885731658873417830"},{"author_id":"1534571629061492736","created_at":"2025-02-01T15:07:36.000Z","edit_history_tweet_ids":["1885706574523740317"],"id":"1885706574523740317","public_metrics":{"bookmark_count":8,"impression_count":140753,"like_count":167,"quote_count":0,"reply_count":30,"retweet_count":0},"text":"眼前的这位港单男，超能说，但吃饭的时候眼睛就没离开过我的胸。现在跟他去四季。","url":"https://x.com/ciiikick/status/1885706574523740317"},{"author_id":"1534571629061492736","created_at":"2025-02-01T11:47:41.000Z","edit_history_tweet_ids":["1885656261662052463"],"id":"1885656261662052463","public_metrics":{"bookmark_count":19,"impression_count":189208,"like_count":227,"quote_count":0,"reply_count":135,"retweet_count":0},"text":"还有谁没看到前夫艹孕妇转运的视频的啊。。。错过的就看今晚我在IFC 面试口爆香港单男的直播吧。","url":"https://x.com/ciiikick/status/1885656261662052463"},{"author_id":"1534571629061492736","created_at":"2025-02-01T10:45:26.000Z","edit_history_tweet_ids":["1885640596058251301"],"id":"1885640596058251301","public_metrics":{"bookmark_count":3,"impression_count":154765,"like_count":89,"quote_count":0,"reply_count":12,"retweet_count":0},"text":"煞笔前夫，叫我今晚独自面试港男，自己就溜去兰桂坊跟一对夫妻喝酒。","url":"https://x.com/ciiikick/status/1885640596058251301"},{"author_id":"1534571629061492736","created_at":"2025-02-01T03:28:19.000Z","edit_history_tweet_ids":["1885530591317418383"],"id":"1885530591317418383","public_metrics":{"bookmark_count":5,"impression_count":97363,"like_count":92,"quote_count":0,"reply_count":19,"retweet_count":0},"text":"终于用手把他玩吐了。玩一会停一会，折腾了一上午。射了出来的东西比口水还稀。","url":"https://x.com/ciiikick/status/1885530591317418383"},{"author_id":"1534571629061492736","created_at":"2025-02-01T01:28:16.000Z","edit_history_tweet_ids":["1885500381037551786"],"id":"1885500381037551786","public_metrics":{"bookmark_count":6,"impression_count":133552,"like_count":157,"quote_count":1,"reply_count":43,"retweet_count":1},"text":"你们想看我前夫的金针菇吗？口了我十五分钟了他都晨勃不起来。他真废了。。。","url":"https://x.com/ciiikick/status/1885500381037551786"},{"author_id":"1534571629061492736","created_at":"2025-01-31T12:43:31.000Z","edit_history_tweet_ids":["1885307925931188372"],"id":"1885307925931188372","public_metrics":{"bookmark_count":8,"impression_count":98663,"like_count":111,"quote_count":1,"reply_count":24,"retweet_count":2},"text":"征服一个女人，除了可以征服她的逼，还可以征服她的胃。","url":"https://x.com/ciiikick/status/1885307925931188372"},{"author_id":"1534571629061492736","created_at":"2025-01-31T09:05:12.000Z","edit_history_tweet_ids":["1885252984826982674"],"id":"1885252984826982674","public_metrics":{"bookmark_count":5,"impression_count":92165,"like_count":98,"quote_count":0,"reply_count":23,"retweet_count":0},"text":"昨晚才说要找律师告我诽谤，现在已经买好菜说要上门做饭了。做完饭应该就是做爱了吧？？果然他的人就像他那永远耷拉的龟头一样，永远都不硬气。","url":"https://x.com/ciiikick/status/1885252984826982674"},{"author_id":"1534571629061492736","created_at":"2025-01-31T06:28:23.000Z","edit_history_tweet_ids":["1885213522193526809"],"id":"1885213522193526809","public_metrics":{"bookmark_count":5,"impression_count":128260,"like_count":65,"quote_count":0,"reply_count":16,"retweet_count":0},"referenced_tweets":[{"id":"1884998759979049470","type":"quoted"}],"text":"真是搞笑，什么叫诽谤？诽谤的前提是捏造事实。什么是事实，上次直播的时候，你前后不到五分钟就射了，这就是人尽皆知的事实。 https://t.co/9qMpY6qldJ","url":"https://x.com/ciiikick/status/1885213522193526809"},{"author_id":"1534571629061492736","created_at":"2025-01-30T15:32:39.000Z","edit_history_tweet_ids":["1884988099673113022"],"id":"1884988099673113022","public_metrics":{"bookmark_count":29,"impression_count":316698,"like_count":371,"quote_count":0,"reply_count":427,"retweet_count":3},"text":"突然找到了前夫去年大年初二操孕妇的视频。我拍的。但是就几秒钟。当时先是倒腾半天勃起不了，勉强塞进去之后几秒钟就射了。谁想看？？？","url":"https://x.com/ciiikick/status/1884988099673113022"},{"author_id":"1534571629061492736","created_at":"2025-01-30T10:33:07.000Z","edit_history_tweet_ids":["1884912723718476166"],"id":"1884912723718476166","public_metrics":{"bookmark_count":69,"impression_count":427639,"like_count":629,"quote_count":0,"reply_count":57,"retweet_count":13},"text":"前夫是个特别迷信的人。大年初二，他曾经让我看着他操一个孕妇，说开年操孕妇会转运。然后他也会在推特给我找年轻的处男，让我嗦他的鸡巴，然后把射进嘴里的全部吞下，说这样一整年都会顺风顺水。我就是这样被他带进了开放式关系的无尽深渊。","url":"https://x.com/ciiikick/status/1884912723718476166"},{"author_id":"1534571629061492736","created_at":"2025-01-29T11:16:30.000Z","edit_history_tweet_ids":["1884561249687790013"],"id":"1884561249687790013","public_metrics":{"bookmark_count":41,"impression_count":281019,"like_count":382,"quote_count":1,"reply_count":33,"retweet_count":5},"text":"四年前的大年初一，跟前夫在澳门一对夫妻玩交换正式入圈。两条大鸡巴同时塞进我嘴里捅得我干呕的感觉还记忆犹新。只是四年后的今天我们都离婚了。","url":"https://x.com/ciiikick/status/1884561249687790013"},{"author_id":"1534571629061492736","created_at":"2025-01-28T17:11:49.000Z","edit_history_tweet_ids":["1884288282496049307"],"id":"1884288282496049307","public_metrics":{"bookmark_count":18,"impression_count":213808,"like_count":242,"quote_count":0,"reply_count":31,"retweet_count":1},"text":"12点一过，就被前夫🐍进去了。。。不想动了，明天年初一再清理清理。。。","url":"https://x.com/ciiikick/status/1884288282496049307"},{"author_id":"1534571629061492736","created_at":"2025-01-28T09:06:13.000Z","edit_history_tweet_ids":["1884166075987927215"],"id":"1884166075987927215","public_metrics":{"bookmark_count":2,"impression_count":114305,"like_count":85,"quote_count":0,"reply_count":70,"retweet_count":0},"text":"大年初一，开年活动选项：\n1️⃣ 爬山\n2️⃣ 打球\n3️⃣ 打炮\n4️⃣ 找前夫看电影\n\n选哪个？","url":"https://x.com/ciiikick/status/1884166075987927215"},{"author_id":"1534571629061492736","created_at":"2025-01-25T13:23:22.000Z","edit_history_tweet_ids":["1883143626945151144"],"id":"1883143626945151144","public_metrics":{"bookmark_count":15,"impression_count":391782,"like_count":123,"quote_count":0,"reply_count":26,"retweet_count":0},"text":"收到了粉丝送我的5J车厘子🍒，果子很大，很暖心，但让我不禁想起前夫之前的变态行为。他将我弄湿后，把车厘子塞到我逼里，捏着果子上的小柄胡乱捅一番后，拿出来细细品尝起来这包浆的车厘子。把果肉吃掉后，将果核又塞回我逼了，然后开始正式做爱。还问我这样的效果是不是跟之前鸡巴入珠的炮友差不多。","url":"https://x.com/ciiikick/status/1883143626945151144"}],"errors":[{"detail":"Sorry, you are not authorized to see the Tweet with referenced_tweets.id: [1884998759979049470].","parameter":"referenced_tweets.id","resource_id":"1884998759979049470","resource_type":"tweet","section":"includes","title":"Authorization Error","type":"https://api.x.com/2/problems/not-authorized-for-resource","value":"1884998759979049470"}],"includes":{"users":[{"id":"1534571629061492736","name":"CiiiCiii","profile_image_url":"https://pbs.twimg.com/profile_images/1965792201570750465/cdumKqMV_normal.jpg","username":"ciiikick","verified":false}]},"meta":{"newest_id":"1888863538040500720","next_token":"7140dibdnow9c7btw4b38mtnfplf5eynkqs46k6lda438","oldest_id":"1883143626945151144","previous_token":"77qpymm88g5h9vqklv0epd1qjeen2fk6ozar0zw4dknqo","result_count":25}}