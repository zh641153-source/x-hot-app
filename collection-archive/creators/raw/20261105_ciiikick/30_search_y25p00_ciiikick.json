422"],"id":"2003741598899929422","lang":"zh","public_metrics":{"bookmark_count":48,"impression_count":171566,"like_count":302,"quote_count":4,"reply_count":123,"retweet_count":15},"text":"本律师教大家如何规避法律风险。 https://t.co/aVpgoU7iIk","url":"https://x.com/ciiikick/status/2003741598899929422"},{"author_id":"1534571629061492736","conversation_id":"2002399377768525905","created_at":"2025-12-20T15:23:09.000Z","edit_history_tweet_ids":["2002399377768525905"],"id":"2002399377768525905","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":53919,"like_count":30,"quote_count":0,"reply_count":2,"retweet_count":0},"referenced_tweets":[{"id":"2002398813223596110","type":"quoted"}],"text":"如题 https://t.co/0Px7TMmqWW","url":"https://x.com/ciiikick/status/2002399377768525905"},{"author_id":"1534571629061492736","conversation_id":"2001948515027796240","created_at":"2025-12-19T09:31:35.000Z","edit_history_tweet_ids":["2001948515027796240"],"id":"2001948515027796240","lang":"zh","public_metrics":{"bookmark_count":15,"impression_count":77941,"like_count":310,"quote_count":0,"reply_count":15,"retweet_count":0},"text":"我饿了\n火速赶往office参加Friday drinks❗️ https://t.co/85NxsLjgqv","url":"https://x.com/ciiikick/status/2001948515027796240"},{"author_id":"1534571629061492736","conversation_id":"2001679781084233755","created_at":"2025-12-18T15:43:43.000Z","edit_history_tweet_ids":["2001679781084233755"],"id":"2001679781084233755","lang":"zxx","public_metrics":{"bookmark_count":1,"impression_count":37436,"like_count":12,"quote_count":0,"reply_count":80,"retweet_count":0},"text":"https://t.co/q1iqy7VvZ1","url":"https://x.com/ciiikick/status/2001679781084233755"},{"author_id":"1534571629061492736","conversation_id":"2001180541542953177","created_at":"2025-12-17T06:39:55.000Z","edit_history_tweet_ids":["2001180541542953177"],"id":"2001180541542953177","lang":"zh","public_metrics":{"bookmark_count":33,"impression_count":77236,"like_count":348,"quote_count":1,"reply_count":39,"retweet_count":7},"text":"工作上真正欣赏下属才华和能力的领导有几个？大多数领导更喜欢执行力爆棚、绝对听话、配合默契、从不越界的下属，最好还能偶尔拍马屁提供点情绪价值。  \n\n对他们来说，最重要的是维护权威、团队稳定成本可控管理省心，而不是花时间去挖掘你的潜力、帮你成长 - 毕竟他们是老板，不是老师，更不是老妈 https://t.co/EFsv8Emmuw","url":"https://x.com/ciiikick/status/2001180541542953177"},{"author_id":"1534571629061492736","conversation_id":"2000873254328918252","created_at":"2025-12-16T10:18:52.000Z","edit_history_tweet_ids":["2000873254328918252"],"id":"2000873254328918252","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":56021,"like_count":33,"quote_count":0,"reply_count":14,"retweet_count":0},"referenced_tweets":[{"id":"2000583980631118273","type":"quoted"}],"text":"相关话题值得我今晚开一个Space直播 https://t.co/OZu7DkQ3TK","url":"https://x.com/ciiikick/status/2000873254328918252"},{"author_id":"1534571629061492736","conversation_id":"2000583980631118273","created_at":"2025-12-15T15:09:24.000Z","edit_history_tweet_ids":["2000583980631118273"],"id":"2000583980631118273","lang":"zh","public_metrics":{"bookmark_count":7,"impression_count":121995,"like_count":86,"quote_count":3,"reply_count":19,"retweet_count":1},"text":"为什么婆媳矛盾、公媳矛盾往往是婚姻家庭和谐的一大毒瘤。而鲜少发生女婿和丈母娘、老丈人之间的矛盾？这个问题值得探讨。\n\n插播一句：哪天可能我也给我爸妈找个上门女婿","url":"https://x.com/ciiikick/status/2000583980631118273"},{"author_id":"1534571629061492736","conversation_id":"2000229988931719390","created_at":"2025-12-14T15:42:46.000Z","edit_history_tweet_ids":["2000229988931719390"],"id":"2000229988931719390","lang":"zh","public_metrics":{"bookmark_count":8,"impression_count":157964,"like_count":208,"quote_count":0,"reply_count":99,"retweet_count":1},"text":"今天带着我儿子去探望我闺蜜，回家的时候儿子跟我说：妈妈，我也想要一个妹妹。你再生一个妹妹好不好？\n\n我说：妈妈生你吃了很多苦，妈妈有你就够了。\n\n儿子说：妈妈不怕，你生了妹妹以后，我和爸爸会更疼你，连同妹妹一起疼。你不用怕。\n\n我转过头，偷偷抹了下眼泪。","url":"https://x.com/ciiikick/status/2000229988931719390"},{"author_id":"1534571629061492736","conversation_id":"2000077926201704450","created_at":"2025-12-14T05:38:31.000Z","edit_history_tweet_ids":["2000077926201704450"],"id":"2000077926201704450","lang":"zh","public_metrics":{"bookmark_count":6,"impression_count":69477,"like_count":61,"quote_count":0,"reply_count":17,"retweet_count":0},"text":"内地海底捞的魔法：\n\n先把见证着青春流逝的儿子支走去儿童区，留我一人安静的听着广播里的老歌：周杰伦陶喆林俊杰，伴随着锅里升起袅袅烟雾，往日幕幕重现，桌对面好像出现了当年一起撑台脚、商量如何薅羊毛打折的他，想认真看清脸的时，服务员领着我儿子回来，淡淡说道：\n\n顾客您好，小朋友说饿了。","url":"https://x.com/ciiikick/status/2000077926201704450"},{"author_id":"1534571629061492736","conversation_id":"1999781486799868134","created_at":"2025-12-13T10:00:35.000Z","edit_history_tweet_ids":["1999781486799868134"],"id":"1999781486799868134","lang":"zh","public_metrics":{"bookmark_count":22,"impression_count":77355,"like_count":329,"quote_count":0,"reply_count":21,"retweet_count":4},"text":"降温了降温了，电热毯铺上。 https://t.co/rJYugTFddZ","url":"https://x.com/ciiikick/status/1999781486799868134"},{"author_id":"1534571629061492736","conversation_id":"1999670313681059913","created_at":"2025-12-13T02:38:49.000Z","edit_history_tweet_ids":["1999670313681059913"],"id":"1999670313681059913","lang":"zh","public_metrics":{"bookmark_count":15,"impression_count":188745,"like_count":212,"quote_count":0,"reply_count":19,"retweet_count":2},"text":"闺蜜肚子马上足月了，订了一个月圣贝拉月子中心。她说本来想订三个月，这样最后一个月还能约她的PY上来做坏事🙃不浪费瑰丽的海景和落地窗","url":"https://x.com/ciiikick/status/1999670313681059913"},{"author_id":"1534571629061492736","conversation_id":"1999448705989255245","created_at":"2025-12-12T11:58:14.000Z","edit_history_tweet_ids":["1999448705989255245"],"id":"1999448705989255245","lang":"en","public_metrics":{"bookmark_count":14,"impression_count":78045,"like_count":244,"quote_count":0,"reply_count":9,"retweet_count":3},"text":"Pray for a peaceful weekend…\nWith🤵 https://t.co/76KaFSxXbM","url":"https://x.com/ciiikick/status/1999448705989255245"},{"author_id":"1534571629061492736","conversation_id":"1998934146371207227","created_at":"2025-12-11T01:53:33.000Z","edit_history_tweet_ids":["1998934146371207227"],"id":"1998934146371207227","lang":"zh","public_metrics":{"bookmark_count":14,"impression_count":90662,"like_count":162,"quote_count":0,"reply_count":33,"retweet_count":1},"text":"这段时间每次doi后起床总是头晕站不直，第二天大腿根部骨痛，总以为是遇到了太强大的男主角(某G除外)，或者手冲冲多了，以至于身体吃不消\n\n前几天到医院一查，原来是中度贫血、缺铁缺钙。","url":"https://x.com/ciiikick/status/1998934146371207227"},{"author_id":"1534571629061492736","conversation_id":"1998672484921667630","created_at":"2025-12-10T08:33:48.000Z","edit_history_tweet_ids":["1998672484921667630"],"id":"1998672484921667630","lang":"zh","public_metrics":{"bookmark_count":16,"impression_count":68782,"like_count":85,"quote_count":0,"reply_count":13,"retweet_count":3},"text":"扫了一眼Soul在hkex的招股书，真tm佩服issuer counsel和F&amp;S的文笔：情绪经济、沉浸式与互动体验、情绪绿洲，讲得太好了。其实就是聊烧、text sex和磕泡泡\n\n当年在还没正式入圈多人运动，我曾有一段时间把soul作为树洞。等哪天它家过审了，说不定我也会流出咸咸的、热热的水。噢，是感动的泪水 https://t.co/MUSNl6MmmW","url":"https://x.com/ciiikick/status/1998672484921667630"},{"author_id":"1534571629061492736","conversation_id":"1998329278690099224","created_at":"2025-12-09T09:50:01.000Z","edit_history_tweet_ids":["1998329278690099224"],"id":"1998329278690099224","lang":"zh","public_metrics":{"bookmark_count":3,"impression_count":68911,"like_count":58,"quote_count":0,"reply_count":12,"retweet_count":0},"text":"2.5N+6，这多少有点让人感动了。\n\n粉丝宝宝们有insider吗，能来告诉我是不是真的吗😦 https://t.co/I5d65cPWeE","url":"https://x.com/ciiikick/status/1998329278690099224"},{"author_id":"1534571629061492736","conversation_id":"1998054204418773310","created_at":"2025-12-08T15:36:59.000Z","edit_history_tweet_ids":["1998054204418773310"],"id":"1998054204418773310","lang":"zxx","public_metrics":{"bookmark_count":3,"impression_count":48484,"like_count":18,"quote_count":0,"reply_count":130,"retweet_count":0},"text":"https://t.co/v3rpIykr0c","url":"https://x.com/ciiikick/status/1998054204418773310"},{"author_id":"1534571629061492736","conversation_id":"1998040890699567507","created_at":"2025-12-08T14:44:04.000Z","edit_history_tweet_ids":["1998040890699567507"],"id":"1998040890699567507","lang":"ja","public_metrics":{"bookmark_count":86,"impression_count":175010,"like_count":1086,"quote_count":0,"reply_count":55,