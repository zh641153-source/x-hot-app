006828","created_at":"2026-03-21T01:56:20.000Z","edit_history_tweet_ids":["2035173632344006828"],"id":"2035173632344006828","lang":"zh","public_metrics":{"bookmark_count":2,"impression_count":50743,"like_count":260,"quote_count":2,"reply_count":77,"retweet_count":3},"text":"我发现劝我下海的男生都是社会底层，因为在他们生活的环境来说遇到问题就只能走极端，但我想说人生的路很长，选择的路有很多，三百六十行，行行出状元，真没必要走极端，只有弱者才会选择卖身来生存，而我才19岁人生刚开始，我相信一切都会越来越好！","url":"https://x.com/Guillermin45548/status/2035173632344006828"},{"author_id":"1880947070837964800","conversation_id":"2034943494104686667","created_at":"2026-03-20T10:41:51.000Z","edit_history_tweet_ids":["2034943494104686667"],"id":"2034943494104686667","lang":"zh","public_metrics":{"bookmark_count":1,"impression_count":45520,"like_count":40,"quote_count":0,"reply_count":64,"retweet_count":0},"text":"豹纹内衣一般是大妈穿的，我19岁穿着有种偷穿大人衣服的反差感，上身效果照片都看过了吗？丑吧？ https://t.co/hqygS59aXe","url":"https://x.com/Guillermin45548/status/2034943494104686667"},{"author_id":"1880947070837964800","conversation_id":"2034882134159323278","created_at":"2026-03-20T06:38:01.000Z","edit_history_tweet_ids":["2034882134159323278"],"id":"2034882134159323278","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":39470,"like_count":10,"quote_count":0,"reply_count":8,"retweet_count":0},"text":"推特还能变现？不是骗人的吧 https://t.co/R3z0lReZrs","url":"https://x.com/Guillermin45548/status/2034882134159323278"},{"author_id":"1880947070837964800","conversation_id":"2034813791163343075","created_at":"2026-03-20T02:06:27.000Z","edit_history_tweet_ids":["2034813791163343075"],"id":"2034813791163343075","lang":"zh","public_metrics":{"bookmark_count":0,"impression_count":26469,"like_count":18,"quote_count":1,"reply_count":39,"retweet_count":0},"text":"为什么劝我下海的都是男生？","url":"https://x.com/Guillermin45548/status/2034813791163343075"},{"author_id":"1880947070837964800","conversation_id":"2034637208154775726","created_at":"2026-03-19T14:24:46.000Z","edit_history_tweet_ids":["2034637208154775726"],"id":"2034637208154775726","la